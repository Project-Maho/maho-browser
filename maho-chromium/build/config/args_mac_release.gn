# Release settings for macOS builds.
is_official_build = true
is_debug = false
# The shipped binary is stripped (strip_debug_info), and there is no dSYM /
# symbol-upload pipeline, so full DWARF (symbol_level=2) only bloats the build
# tree. symbol_level=1 keeps function-level symbols for usable crash
# backtraces; blink_symbol_level=0 drops Blink's (largest) debug info.
symbol_level = 1
blink_symbol_level = 0
strip_debug_info = true
dcheck_always_on = false
is_chrome_branded = false
enable_google_update = false

target_os = "mac"
target_cpu = "arm64"
maho_root = "//maho"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true
ignore_missing_widevine_signing_cert = true
enable_traffic_annotation_auditor = true

# macOS SDK/toolchain compatibility, verified 2026-09-23:
# * The bundled ld64.lld cannot parse modern SDK TAPI stubs ("unknown
#   architecture arm64e.x1-macos"), which leaves libc symbols undefined, so
#   link with Apple's system linker instead of lld.
# * Apple's ld cannot consume LLVM ThinLTO bitcode, so LTO is disabled.
# * This Chromium revision's macOS clang-module maps predate Xcode 27's SDK
#   (the sysroot module map cannot satisfy SDK 27's math.h / std_float_h), so
#   clang modules are disabled and mac_sdk_path points at the staged SDK that
#   `build/scripts/stage_macos_sdk.py` produces; its math.h patch is what lets
#   SDK 27 compile with modules off. Verified 2026-09-24.
use_lld = false
use_thin_lto = false
use_clang_modules = false
cc_wrapper = "/opt/homebrew/bin/sccache"

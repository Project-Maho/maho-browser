# Release settings for Windows builds.
is_official_build = true
is_debug = false
# Match macOS release policy: preserve function-level crash backtraces while
# dropping the largest Blink debug-info payload from the local build tree.
symbol_level = 1
blink_symbol_level = 0
strip_debug_info = true
treat_warnings_as_errors = false
fatal_linker_warnings = false
enable_resource_allowlist_generation = false
use_siso = false
dcheck_always_on = false
is_chrome_branded = false
enable_google_update = false

target_os = "win"
target_cpu = "x64"
maho_root = "//maho"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true
ignore_missing_widevine_signing_cert = true

# sccache cannot cache Chromium's explicit Clang header modules: every module
# compile carries -fmodules-cache-path, which sccache reports as non-cacheable,
# so with modules on (the Chromium 154 default) 100% of compiles bypass the
# remote cache. Chromium only auto-disables modules for icecc, so turn them off
# here like the macOS templates do. Measured on maho-win 2026-10-15: 23,653 of
# 23,653 compile requests "Non-cacheable: -fmodules-cache-path".
use_clang_modules = false

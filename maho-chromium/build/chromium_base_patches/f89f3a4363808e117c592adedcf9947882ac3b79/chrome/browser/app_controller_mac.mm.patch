+
 void OpenStartupTabsInBrowserWithProfile(const StartupTabs& tabs,
                                          Profile* profile) {
   if (!profile)
     return;  // No suitable profile to open the URLs, do nothing.
+
+  Profile* regular_profile = profile->GetOriginalProfile();
+  if (regular_profile->GetPrefs()->GetBoolean(
+          maho::welcome::kLoginGateActive)) {
+    std::vector<GURL> urls;
+    urls.reserve(tabs.size());
+    for (const auto& tab : tabs) {
+      urls.push_back(tab.url);
+    }
+    app_controller_mac::QueueNativeUrlsWhileMahoLoginGated(profile, urls);
+    maho::MahoWelcomeWindow::Show(profile);
+    return;
+  }
+
+  if (tabs.size() == 1) {
+    StartupTab single_tab = tabs[0];
+    base::WeakPtr<Profile> weak_profile = profile->GetWeakPtr();
+    maho::DecideLinkDestination(
+        single_tab.url, /*is_external=*/true,
+        base::BindOnce(
+            [](base::WeakPtr<Profile> profile, StartupTab single_tab,
+               maho::LinkDestinationResult result) {
+              if (!profile) {
+                return;
+              }
+              if (result.type == maho::LinkDestinationType::kSpace &&
+                  !result.space_id.empty()) {
+                BrowserWindowInterface* browser =
+                    ProfileBrowserCollection::GetForProfile(profile.get())->FindTabbedBrowser(false);
+                if (!browser) {
+                  browser = CreateBrowserWindow(
+                      BrowserWindowCreateParams(profile.get(), true));
+                  if (browser && browser->GetWindow()) {
+                    browser->GetWindow()->Show();
+                  }
+                }
+                if (browser) {
+                  maho::MahoSpaceProfileBridge* bridge =
+                      maho::MahoSpaceProfileBridge::GetInstance();
+                  if (bridge &&
+                      bridge->SwitchToSpace(static_cast<Browser*>(browser), result.space_id)) {
+                    chrome::AddSelectedTabWithURL(
+                        browser, single_tab.url, ui::PAGE_TRANSITION_LINK);
+                    return;
+                  }
+                }
+              } else if (result.type == maho::LinkDestinationType::kMahoMini) {
+                maho::LaunchMahoMini(
+                    profile.get(), maho::MahoMiniRequest{single_tab.url});
+                return;
+              }
+              StartupTabs tabs_fallback;
+              tabs_fallback.push_back(std::move(single_tab));
+              OpenStartupTabsInBrowserWithProfileNormal(tabs_fallback,
+                                                       profile.get());
+            },
+            weak_profile, std::move(single_tab)));
+    return;
+  }
+  OpenStartupTabsInBrowserWithProfileNormal(tabs, profile);
+}
+
+void OpenUrlsInBrowserWithProfile(const std::vector<GURL>& urls,
+                                  Profile* profile) {
+  StartupTabs tabs;
+  tabs.reserve(urls.size());
+  for (const auto& url : urls) {
+    tabs.emplace_back(url, /*is_untrusted_launch=*/false);
+  }
+  OpenStartupTabsInBrowserWithProfile(tabs, profile);
+}

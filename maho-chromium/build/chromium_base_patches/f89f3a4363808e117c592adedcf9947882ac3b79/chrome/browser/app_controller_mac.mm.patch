+- (void)queueNativeUrlsWhileMahoLoginGatedForProfile:(Profile*)profile
+                                                urls:(std::vector<GURL>)urls {
+  if (!profile || urls.empty()) {
+    return;
+  }
+  Profile* regular_profile = profile->GetOriginalProfile();
+  std::vector<GURL>& queued_urls =
+      _mahoNativeUrlsQueuedWhileLoginGated[regular_profile->GetPath()];
+  queued_urls.insert(queued_urls.end(), urls.begin(), urls.end());
+}
+
+- (void)drainQueuedNativeUrlsAfterMahoWelcomeForProfile:(Profile*)profile {
+  if (!profile) {
+    return;
+  }
+  Profile* regular_profile = profile->GetOriginalProfile();
+  if (regular_profile->GetPrefs()->GetBoolean(
+          maho::welcome::kLoginGateActive)) {
+    return;
+  }
+  auto it = _mahoNativeUrlsQueuedWhileLoginGated.find(
+      regular_profile->GetPath());
+  if (it == _mahoNativeUrlsQueuedWhileLoginGated.end()) {
+    return;
+  }
+  std::vector<GURL> urls = std::move(it->second);
+  _mahoNativeUrlsQueuedWhileLoginGated.erase(it);
+  OpenUrlsInBrowserWithProfile(urls, profile);
+}
+
+- (size_t)queuedNativeUrlCountForTestingForProfile:(Profile*)profile {
+  if (!profile) {
+    return 0;
+  }
+  Profile* regular_profile = profile->GetOriginalProfile();
+  auto it = _mahoNativeUrlsQueuedWhileLoginGated.find(
+      regular_profile->GetPath());
+  return it == _mahoNativeUrlsQueuedWhileLoginGated.end()
+             ? 0
+             : it->second.size();
+}
+
+- (std::vector<GURL>)queuedNativeUrlsForTestingForProfile:(Profile*)profile {
+  if (!profile) {
+    return {};
+  }
+  Profile* regular_profile = profile->GetOriginalProfile();

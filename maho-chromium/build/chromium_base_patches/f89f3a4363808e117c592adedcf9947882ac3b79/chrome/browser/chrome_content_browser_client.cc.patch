+// Rewrites stray chrome://newtab navigations (those that reach
+// BrowserURLHandlerCreated after policy and extra_parts handlers have
+// already had a chance to intercept) to about:blank so that Maho never
+// commits a chrome://newtab WebUI frame.
+bool MahoRewriteNewTabToBlank(GURL* url,
+                              content::BrowserContext* /*context*/) {
+  if (url->SchemeIs("chrome") && url->host() == "newtab") {
+    *url = GURL("about:blank");
+    return true;
+  }
+  return false;
+}
+
+// Maps only approved public Maho aliases to their existing Chrome WebUI
+// origins. Returning false leaves malformed, unlisted, and direct legacy
+// chrome://maho-* URLs untouched.
+bool MahoHandleUrlAlias(GURL* url,
+                        content::BrowserContext* /*context*/) {
+  return maho::MapMahoUrlAliasToActualUrl(*url, url);
+}
+
+// BrowserURLHandler calls this only after MahoHandleUrlAlias matched the
+// original public alias. Always claim that reverse rewrite: an approved
+// final WebUI destination becomes its alias, while any external or
+// unlisted final URL is intentionally retained to clear a stale alias.
+bool MahoHandleUrlAliasReverse(GURL* url,
+                               content::BrowserContext* /*context*/) {
+  GURL alias;
+  if (maho::ResolveActualUrlToMahoAlias(*url, &alias)) {
+    *url = alias;
+  }
+  return true;
+}

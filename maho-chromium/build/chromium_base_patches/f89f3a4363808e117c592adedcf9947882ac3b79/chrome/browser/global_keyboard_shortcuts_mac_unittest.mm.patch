+TEST(GlobalKeyboardShortcuts, HistoryShortcuts) {
+  // Test Command+Shift+Y resolves to IDC_SHOW_HISTORY (registered as a non-menu shortcut)
+  EXPECT_EQ(
+      IDC_SHOW_HISTORY,
+      CommandForKeys(kVK_ANSI_Y, CommandKeyState::kDown, ShiftKeyState::kDown,
+                     OptionKeyState::kUp, ControlKeyState::kUp));
+
+  // Test Command+Y is mapped to IDC_SHOW_HISTORY in AcceleratorsCocoa
+  const ui::Accelerator* menu_accelerator =
+      AcceleratorsCocoa::GetInstance()->GetAcceleratorForCommand(
+          IDC_SHOW_HISTORY);
+  ASSERT_TRUE(menu_accelerator);
+  EXPECT_EQ(menu_accelerator->key_code(), ui::VKEY_Y);
+  EXPECT_EQ(menu_accelerator->modifiers(), ui::EF_COMMAND_DOWN);
+}
+
+TEST(GlobalKeyboardShortcuts, MahoSpaceArrowShortcutsAreNotChromeTabShortcuts) {
+  EXPECT_EQ(
+      NO_COMMAND,
+      CommandForKeys(kVK_RightArrow, CommandKeyState::kDown, ShiftKeyState::kUp,
+                     OptionKeyState::kDown, ControlKeyState::kUp));
+  EXPECT_EQ(
+      NO_COMMAND,
+      CommandForKeys(kVK_LeftArrow, CommandKeyState::kDown, ShiftKeyState::kUp,
+                     OptionKeyState::kDown, ControlKeyState::kUp));
+}

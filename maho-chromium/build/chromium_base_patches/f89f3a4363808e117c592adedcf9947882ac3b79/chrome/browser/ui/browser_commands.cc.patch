 void NewIncognitoWindow(Profile* profile) {
-  NewEmptyWindow(profile->GetPrimaryOTRProfile(/*create_if_needed=*/true));
+  Profile* original = profile->GetOriginalProfile();
+  if (original->ShutdownStarted()) {
+    return;
+  }
+  // Maho: a primary OTR profile left in ShutdownStarted() (pending
+  // ProfileDestroyer after its last incognito window closed) would be reused
+  // by GetPrimaryOTRProfile() and make OpenEmptyWindow() abort, so the new
+  // incognito window never appears. Finish destroying the stale OTR first
+  // (only when no incognito browser still references it) so a fresh primary
+  // OTR is created for the new window.
+  if (Profile* existing_otr =
+          original->GetPrimaryOTRProfile(/*create_if_needed=*/false);
+      existing_otr && existing_otr->ShutdownStarted() &&
+      ProfileBrowserCollection::GetForProfile(existing_otr)->GetOffTheRecordBrowserCount() == 0) {
+    ProfileDestroyer::DestroyOTRProfileImmediately(existing_otr);
+  }
+  NewEmptyWindow(original->GetPrimaryOTRProfile(/*create_if_needed=*/true));
 }
 

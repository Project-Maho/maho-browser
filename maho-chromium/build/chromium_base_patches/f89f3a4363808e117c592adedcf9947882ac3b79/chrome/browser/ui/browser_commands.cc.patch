 void NewEmptyWindow(Profile* profile, bool should_trigger_session_restore) {
+  // Maho login gate: while active, route New Window / dock-reopen to the
+  // onboarding gate instead of opening a browser behind it. Covers Cmd+N,
+  // the New Window menu, and the macOS dock-reopen path (which funnels
+  // through NewEmptyWindow via CreateBrowser in app_controller_mac.mm).
+  if (Profile* gate_profile =
+          profile ? profile->GetOriginalProfile() : nullptr;
+      gate_profile && !profile->IsOffTheRecord() &&
+      gate_profile->GetPrefs()->GetBoolean("maho.auth.login_gate_active")) {
+    maho::MahoWelcomeWindow::Show(gate_profile);
+    return;
+  }
   bool off_the_record = profile->IsOffTheRecord();
   PrefService* prefs = profile->GetPrefs();
   if (off_the_record) {
@@ -1342,7 +1356,23 @@ void NewWindow(BrowserWindowInterface* browser) {

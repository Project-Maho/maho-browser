@@ -57,7 +57,14 @@ views::BubbleAnchor AppMenuButton::GetAnchor() {
   auto* const elements = BrowserElementsViews::From(this);
   CHECK(elements);
   auto* const element = elements->GetElement(kFallbackPopupAnchorElementId);
-  CHECK(element);
+  // Maho: the toolbar is always hidden, so this fallback is the only anchor,
+  // and it is not a shown element until the browser widget is visible. The
+  // startup session-crashed bubble asks for it before that, so return an
+  // empty anchor (accepted by every caller) instead of crashing every launch

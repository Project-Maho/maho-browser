+BrowserViewTabbedLayoutImpl::ProposedLayout
+BrowserViewTabbedLayoutImpl::CalculateMahoArcLayout(
+    const BrowserLayoutParams& browser_params) const {
+  TRACE_EVENT0("ui", "BrowserViewTabbedLayoutImpl::CalculateMahoArcLayout");
+  ProposedLayout layout;
+
+  const gfx::Rect& client_area = browser_params.visual_client_area;
+
+  if (views().window_scrim) {
+    layout.AddChild(views().window_scrim, client_area);
+  }
+
+  // In fullscreen the sidebar collapses so content gets the full area.
+  // This prevents the rail from overlapping immersive-reveal and content
+  // fullscreen (video, etc.).
+  const bool is_fullscreen =
+      delegate().GetBrowserWindowState() == WindowState::kFullscreen;
+  const bool panel_expanded = !is_fullscreen &&
+      maho::sidebar_prefs::IsSidebarPanelExpanded(
+          views::AsViewClass<BrowserView>(views().browser_view)->browser()->GetProfile()->GetPrefs());
+  int rail_width;
+  if (is_fullscreen) {
+    rail_width = 0;
+  } else if (panel_expanded) {
+    rail_width = maho::sidebar_prefs::GetSidebarWidthForLayout(
+        views::AsViewClass<BrowserView>(views().browser_view)->browser()->GetProfile()->GetPrefs()->GetInteger(
+            maho::sidebar_prefs::kSidebarWidth));
+  } else {
+    rail_width = views().maho_sidebar_container
+        ? views().maho_sidebar_container->GetPreferredSize().width()
+        : maho::sidebar_layout::kHoverTriggerWidthDp;
+  }
+
+  // Maho: an auto-hide sidebar reserves no width. It floats over the
+  // contents as a hover strip, or as the full sidebar while revealed, so the
+  // contents never relayout while it slides and the strip stays hoverable.
+  int sidebar_width = rail_width;
+  if (!is_fullscreen && rail_width == 0) {
+    if (const auto* floating_sidebar =
+            views::AsViewClass<maho::MahoSidebarContainerView>(
+                views().maho_sidebar_container)) {
+      sidebar_width = floating_sidebar->GetFloatingOverlayWidth();
+    }
+  }
+  const gfx::Rect rail_bounds(client_area.x(), client_area.y(), sidebar_width,
+                               client_area.height());
+  layout.AddChild(views().maho_sidebar_container, rail_bounds, !is_fullscreen);
+
+  // Contents: everything to the right of the rail.
+  const int contents_x = client_area.x() + rail_width;
+  const int contents_width = std::max(0, client_area.width() - rail_width);
+  int contents_left = contents_x;
+  int contents_right = contents_x + contents_width;
+
+  if (IsParentedToAndVisible(views().organizer_panel_container,
+                             views().browser_view)) {
+    int target_width = organizer_panel::kOrganizerPanelMinWidth;
+    bool organizer_panel_should_appear_elevated = true;
+    if (views().vertical_tab_strip_region_view &&
+        views().vertical_tab_strip_region_view->GetVisible()) {
+      const int vertical_tab_strip_width =
+          views().vertical_tab_strip_region_view->GetPreferredSize().width();
+      organizer_panel_should_appear_elevated =
+          vertical_tab_strip_width < organizer_panel::kOrganizerPanelMinWidth;
+      if (!organizer_panel_should_appear_elevated) {
+        target_width = std::max(target_width - views::Separator::kThickness,
+                                vertical_tab_strip_width -
+                                    views::Separator::kThickness);
+      }
+    }
+    views().organizer_panel_container->SetTargetWidth(target_width);
+    views().organizer_panel_container->SetIsElevated(
+        organizer_panel_should_appear_elevated);
+
+    const double reveal_amount =
+        views().organizer_panel_container->GetResizeAnimationValue();
+    const int visible_width = base::ClampFloor(target_width * reveal_amount);
+
+    gfx::Rect organizer_panel_bounds(contents_x, client_area.y(), visible_width,
+                                    client_area.height());
+    layout.AddChild(views().organizer_panel_container, organizer_panel_bounds);
+  }
+
+  // Infobar sits at the top of the contents column; contents start below it.
+  int contents_top = client_area.y();
+  int infobar_height = 0;
+  const bool infobar_visible =
+      IsParentedTo(views().infobar_container, views().browser_view) &&
+      delegate().IsInfobarVisible();
+  if (infobar_visible) {
+    infobar_height = views().infobar_container->GetPreferredSize().height();
+    contents_top += infobar_height;
+  }
+
+  // Suppress all top chrome views with zero bounds.
+  if (IsParentedTo(views().horizontal_tab_strip_region_view,
+                   views().browser_view)) {
+    layout.AddChild(views().horizontal_tab_strip_region_view, gfx::Rect(),
+                    false);
+  }
+  if (IsParentedTo(views().vertical_tab_strip_region_view,
+                   views().browser_view)) {
+    layout.AddChild(views().vertical_tab_strip_region_view, gfx::Rect(),
+                    false);
+  }
+  if (IsParentedTo(views().vertical_tab_strip_top_corner,
+                   views().browser_view)) {
+    layout.AddChild(views().vertical_tab_strip_top_corner, gfx::Rect(), false);
+  }
+  if (IsParentedTo(views().vertical_tab_strip_bottom_corner,
+                   views().browser_view)) {
+    layout.AddChild(views().vertical_tab_strip_bottom_corner, gfx::Rect(),
+                    false);
+  }
+  if (IsParentedTo(views().top_container, views().browser_view)) {
+    auto& top_container_layout =
+        layout.AddChild(views().top_container, gfx::Rect(), false);
+    if (IsParentedTo(views().horizontal_tab_strip_region_view,
+                     views().top_container)) {
+      top_container_layout.AddChild(
+          views().horizontal_tab_strip_region_view, gfx::Rect(), false);
+    }
+    if (IsParentedTo(views().toolbar, views().top_container)) {
+      top_container_layout.AddChild(views().toolbar, gfx::Rect(), false);
+    }
+    if (IsParentedTo(views().bookmark_bar, views().top_container)) {
+      top_container_layout.AddChild(views().bookmark_bar, gfx::Rect(), false);
+    }
+    if (IsParentedTo(views().top_container_separator, views().top_container)) {
+      top_container_layout.AddChild(views().top_container_separator,
+                                    gfx::Rect(), false);
+    }
+  }
+
+  if (IsParentedTo(views().main_shadow_overlay, views().browser_view)) {
+    layout.AddChild(views().main_shadow_overlay, gfx::Rect(), false);
+  }
+  if (IsParentedTo(views().main_background_region, views().browser_view)) {
+    layout.AddChild(views().main_background_region, gfx::Rect(), false);
+  }
+  if (IsParentedTo(views().bookmark_bar, views().browser_view)) {
+    layout.AddChild(views().bookmark_bar, gfx::Rect(), false);
+  }
+
+  if (IsParentedTo(views().infobar_container, views().browser_view)) {
+    gfx::Rect infobar_bounds;
+    if (infobar_visible) {
+      infobar_bounds = gfx::Rect(contents_x, client_area.y(), contents_width,
+                                  infobar_height);
+    }
+    layout.AddChild(views().infobar_container, infobar_bounds, infobar_visible);
+  }
+
+  if (IsParentedToAndVisible(views().side_panel,
+                             views().browser_view)) {
+    SidePanel* const side_panel =
+        views().side_panel;
+    const bool side_panel_leading =
+        side_panel->IsRightAligned() == base::i18n::IsRTL();
+    const double side_panel_reveal_amount =
+        side_panel->GetAnimationValue();
+    const int target_width =
+        side_panel->GetPreferredSize().width();
+    const int visible_width = base::ClampFloor(
+        target_width * side_panel_reveal_amount);
+    if (visible_width > 0) {
+      if (side_panel_leading) {
+        contents_left += visible_width;
+      } else {
+        contents_right -= visible_width;
+      }
+    }
+    const int top =
+        side_panel->GetCurrentEntryType() == SidePanelType::kContent
+            ? contents_top
+            : client_area.y();
+    gfx::Rect side_panel_bounds(
+        side_panel_leading
+            ? contents_x - (target_width - visible_width)
+            : client_area.right() - visible_width,
+        top, target_width, client_area.bottom() - top);
+    layout.AddChild(views().side_panel, side_panel_bounds);
+
+    if (IsParentedToAndVisible(views().side_panel_animation_content,
+                               views().browser_view)) {
+      gfx::Rect side_panel_final_bounds(
+          side_panel_leading ? contents_x
+                                            : client_area.right() - target_width,
+          side_panel_bounds.y(), target_width,
+          side_panel_bounds.height());
+      gfx::Rect side_panel_animation_content_bounds =
+          side_panel->GetContentAnimationBounds(
+              side_panel_final_bounds);
+      layout.AddChild(views().side_panel_animation_content,
+                      side_panel_animation_content_bounds);
+    }
+  }
+
+  const int content_left =
+      std::max(contents_left, browser_params.visual_client_area.x());
+  const int content_right =
+      std::min(contents_right, browser_params.visual_client_area.right());
+  // Edge-to-edge on all sides (no margin); rounded right corners nest the pane
+  // into the window frame.
+  const int content_y = contents_top;
+  const int content_width = std::max(0, content_right - content_left);
+  const int content_height = std::max(0, client_area.height() - infobar_height);
+  const gfx::Rect contents_bounds(
+      content_left, content_y, content_width, content_height);
+  CHECK(
+      IsParentedToAndVisible(views().multi_contents_view, views().browser_view));
+  layout.AddChild(views().multi_contents_view, contents_bounds);
+
+  if (views().maho_content_gradient_view) {
+    gfx::Rect shared_glass_bounds = contents_bounds;
+    if (views().side_panel &&
+        views().side_panel->GetVisible()) {
+      const auto panel_bounds = layout.GetBoundsFor(
+          views().side_panel, views().browser_view);
+      if (panel_bounds) {
+        shared_glass_bounds.Union(*panel_bounds);
+      }
+    }
+    shared_glass_bounds.Union(contents_bounds);
+    layout.AddChild(views().maho_content_gradient_view,
+                    shared_glass_bounds,
+                    views().maho_content_gradient_view->GetVisible());
+  }
+
+  if (views().maho_create_space_blank_view &&
+      views().maho_create_space_blank_view->GetVisible()) {
+    layout.AddChild(views().maho_create_space_blank_view, contents_bounds);
+  }
+
+  views().multi_contents_view->SetShouldShowTopSeparator(false);
+
+  return layout;
+}

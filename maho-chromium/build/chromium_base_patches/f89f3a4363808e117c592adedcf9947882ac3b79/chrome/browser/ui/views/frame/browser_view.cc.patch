+bool MahoShouldRevealSharedGlass(content::WebContents* contents) {
+  if (!contents) {
+    return true;
+  }
+  const GURL& url = contents->GetVisibleURL();
+  return url.is_empty() ||
+         (url.SchemeIs("about") && url.path() == "blank") ||
+         (url.SchemeIs("chrome") &&
+          url.host() == chrome::kChromeUINewTabHost);
+}
+
+void BrowserView::ApplyMahoSidebarPaletteToContentSurfaces(
+    const MahoSidebarPalette& palette) {
+
+  // Regular windows only; Incognito keeps its fixed private surface.
+  if (browser_->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  // Empty (zero-tab) content shows the translucent themed gradient; the
+  // content web layer is made transparent so the window glass (desktop
+  // blur) shows through, matching the sidebar. Loaded tabs use an opaque
+  // themed base (web content must be opaque).
+  if (maho_content_gradient_view_) {
+    maho_content_gradient_view_->SetPalette(palette);
+  }
+  bool has_native_ntp_surface = false;
+  for (ContentsWebView* view : GetAllVisibleContentsWebViews()) {
+    if (!view) {
+      continue;
+    }
+    const bool view_shows_native_ntp =
+        MahoShouldRevealSharedGlass(view->web_contents());
+    has_native_ntp_surface |= view_shows_native_ntp;
+    view->SetVisible(!view_shows_native_ntp);
+    view->SetMahoBackgroundOverride(std::nullopt);
+    view->SetBackgroundVisible(true);
+  }
+  if (maho_content_gradient_view_) {
+    maho_content_gradient_view_->SetVisible(has_native_ntp_surface);
+  }
+#if !BUILDFLAG(IS_LINUX)
+  // On Linux there is no window vibrancy behind the translucent glass; a
+  // transparent page base would show the desktop wallpaper. Keep the default
+  // opaque page base on Linux.
+  TabStripModel* maho_tsm = browser_->GetTabStripModel();
+  for (int i = 0; i < maho_tsm->count(); ++i) {
+    if (content::WebContents* wc = maho_tsm->GetWebContentsAt(i)) {
+      wc->SetPageBaseBackgroundColor(std::nullopt);
+    }
+  }
+#endif
+}
+
+void BrowserView::MaybeRefreshMahoContentSurfacesFromSidebar() {
+  auto* container = views::AsViewClass<maho::MahoSidebarContainerView>(
+      maho_sidebar_container_);
+  if (!container) {
+    return;
+  }
+  auto* sidebar = views::AsViewClass<maho::MahoSidebarView>(
+      container->sidebar_view());
+  if (!sidebar) {
+    return;
+  }
+  const bool shared_glass_active =
+      MahoShouldRevealSharedGlass(GetActiveWebContents());
+  sidebar->SetSharedBrowserGlassActive(shared_glass_active);
+  if (!maho_sidebar_palette_subscribed_) {
+    maho_sidebar_palette_subscription_ =
+        sidebar->AddSidebarPaletteChangedCallback(base::BindRepeating(
+            &BrowserView::ApplyMahoSidebarPaletteToContentSurfaces,
+            base::Unretained(this)));
+    maho_sidebar_palette_subscribed_ = true;
+  }
+  ApplyMahoSidebarPaletteToContentSurfaces(sidebar->sidebar_palette());
+}

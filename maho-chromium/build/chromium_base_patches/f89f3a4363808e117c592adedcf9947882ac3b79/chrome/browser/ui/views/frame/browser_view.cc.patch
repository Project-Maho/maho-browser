 namespace {
 
+class MahoCreateSpaceBlankView : public views::View {
+  METADATA_HEADER(MahoCreateSpaceBlankView, views::View)
+ public:
+  MahoCreateSpaceBlankView() {
+    SetPaintToLayer();
+    layer()->SetName("MahoCreateSpaceBlankView");
+    layer()->SetFillsBoundsOpaquely(true);
+  }
+  ~MahoCreateSpaceBlankView() override = default;
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::Rect bounds = GetContentsBounds();
+    if (bounds.IsEmpty()) {
+      return;
+    }
+
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+
+    const SkColor color_top = color_provider->GetColor(kMahoColorContentGradientTop);
+    const SkColor color_bottom = color_provider->GetColor(kMahoColorContentGradientBottom);
+
+    const SkPoint points[2] = {
+        {0, 0},
+        {0, static_cast<float>(bounds.height())}};
+    const SkColor4f colors[2] = {
+        SkColor4f::FromColor(color_top),
+        SkColor4f::FromColor(color_bottom)};
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors, nullptr, 2, SkTileMode::kClamp));
+    canvas->DrawRect(bounds, flags);
+  }
+};
+
+BEGIN_METADATA(MahoCreateSpaceBlankView)
+END_METADATA

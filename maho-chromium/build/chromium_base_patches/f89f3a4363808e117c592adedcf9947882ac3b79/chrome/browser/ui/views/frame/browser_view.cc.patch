+
+void BrowserView::ShowMahoCommandOverlayForCurrentTab() {
+  auto* controller = GetOrCreateMahoCommandOverlayController();
+  if (!controller) {
+    return;
+  }
+
+  std::string current_url;
+  if (auto* contents = browser_->GetTabStripModel()->GetActiveWebContents()) {
+    const GURL& visible = contents->GetVisibleURL();
+    const GURL& url =
+        visible.is_empty() ? contents->GetLastCommittedURL() : visible;
+    if (!url.is_empty() && !url.SchemeIs("javascript") &&
+        !url.SchemeIs("data") && url.spec() != "about:blank") {
+      current_url = url.spec();
+    }
+  }
+
+  controller->Show(this, maho::CommandOverlayMode::kCurrentTab, current_url,
+                   /*select_initial_text=*/true);
+}
+
+void BrowserView::ShowMahoCommandOverlayForNewTab() {
+  if (!GetIsNormalType()) {
+    chrome::NewTab(browser_, NewTabTypes::kNewTabCommand);
+    return;
+  }
+
+  if (!initialized_ || !GetWidget()) {
+    pending_maho_command_overlay_new_tab_ = true;
+    if (GetWidget()) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &BrowserView::MaybeShowPendingMahoCommandOverlayForNewTab,
+              weak_ptr_factory_.GetWeakPtr()));
+    }
+    return;
+  }
+
+  auto* controller = GetOrCreateMahoCommandOverlayController();
+  if (!controller) {
+    return;
+  }
+
+  controller->Show(this, maho::CommandOverlayMode::kNewTab);
+}
+
+void BrowserView::MaybeShowPendingMahoCommandOverlayForNewTab() {
+  if (!pending_maho_command_overlay_new_tab_ || !initialized_ || !GetWidget()) {
+    return;
+  }
+  pending_maho_command_overlay_new_tab_ = false;
+  ShowMahoCommandOverlayForNewTab();
+}

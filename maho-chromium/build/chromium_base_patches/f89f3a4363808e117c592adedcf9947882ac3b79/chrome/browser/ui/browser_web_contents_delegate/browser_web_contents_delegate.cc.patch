+namespace maho {
+// Defined in maho/browser/maho_browser_main_extra_parts.cc.
+// Returns true when the chooser was consumed by automation
+// (native dialog suppressed; input.file_upload_select completes it).
+bool MahoBeginAutomationFileChooser(
+    content::RenderFrameHost* render_frame_host,
+    scoped_refptr<content::FileSelectListener> listener,
+    blink::mojom::FileChooserParams::Mode mode);
+}  // namespace maho
+
 void BrowserWebContentsDelegate::RunFileChooser(
     content::RenderFrameHost* render_frame_host,
     scoped_refptr<content::FileSelectListener> listener,
     const blink::mojom::FileChooserParams& params) {
+  // Maho: suppress the native file-selection dialog while an
+  // automation lease owns this tab; the MCP browser delegate
+  // completes the chooser via input.file_upload_select instead.
+  if (maho::MahoBeginAutomationFileChooser(
+          render_frame_host, listener, params.mode)) {
+    return;
+  }
   FileSelectHelper::RunFileChooser(render_frame_host, std::move(listener),
                                    params);
 }

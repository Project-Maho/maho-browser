+  // Maho: normal browser windows support zero-tab state.  Only close the
+  // window when we are already in an explicit close flow (i.e.
+  // UnloadController has already set is_attempting_to_close_browser_ via
+  // TryToCloseWindow / GetBrowserClosingStatus).  For every other browser
+  // type the original behaviour is preserved.
+  if (GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&

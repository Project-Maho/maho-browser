diff --git c/chrome/app/chrome_main_delegate.cc w/chrome/app/chrome_main_delegate.cc
index b8eeec779ce30b20cc550f12cfda599c4604ced3..aef8497fac64b2126025a2ddcb528df469e11243 100644
--- c/chrome/app/chrome_main_delegate.cc
+++ w/chrome/app/chrome_main_delegate.cc
@@ -1117,6 +1117,25 @@ std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
 
+  // Maho: enable kGlassFrame by default on macOS.
+  // Must run before base::FeatureList::InitializeInstance to take
+  // effect. Users can still opt out with --disable-features=GlassFrame.
+#if BUILDFLAG(IS_MAC)
+  {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    const std::string disabled =
+        cmd->GetSwitchValueASCII("disable-features");
+    if (disabled.find("GlassFrame") == std::string::npos) {
+      const std::string existing =
+          cmd->GetSwitchValueASCII("enable-features");
+      cmd->AppendSwitchASCII(
+          "enable-features",
+          existing.empty() ? std::string("GlassFrame")
+                           : existing + ",GlassFrame");
+    }
+  }
+#endif
+
 #if !defined(BUILDING_CHROME_RENDERER)
   const base::CommandLine& command_line =
       *base::CommandLine::ForCurrentProcess();

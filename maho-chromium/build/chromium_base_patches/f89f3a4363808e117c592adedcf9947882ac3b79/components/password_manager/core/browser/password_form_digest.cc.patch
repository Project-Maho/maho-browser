+PasswordFillResolution::PasswordFillResolution(std::u16string secret)
+    : secret_(std::move(secret)) {}
+
+PasswordFillResolution::PasswordFillResolution(PasswordFillResolution&& other) noexcept
+    : secret_(std::move(other.secret_)) {}
+
+PasswordFillResolution& PasswordFillResolution::operator=(
+    PasswordFillResolution&& other) noexcept {
+  if (this != &other) {
+    Zeroize();
+    secret_ = std::move(other.secret_);
+  }
+  return *this;
+}
+
+PasswordFillResolution::~PasswordFillResolution() {
+  Zeroize();
+}
+
+void PasswordFillResolution::Zeroize() {
+  std::fill(secret_.begin(), secret_.end(), u'\0');
+  secret_.clear();
+}
+
+PasswordFillResolver::PasswordFillResolver(PasswordFillResolver&&) noexcept =
+    default;
+
+PasswordFillResolver& PasswordFillResolver::operator=(
+    PasswordFillResolver&&) noexcept = default;
+
+PasswordFillResolver::~PasswordFillResolver() = default;
+
+PasswordFillResolver::PasswordFillResolver(
+    base::OnceCallback<void(std::optional<PasswordFillResolution>)> callback)
+    : callback_(std::move(callback)) {}
+
+void PasswordFillResolver::Run(
+    std::optional<PasswordFillResolution> resolution) && {
+  std::move(callback_).Run(std::move(resolution));
+}

@@ -18,4 +228,84 @@ SplitTabVisualData::SplitTabVisualData(SplitTabLayout split_layout,
 
 SplitTabVisualData::~SplitTabVisualData() = default;
 
+SplitTabVisualData::SplitTabVisualData(const SplitTabVisualData& other) = default;
+SplitTabVisualData::SplitTabVisualData(SplitTabVisualData&& other) = default;
+
+void SplitTabVisualData::set_split_layout(SplitTabLayout split_layout) {
+  split_layout_ = split_layout;
+  if (layout_tree_ && !layout_tree_->is_pane()) {
+    layout_tree_ = SplitLayoutNode::Split(
+        split_layout_, layout_tree_->ratio(), *layout_tree_->first(),
+        *layout_tree_->second());
+  }
+}
+
+void SplitTabVisualData::set_split_ratio(double split_ratio) {
+  split_ratio_ = split_ratio;
+  if (layout_tree_ && !layout_tree_->is_pane()) {
+    layout_tree_ = SplitLayoutNode::Split(
+        layout_tree_->layout(), split_ratio_, *layout_tree_->first(),
+        *layout_tree_->second());
+  }
+}
+
+void SplitTabVisualData::set_layout_tree(
+    std::optional<SplitLayoutNode> layout_tree) {
+  layout_tree_ = std::move(layout_tree);
+  MirrorTreeRootToLegacyFields();
+}
+
+bool SplitTabVisualData::ValidateForPaneCount(size_t pane_count) const {
+  if (pane_count < 2 || pane_count > 4 || !std::isfinite(split_ratio_) ||
+      split_ratio_ <= 0.0 || split_ratio_ >= 1.0) {
+    return false;
+  }
+  if (!layout_tree_) {
+    return pane_count == 2;
+  }
+  return layout_tree_->ValidateForPaneCount(pane_count) &&
+         !layout_tree_->is_pane() &&
+         layout_tree_->layout() == split_layout_ &&
+         layout_tree_->ratio() == split_ratio_;
+}
+
+SplitTabVisualData SplitTabVisualData::CreateTwoPane(SplitTabLayout layout,
+                                                      double ratio) {
+  SplitTabVisualData data(layout, ratio);
+  data.layout_tree_ = SplitLayoutNode::Split(
+      layout, ratio, SplitLayoutNode::Pane(0), SplitLayoutNode::Pane(1));
+  return data;
+}
+
+bool SplitTabVisualData::InsertPaneAtLeaf(size_t target_leaf,
+                                          SplitTabLayout layout,
+                                          double ratio,
+                                          SplitPaneInsertionSide side) {
+  if (!layout_tree_) {
+    layout_tree_ = SplitLayoutNode::Split(
+        split_layout_, split_ratio_, SplitLayoutNode::Pane(0),
+        SplitLayoutNode::Pane(1));
+  }
+  if (!layout_tree_->InsertPaneAtLeaf(target_leaf, layout, ratio, side)) {
+    return false;
+  }
+  MirrorTreeRootToLegacyFields();
+  return true;
+}
+
+bool SplitTabVisualData::RemovePane(size_t leaf) {
+  if (!layout_tree_ || !layout_tree_->RemovePane(leaf)) {
+    return false;
+  }
+  MirrorTreeRootToLegacyFields();
+  return true;
+}
+
+void SplitTabVisualData::MirrorTreeRootToLegacyFields() {
+  if (layout_tree_ && !layout_tree_->is_pane()) {
+    split_layout_ = layout_tree_->layout();
+    split_ratio_ = layout_tree_->ratio();
+  }
+}
+
 }  // namespace split_tabs

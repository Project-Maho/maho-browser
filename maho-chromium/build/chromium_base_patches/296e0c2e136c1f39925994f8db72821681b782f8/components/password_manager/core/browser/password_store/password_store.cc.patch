+void PasswordStore::GetLogins(
+    const PasswordFormDigest& form,
+    const PasswordFillRequestContext& context,
+    base::WeakPtr<PasswordStoreConsumer> consumer) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!backend_) {
+    return;
+  }
+  if (post_init_callback_) {
+    post_init_callback_ =
+        std::move(post_init_callback_)
+            .Then(base::BindOnce(
+                static_cast<void (PasswordStore::*)(
+                    const PasswordFormDigest&,
+                    const PasswordFillRequestContext&,
+                    base::WeakPtr<PasswordStoreConsumer>)>(
+                    &PasswordStore::GetLogins),
+                this, form, context, consumer));
+    return;
+  }
+  backend_->GetGroupedMatchingLoginsAsync(
+      form, context,
+      base::BindOnce(&ConsumerReplyConverter, consumer,
+                     base::RetainedRef(this)));
+}
+
+void PasswordStore::ResolvePasswordFill(
+    const PasswordFillRequestContext& context,
+    const PasswordFillSelection& selection,
+    PasswordFillResolver resolver) {
+  if (!backend_) {
+    std::move(resolver).Run(std::nullopt);
+    return;
+  }
+  backend_->ResolvePasswordFill(context, selection, std::move(resolver));
+}

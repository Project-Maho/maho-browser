diff --git a/ui/base/cocoa/command_dispatcher.mm b/ui/base/cocoa/command_dispatcher.mm
index 20ef4a16017de00f879714872fc5fff39d6b6d13..5ab3b8f398094765102146a89be899b8a04e2992 100644
--- a/ui/base/cocoa/command_dispatcher.mm
+++ b/ui/base/cocoa/command_dispatcher.mm
@@ -245,18 +245,33 @@ NSEvent* KeyEventForWindow(NSWindow* window, NSEvent* event) {
 
 - (void)dispatch:(id)sender
       forHandler:(id<UserInterfaceItemCommandHandler>)handler {
-  if (handler)
+  if (handler) {
     [handler commandDispatch:sender window:_owner];
-  else
+  } else if (_owner.commandDispatchParent) {
     [_owner.commandDispatchParent commandDispatch:sender];
+  } else {
+    // Maho: mirror -validateUserInterfaceItem:'s AppController fallback so a
+    // command the app delegate enabled (e.g. New Incognito Window while a
+    // non-Browser window such as the login gate is key, with no
+    // commandDispatchParent) actually runs instead of no-oping against nil.
+    id appController = [NSApp delegate];
+    if ([appController respondsToSelector:@selector(commandDispatch:)])
+      [appController commandDispatch:sender];
+  }
 }
 
 - (void)dispatchUsingKeyModifiers:(id)sender
                        forHandler:(id<UserInterfaceItemCommandHandler>)handler {
-  if (handler)
+  if (handler) {
     [handler commandDispatchUsingKeyModifiers:sender window:_owner];
-  else
+  } else if (_owner.commandDispatchParent) {
     [_owner.commandDispatchParent commandDispatchUsingKeyModifiers:sender];
+  } else {
+    id appController = [NSApp delegate];
+    if ([appController
+            respondsToSelector:@selector(commandDispatchUsingKeyModifiers:)])
+      [appController commandDispatchUsingKeyModifiers:sender];
+  }
 }
 
 @end

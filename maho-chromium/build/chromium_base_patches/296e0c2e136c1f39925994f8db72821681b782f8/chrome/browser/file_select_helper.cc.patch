+bool FileSelectHelper::SelectFileForPendingChooser(
+    content::WebContents* web_contents,
+    const base::FilePath& path) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto it = ActiveChoosers().find(web_contents);
+  if (it == ActiveChoosers().end()) {
+    return false;
+  }
+  FileSelectHelper* helper = it->second;
+  if (!helper || helper->web_contents_ != web_contents || !helper->listener_ ||
+      helper->programmatic_file_selection_started_ ||
+      (helper->dialog_mode_ != FileChooserParams::Mode::kOpen &&
+       helper->dialog_mode_ != FileChooserParams::Mode::kOpenMultiple)) {
+    return false;
+  }
+  helper->programmatic_file_selection_started_ = true;
+  helper->FileSelected(ui::SelectedFileInfo(path), 0);
+  return true;
+}

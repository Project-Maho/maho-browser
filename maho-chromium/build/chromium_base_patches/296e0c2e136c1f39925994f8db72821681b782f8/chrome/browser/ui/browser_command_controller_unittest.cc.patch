+TEST_F(BrowserCommandControllerTest, SelectTabCommandWaitsForStartupTab) {
+  chrome::BrowserCommandController command_controller(browser());
+  browser()->tab_strip_model()->CloseAllTabs();
+  ASSERT_EQ(TabStripModel::kNoTab, browser()->tab_strip_model()->active_index());
+
+  EXPECT_TRUE(command_controller.ExecuteCommand(IDC_SELECT_TAB_0));
+  AddTab(browser(), GURL("https://example.com/first"));
+  AddTab(browser(), GURL("https://example.com/second"));
+  browser()->tab_strip_model()->ActivateTabAt(1);
+  ASSERT_EQ(1, browser()->tab_strip_model()->active_index());
+
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(0, browser()->tab_strip_model()->active_index());
+}

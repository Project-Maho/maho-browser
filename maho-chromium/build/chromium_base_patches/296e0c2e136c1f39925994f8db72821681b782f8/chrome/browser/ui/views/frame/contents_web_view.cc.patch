+void ContentsWebView::SetMahoBackgroundOverride(
+    std::optional<SkColor> color) {
+  if (color.has_value()) {
+    color = SkColorSetA(color.value(), SK_AlphaOPAQUE);
+  }
+  if (maho_background_override_ == color) {
+    return;
+  }
+  maho_background_override_ = color;
+  UpdateBackgroundColor();
+}

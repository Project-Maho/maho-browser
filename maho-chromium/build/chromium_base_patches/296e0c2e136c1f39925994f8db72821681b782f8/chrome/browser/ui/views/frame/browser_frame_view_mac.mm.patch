+void BrowserFrameViewMac::UpdateSidebarTrafficLightsVisibility() {
+  auto* const sidebar = static_cast<maho::MahoSidebarContainerView*>(
+      GetBrowserView()->maho_sidebar_container());
+  if (!sidebar) {
+    return;
+  }
+
+  NSWindow* const window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  if (!window) {
+    return;
+  }
+
+  NSView* const theme_frame = window.contentView.superview;
+  if (!theme_frame ||
+      ![theme_frame respondsToSelector:@selector(setButtonRevealAmount:)]) {
+    return;
+  }
+
+  const bool should_show = !sidebar->IsAutoHideMode() ||
+                           sidebar->IsOverlayVisible();
+  [theme_frame setButtonRevealAmount:should_show ? 1.0 : 0.0];
+}

+
+bool BrowserCaptionButtonContainer::IsMahoArcCaptionMode() const {
+  return frame_view_->GetBrowserView()->IsMahoArcLayoutActive();
+}
+
+bool BrowserCaptionButtonContainer::IsMahoArcCaptionTriggerPoint(
+    const gfx::Point& screen_point) const {
+  views::Widget* widget = GetWidget();
+  if (!widget || widget->IsFullscreen()) {
+    return false;
+  }
+  // Maho: reveal when the pointer touches the full-width strip along
+  // the very top edge of the window (the hidden handle bar hotzone).
+  // Clamp to the display work area so the hotzone stays reachable when
+  // maximized (a maximized window's top border overhangs off-screen).
+  gfx::Rect trigger_bounds = widget->GetWindowBoundsInScreen();
+  trigger_bounds.Intersect(
+      display::Screen::Get()
+          ->GetDisplayNearestWindow(widget->GetNativeWindow())
+          .work_area());
+  if (trigger_bounds.width() <= 0 || trigger_bounds.height() <= 0) {
+    return false;
+  }
+  trigger_bounds.set_height(std::min(kMahoArcCaptionRevealTriggerHeight,
+                                      trigger_bounds.height()));
+  return trigger_bounds.Contains(screen_point);
+}
+
+bool BrowserCaptionButtonContainer::IsMahoArcCaptionKeepAlivePoint(
+    const gfx::Point& screen_point) const {
+  return GetBoundsInScreen().Contains(screen_point) ||
+         IsMahoArcCaptionTriggerPoint(screen_point);
+}
+
+int BrowserCaptionButtonContainer::GetMahoArcCaptionPreferredWidth()
+    const {
+  int width = 0;
+  if (frame_view_->GetBrowserView()->CanMinimize()) {
+    width += minimize_button_->GetPreferredSize().width();
+  }
+  if (frame_view_->GetBrowserView()->CanMaximize()) {
+    width += (frame_view_->IsMaximized() ? restore_button_
+                                       : maximize_button_)
+                 ->GetPreferredSize()
+                 .width();
+  }
+  width += close_button_->GetPreferredSize().width();
+  return std::max(width, kMahoArcCaptionRevealTriggerWidth);
+}
+
+void BrowserCaptionButtonContainer::MaybeRevealMahoArcCaption() {
+  if (maho_arc_caption_revealed_) {
+    return;
+  }
+  const gfx::Point cursor =
+      display::Screen::Get()->GetCursorScreenPoint();
+  if (IsMahoArcCaptionTriggerPoint(cursor)) {
+    RevealMahoArcCaptionButtons();
+  }
+}
+
+void BrowserCaptionButtonContainer::RevealMahoArcCaptionButtons() {
+  if (!IsMahoArcCaptionMode() ||
+      frame_view_->browser_widget()->IsFullscreen()) {
+    return;
+  }
+  if (!maho_arc_caption_hide_timer_.IsRunning()) {
+    maho_arc_caption_hide_timer_.Start(
+        FROM_HERE, base::Milliseconds(250), this,
+        &BrowserCaptionButtonContainer::PollMahoArcCaptionHide);
+  }
+  if (maho_arc_caption_revealed_) {
+    return;
+  }
+  maho_arc_caption_revealed_ = true;
+  UpdateButtons();
+  frame_view_->InvalidateLayout();
+  frame_view_->DeprecatedLayoutImmediately();
+}
+
+void BrowserCaptionButtonContainer::PollMahoArcCaptionHide() {
+  if (!maho_arc_caption_revealed_) {
+    return;
+  }
+  const gfx::Point cursor =
+      display::Screen::Get()->GetCursorScreenPoint();
+  if (!frame_view_->browser_widget()->IsFullscreen() &&
+      IsMahoArcCaptionKeepAlivePoint(cursor)) {
+    maho_arc_caption_hide_timer_.Start(
+        FROM_HERE, base::Milliseconds(250), this,
+        &BrowserCaptionButtonContainer::PollMahoArcCaptionHide);
+    return;
+  }
+  HideMahoArcCaptionButtons();
+}
+
+void BrowserCaptionButtonContainer::ScheduleHideMahoArcCaptionButtons() {
+  if (!maho_arc_caption_revealed_) {
+    return;
+  }
+  if (gfx::ScopedAnimationDurationScaleMode::is_zero()) {
+    HideMahoArcCaptionButtons();
+    return;
+  }
+  maho_arc_caption_hide_timer_.Start(
+      FROM_HERE, kMahoArcCaptionHideDelay, this,
+      &BrowserCaptionButtonContainer::HideMahoArcCaptionButtons);
+}
+
+void BrowserCaptionButtonContainer::HideMahoArcCaptionButtons() {
+  if (!maho_arc_caption_revealed_) {
+    return;
+  }
+  maho_arc_caption_hide_timer_.Stop();
+  maho_arc_caption_revealed_ = false;
+  UpdateButtons();
+  frame_view_->InvalidateLayout();
+  frame_view_->DeprecatedLayoutImmediately();
+}
+
+void BrowserCaptionButtonContainer::
+    ApplyMahoArcCaptionButtonVisibility() {
+  if (!IsMahoArcCaptionMode()) {
+    SetCanProcessEventsWithinSubtree(true);
+    SetPreferredSize(std::nullopt);
+    return;
+  }
+
+  const bool revealed = maho_arc_caption_revealed_ &&
+                        !frame_view_->browser_widget()->IsFullscreen();
+  if (!revealed) {
+    minimize_button_->SetVisible(false);
+    maximize_button_->SetVisible(false);
+    restore_button_->SetVisible(false);
+    close_button_->SetVisible(false);
+  }
+  SetCanProcessEventsWithinSubtree(revealed);
+  SetPreferredSize(gfx::Size(
+      revealed ? GetMahoArcCaptionPreferredWidth()
+               : 0,
+      0));
+}
+
+void BrowserCaptionButtonContainer::UpdateMahoArcCaptionEventMonitor() {
+  views::Widget* const widget = GetWidget();
+  if (!widget || !IsMahoArcCaptionMode()) {
+    maho_arc_caption_event_monitor_.reset();
+    return;
+  }
+  if (!maho_arc_caption_event_monitor_) {
+    maho_arc_caption_event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, widget->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited});
+  }
 }
 

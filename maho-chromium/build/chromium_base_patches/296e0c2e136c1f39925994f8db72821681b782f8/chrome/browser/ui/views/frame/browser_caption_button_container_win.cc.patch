+  if (maho_arc_caption_revealed_) {
+    return;
+  }
+  if (IsMahoArcCaptionTriggerPoint(screen_point)) {
+    if (!maho_arc_caption_hide_timer_.IsRunning()) {
+      maho_arc_caption_hide_timer_.Start(
+          FROM_HERE, base::Milliseconds(250), this,
+          &BrowserCaptionButtonContainer::MaybeRevealMahoArcCaption);
+    }
+  } else {
+    maho_arc_caption_hide_timer_.Stop();
+  }
+}

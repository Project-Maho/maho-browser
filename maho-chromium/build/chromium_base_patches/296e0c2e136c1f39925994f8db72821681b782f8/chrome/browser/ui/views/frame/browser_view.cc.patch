+      stack.pop_back();
+      if (auto* web_view =
+              views::AsViewClass<views::WebView>(node)) {
+        web_view->SetFastResize(false);
+        web_view->InvalidateLayout();
+      }
+      for (views::View* child : node->children()) {
+        stack.push_back(child);
+      }

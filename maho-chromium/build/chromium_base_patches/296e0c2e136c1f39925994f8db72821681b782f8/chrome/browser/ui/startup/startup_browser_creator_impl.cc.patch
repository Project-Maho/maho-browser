+// Maho cold-start: retry opening the new-tab command palette until the
+// BrowserView and its sidebar container are constructed. On the zero-tab
+// startup path BrowserView::GetBrowserViewForBrowser() can briefly return
+// null (or the sidebar container is not built yet) right after
+// window()->Show(), so a single attempt is dropped and no palette appears.
+// Give up without creating a tab once the attempt budget is exhausted so
+// the zero-tab themed gradient window remains.
+void ShowMahoColdStartPaletteWhenReady(base::WeakPtr<Browser> browser,
+                                       int remaining_attempts) {
+  if (!browser) {
+    return;
+  }
+  if (auto* browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser.get())) {
+    // BrowserView queues the new-tab overlay until its widget and views
+    // are initialized. Do not wait for sidebar construction here: in slow
+    // cold starts that unnecessarily exhausts this helper's retry budget
+    // and leaves the zero-tab browser with no palette.
+    browser_view->ShowMahoCommandOverlayForNewTab();
+    return;
+  }
+  if (remaining_attempts <= 0) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ShowMahoColdStartPaletteWhenReady, browser,
+                     remaining_attempts - 1),
+      base::Milliseconds(25));
+}
+
+// Maho: open the command palette on the FIRST normal browser window of each
+// app launch, whichever startup path created it (session restore, empty
+// cold-start, or opened tabs). The process-global guard fires it exactly once
+// per launch, so only the first window gets it.
+void MahoMaybeAutoOpenPaletteOnFirstWindow(Browser* browser) {
+  if (!browser || !browser->is_type_normal()) {
+    return;
+  }
+  static std::atomic<bool> g_maho_first_window_palette_shown{false};
+  if (!g_maho_first_window_palette_shown.exchange(true)) {
+    ShowMahoColdStartPaletteWhenReady(browser->AsWeakPtr(), 200);
+  }
+}

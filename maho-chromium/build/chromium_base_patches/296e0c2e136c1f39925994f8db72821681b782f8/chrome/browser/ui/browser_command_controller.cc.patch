+void ShowMahoCommandOverlayForNewTabWhenReady(base::WeakPtr<Browser> browser,
+                                              int remaining_attempts) {
+  if (!browser) {
+    return;
+  }
+
+  if (!browser->is_type_normal()) {
+    NewTab(browser.get());
+    return;
+  }
+
+  if (auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser.get())) {
+    if (!browser_view->maho_sidebar_container()) {
+      NewTab(browser.get());
+      return;
+    }
+    browser_view->ShowMahoCommandOverlayForNewTab();
+    return;
+  }
+
+  if (remaining_attempts <= 0) {
+    NewTab(browser.get());
+    return;
+  }
+
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ShowMahoCommandOverlayForNewTabWhenReady, browser,
+                     remaining_attempts - 1),
+      base::Milliseconds(25));
+}
+
+bool ShouldDeferStartupCommandUntilTabSelected(int id) {
+  switch (id) {
+    case IDC_SELECT_NEXT_TAB:
+    case IDC_SELECT_PREVIOUS_TAB:
+    case IDC_SELECT_TAB_0:
+    case IDC_SELECT_TAB_1:
+    case IDC_SELECT_TAB_2:
+    case IDC_SELECT_TAB_3:
+    case IDC_SELECT_TAB_4:
+    case IDC_SELECT_TAB_5:
+    case IDC_SELECT_TAB_6:
+    case IDC_SELECT_TAB_7:
+    case IDC_SELECT_LAST_TAB:
+    case IDC_FOCUS_LOCATION:
+    case IDC_FOCUS_SEARCH:
+    case IDC_SHOW_HISTORY:
+    case IDC_SHOW_DOWNLOADS:
+    case IDC_SHOW_BOOKMARK_MANAGER:
+    case IDC_MAHO_COMMAND_BAR:
+    case IDC_MAHO_AI_PANEL:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void ExecuteStartupCommandWhenTabSelected(base::WeakPtr<Browser> browser,
+                                          int id,
+                                          WindowOpenDisposition disposition,
+                                          base::TimeTicks time_stamp,
+                                          int remaining_attempts) {
+  if (!browser) {
+    return;
+  }
+
+  if (browser->tab_strip_model()->active_index() != TabStripModel::kNoTab) {
+    browser->command_controller()->ExecuteCommandWithDisposition(
+        id, disposition, time_stamp);
+    return;
+  }
+
+  if (remaining_attempts <= 0) {
+    return;
+  }
+
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ExecuteStartupCommandWhenTabSelected, browser, id,
+                     disposition, time_stamp, remaining_attempts - 1),
+      base::Milliseconds(25));
+}

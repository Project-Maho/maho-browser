+bool ActivateMahoSettingsTabIfOpen(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return false;
+  }
+
+  NavigateParams params(browser, GURL(maho::kMahoSettingsURL),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::SINGLETON_TAB;
+
+  auto [existing_browser, tab_index] =
+      GetIndexAndBrowserOfMatchingTab(browser->GetProfile(), params);
+  if (!existing_browser) {
+    return false;
+  }
+
+  existing_browser->GetWindow()->Activate();
+  existing_browser->GetTabStripModel()->ActivateTabAt(tab_index);
+  if (content::WebContents* contents =
+          existing_browser->GetTabStripModel()->GetActiveWebContents()) {
+    contents->Focus();
+  }
+  return true;
+}

 void ShowSettings(BrowserWindowInterface* browser) {
+  // Maho: open Maho's own settings surface instead of
+  // chrome://settings. This is the single choke point for the macOS
+  // app menu Settings item, Cmd+comma, IDC_OPTIONS and
+  // chrome::OpenOptionsWindow.
+  Browser* maho_browser =
+      browser ? browser->GetBrowserForMigrationOnly() : nullptr;
+  if (maho_browser) {
+    maho::OpenMahoSettingsPane(maho_browser, std::string());
+    return;
+  }
   ShowSettingsSubPage(browser, std::string());
 }
 
+void ShowMahoSettings(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return;
+  }
+
+  if (ActivateMahoSettingsTabIfOpen(browser)) {
+    return;
+  }
+
+  ShowSingletonTabIgnorePathOverwriteNTP(
+      browser, GURL(maho::kMahoSettingsURL));
+}
+
+void ShowMahoSettingsForProfile(Profile* profile) {
+  BrowserWindowInterface* browser = GetOrCreateBrowserForProfile(profile);
+  ShowMahoSettings(browser);
+}

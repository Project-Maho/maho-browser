+
 void OpenUrlsInBrowserWithProfile(const std::vector<GURL>& urls,
                                   Profile* profile) {
   if (!profile)
     return;  // No suitable profile to open the URLs, do nothing.
+
+  Profile* regular_profile = profile->GetOriginalProfile();
+  if (regular_profile->GetPrefs()->GetBoolean(
+          maho::welcome::kLoginGateActive)) {
+    app_controller_mac::QueueNativeUrlsWhileMahoLoginGated(profile, urls);
+    maho::MahoWelcomeWindow::Show(profile);
+    return;
+  }
+
+  if (urls.size() == 1) {
+    GURL url = urls[0];
+    base::WeakPtr<Profile> weak_profile = profile->GetWeakPtr();
+    maho::DecideLinkDestination(
+        url, /*is_external=*/true,
+        base::BindOnce(
+            [](base::WeakPtr<Profile> profile, GURL url, maho::LinkDestinationResult result) {
+              if (!profile) return;
+              if (result.type == maho::LinkDestinationType::kSpace && !result.space_id.empty()) {
+                Browser* browser = chrome::FindTabbedBrowser(profile.get(), false);
+                if (!browser) {
+                  browser = Browser::Create(Browser::CreateParams(profile.get(), true));
+                  if (browser && browser->window()) {
+                    browser->window()->Show();
+                  }
+                }
+                if (browser) {
+                  maho::MahoSpaceProfileBridge* bridge = maho::MahoSpaceProfileBridge::GetInstance();
+                  if (bridge && bridge->SwitchToSpace(browser, result.space_id)) {
+                    chrome::AddSelectedTabWithURL(browser, url, ui::PAGE_TRANSITION_LINK);
+                  }
+                }
+              } else if (result.type == maho::LinkDestinationType::kMahoMini) {
+                maho::LaunchMahoMini(profile.get(), maho::MahoMiniRequest{url});
+              } else {
+                std::vector<GURL> urls_fallback = {url};
+                OpenUrlsInBrowserWithProfileNormal(urls_fallback, profile.get());
+              }
+            },
+            weak_profile, url));
+    return;
+  }
+  OpenUrlsInBrowserWithProfileNormal(urls, profile);
+}

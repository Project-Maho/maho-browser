 void Layer::SetFillsBoundsOpaquely(bool fills_bounds_opaquely) {
-  CHECK_NE(type_, LayerType::LAYER_SOLID_COLOR);
+  // Maho: solid-color layers derive opacity from their color's alpha,
+  // so this setter is a no-op for them; upstream CHECK_NEs and aborts.
+  // kGlassFrame makes LayerBasedSolidBackground force LAYER_SOLID_COLOR
+  // on views that also call SetFillsBoundsOpaquely, so no-op instead.
+  if (type_ == LayerType::LAYER_SOLID_COLOR) {
+    return;
+  }
   SetFillsBoundsOpaquelyWithReason(fills_bounds_opaquely,
                                    PropertyChangeReason::NOT_FROM_ANIMATION);
 }

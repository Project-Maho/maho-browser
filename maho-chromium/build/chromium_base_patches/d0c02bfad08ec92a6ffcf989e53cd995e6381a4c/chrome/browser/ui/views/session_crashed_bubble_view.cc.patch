@@ -286,6 +291,57 @@ views::BubbleDialogDelegate* SessionCrashedBubbleView::ShowBubble(
   }
 
   auto* control = browser_view->toolbar_button_provider()->GetAppMenuControl();
+
+  // Maho: the toolbar is always hidden, so the app menu control is never drawn
+  // and GetAnchor() resolves to the fallback popup anchor. That anchor only
+  // becomes a shown element once the browser widget is visible, but startup
+  // asks for this bubble while the first tab is inserted, before the window is
+  // shown. Defer the bubble until the fallback anchor is shown instead of
+  // anchoring to an element that does not exist yet.
+  if (control && !control->IsDrawn()) {
+    const ui::ElementContext context =
+        views::ElementTrackerViews::GetContextForView(browser_view);
+    if (!ui::ElementTracker::GetElementTracker()->IsElementVisible(
+            kFallbackPopupAnchorElementId, context)) {
+      static base::NoDestructor<base::CallbackListSubscription>
+          pending_anchor_subscription;
+      static bool show_pending = false;
+      show_pending = true;
+      *pending_anchor_subscription =
+          ui::ElementTracker::GetElementTracker()->AddElementShownCallback(
+              kFallbackPopupAnchorElementId, context,
+              base::BindRepeating(
+                  [](base::WeakPtr<BrowserWindowInterface> weak_browser,
+                     bool uma_opted_in_already, bool offer_uma_optin,
+                     ui::TrackedElement*) {
+                    // Show once, even if the anchor toggles before the
+                    // posted task runs.
+                    if (!show_pending) {
+                      return;
+                    }
+                    show_pending = false;
+                    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                        FROM_HERE,
+                        base::BindOnce(
+                            [](base::WeakPtr<BrowserWindowInterface> browser,
+                               bool uma_opted_in_already,
+                               bool offer_uma_optin) {
+                              *pending_anchor_subscription =
+                                  base::CallbackListSubscription();
+                              if (browser) {
+                                ShowBubble(browser.get(), uma_opted_in_already,
+                                           offer_uma_optin);
+                              }
+                            },
+                            weak_browser, uma_opted_in_already,
+                            offer_uma_optin));
+                  },
+                  browser->GetWeakPtr(), uma_opted_in_already,
+                  offer_uma_optin));
+      return nullptr;
+    }
+  }
+
   views::BubbleAnchor anchor =
       control ? control->GetAnchor() : views::BubbleAnchor();
 

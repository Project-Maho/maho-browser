 void UnloadController::TabStripEmpty() {
+  // Maho zero-tab: for normal browser windows the tab strip becoming empty
+  // does not mean the window is closing - the window survives with zero tabs
+  // so new tabs can be inserted again. Only mark the browser as closing when
+  // an explicit close flow (TryToCloseWindow / GetBrowserClosingStatus) is
+  // already in progress, so unload events still fire on a real close.
+  if (browser_->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+      !is_attempting_to_close_browser()) {
+    return;
+  }
   // Set state_ here, so that extensions, etc, do not attempt to add tabs to the
   // browser before it closes.

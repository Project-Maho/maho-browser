+IN_PROC_BROWSER_TEST_F(BrowserCommandControllerBrowserTest,
+                       SelectTabCommandWaitsForStartupTab) {
+  browser()->GetTabStripModel()->CloseAllTabs();
+  ASSERT_EQ(TabStripModel::kNoTab,
+            browser()->GetTabStripModel()->active_index());
+
+  EXPECT_TRUE(chrome::ExecuteCommand(browser(), IDC_SELECT_TAB_0));
+  chrome::AddTabAt(browser(), GURL("https://example.com/first"), -1, false);
+  chrome::AddTabAt(browser(), GURL("https://example.com/second"), -1, false);
+  browser()->GetTabStripModel()->ActivateTabAt(1);
+  ASSERT_EQ(1, browser()->GetTabStripModel()->active_index());
+
+  ASSERT_TRUE(base::test::RunUntil([this]() {
+    return browser()->GetTabStripModel()->active_index() == 0;
+  }));
+  EXPECT_EQ(0, browser()->GetTabStripModel()->active_index());
+}

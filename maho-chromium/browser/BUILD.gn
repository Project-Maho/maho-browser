source_set("maho_core_holder") {
  sources = [
    "maho_core_holder.cc",
    "maho_core_holder.h",
  ]
  # The launcher (and its version header) live in the reusable
  # :maho_mail_launcher source_set rather than being compiled here directly,
  # so the browser service and this holder share one copy. Exposed publicly
  # because consumers of this target use the launcher + version header.
  # maho_core_holder.h exposes Profile* in its public API
  # (SetCoreForProfile / GetCoreOwnerProfile / IsPasswordManagerAllowedForProfile)
  # and the .cc calls Profile methods, so profiles:profile is a public_dep.
  public_deps = [
    "//chrome/browser/profiles:profile",
    "//maho/browser/mail_helper:maho_mail_launcher",
  ]
  deps = [
    "//maho/browser/mail_helper:mojo_bindings",
    "//base",
    "//content/public/browser",
    "//maho/third_party/maho:maho_bridge",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
  ]

  # Keep the out-of-process helper in the browser build graph on every desktop
  # platform. Windows uses the native Crypt32/NCrypt S/MIME backend, so the
  # mail static library no longer brings OpenSSL into this executable's link.
  deps += [ "//maho/browser/mail_helper:maho_mail_helper" ]
}




if (is_mac) {
  # The macOS share picker owns the MahoSharePickerDelegate ObjC class. It is
  # split into its own component() so the class has a single link identity
  # (its own dylib in component builds). If it stayed a plain source_set,
  # GN would fold its objects into every terminal linkable that reaches it
  # (the views component dylib AND the interactive_ui_tests executable),
  # producing duplicate ObjC class registration and a runtime segfault.
  component("maho_notification_share_mac") {
    sources = [
      "ui/notifications/maho_notification_share_mac.h",
      "ui/notifications/maho_notification_share_mac.mm",
    ]
    frameworks = [ "AppKit.framework" ]
    deps = [
      "//base",
      "//net",
      "//ui/gfx",
      "//ui/gfx/geometry",
      "//ui/views",
      "//url",
    ]
  }
}


import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("resources") {
  grd_prefix = "maho_routines"

  static_files = [ "routines.html" ]

  ts_files = [ "app.ts" ]

  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_routines:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_routines/maho_routines.mojom-webui.ts" ]
}

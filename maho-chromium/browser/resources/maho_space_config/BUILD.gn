import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")
import("//maho/build/templates/tailwind_css.gni")

assert(!is_android)

tailwind_css("build_tailwind") {
  input = "react/theme/app.css"
  output = "$target_gen_dir/app.generated.css"
  sources = [
    "../maho_common/react/theme/tokens.css",
    "../maho_common/react/ui/alert.tsx",
    "../maho_common/react/ui/badge.tsx",
    "../maho_common/react/ui/button.tsx",
    "../maho_common/react/ui/card.tsx",
    "../maho_common/react/ui/checkbox.tsx",
    "../maho_common/react/ui/context-menu.tsx",
    "../maho_common/react/ui/dialog.tsx",
    "../maho_common/react/ui/dropdown-menu.tsx",
    "../maho_common/react/ui/input.tsx",
    "../maho_common/react/ui/popover.tsx",
    "../maho_common/react/ui/select.tsx",
    "../maho_common/react/ui/separator.tsx",
    "../maho_common/react/ui/skeleton.tsx",
    "../maho_common/react/ui/slider.tsx",
    "../maho_common/react/ui/sonner.tsx",
    "../maho_common/react/ui/switch.tsx",
    "../maho_common/react/ui/tabs.tsx",
    "../maho_common/react/ui/textarea.tsx",
    "../maho_common/react/ui/toggle-group.tsx",
    "../maho_common/react/ui/tooltip.tsx",
    "react/app.tsx",
    "react/theme/app.css",
  ]
}

action("bundle_react") {
  script = "//third_party/node/node.py"
  inputs = [
    "//third_party/node/node.py",
    "maho_space_config.mojom-webui.js.d.ts",
    "bundle_react.mjs",
    "react/app.tsx",
    "react/emoji_data.ts",
    "react/tsconfig.json",
    "../maho_common/react/bundle_guard.mjs",
  ]
  outputs = [ "$target_gen_dir/app_bundle.js" ]
  args = [
    rebase_path("//maho/browser/resources/maho_space_config/bundle_react.mjs",
                root_build_dir),
    rebase_path(".", root_build_dir),
    rebase_path("$target_gen_dir/app_bundle.js", root_build_dir),
  ]
}

generate_grd("bundle_grdp") {
  grd_prefix = "maho_space_config_bundle"
  out_grd = "$target_gen_dir/maho_space_config_bundle.grdp"
  input_files = [
    "app_bundle.js",
    "app.generated.css",
  ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [
    ":bundle_react",
    ":build_tailwind",
  ]
}

build_webui("build") {
  grd_prefix = "maho_space_config"

  static_files = [ "space_config.html" ]

  ts_files = [ "mojo.ts" ]

  ts_deps = [
    "//maho/browser/resources/maho_common:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_space_config:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_space_config/maho_space_config.mojom-webui.ts" ]

  extra_grdp_deps = [ ":bundle_grdp" ]
  extra_grdp_files = [ "$target_gen_dir/maho_space_config_bundle.grdp" ]
}

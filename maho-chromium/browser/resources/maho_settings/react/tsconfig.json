{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "typeRoots": [
      "../../../../../website/node_modules/@types"
    ],
    "paths": {
      "@radix-ui/react-tooltip": [
        "../../../../../website/node_modules/@radix-ui/react-tooltip/dist/index.d.ts"
      ],
      "react": [
        "../../../../../website/node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../../../../../website/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom/client": [
        "../../../../../website/node_modules/@types/react-dom/client.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../*.ts",
    "../*.d.ts",
    "../schema/**/*.ts",
    "../../maho_common/react/**/*.ts",
    "../../maho_common/react/**/*.tsx",
    "../../maho_common/chrome_resources.d.ts"
  ]
}

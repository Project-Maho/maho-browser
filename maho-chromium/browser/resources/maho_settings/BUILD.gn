import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

assert(!is_android)

action("bundle_react") {
  script = "//third_party/node/node.py"
  inputs = [
    "//third_party/node/node.py",
    "maho_settings.mojom-webui.js.d.ts",
    "app.ts",
    "mojo.ts",
    "models.ts",
    "schema/domains.ts",
    "schema/panes.ts",
    "schema/setting_schema.ts",
    "react/app.tsx",
    "react/domain_panes.tsx",
    "react/store.ts",
    "react/tsconfig.json",
    "bundle_react.mjs",
    "../maho_common/react/bundle_guard.mjs",
    "../maho_common/react/store_utils.ts",
    "../maho_common/react/use_mojo.ts",
    "../maho_common/react/primitives/button.tsx",
    "../maho_common/react/primitives/index.ts",
    "../maho_common/react/primitives/join_class_names.ts",
    "../maho_common/react/primitives/text_area.tsx",
    "../maho_common/react/primitives/text_input.tsx",
    "../maho_common/react/primitives/tooltip_provider.tsx",
  ]
  outputs = [ "$target_gen_dir/app_bundle.js" ]
  args = [
    rebase_path("//maho/browser/resources/maho_settings/bundle_react.mjs",
                root_build_dir),
    rebase_path(".", root_build_dir),
    rebase_path("$target_gen_dir/app_bundle.js", root_build_dir),
  ]
}

generate_grd("bundle_grdp") {
  grd_prefix = "maho_settings_bundle"
  out_grd = "$target_gen_dir/maho_settings_bundle.grdp"
  input_files = [ "app_bundle.js" ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [ ":bundle_react" ]
}

build_webui("build") {
  grd_prefix = "maho_settings"

  static_files = [
    "settings.html",
    "settings.css",
  ]

  ts_files = [
    "app.ts",
    "mojo.ts",
    "models.ts",
    "schema/domains.ts",
    "schema/panes.ts",
    "schema/setting_schema.ts",
  ]

  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_settings:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_settings/maho_settings.mojom-webui.ts" ]

  extra_grdp_deps = [ ":bundle_grdp" ]
  extra_grdp_files = [ "$target_gen_dir/maho_settings_bundle.grdp" ]
}

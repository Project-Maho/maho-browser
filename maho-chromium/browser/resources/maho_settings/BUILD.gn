generate_grd("bundle_grdp") {
  grd_prefix = "maho_settings_bundle"
  out_grd = "$target_gen_dir/maho_settings_bundle.grdp"
  input_files = [
    "app_bundle.js",
    "app.generated.css",
  ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [
    ":bundle_react",
    ":build_tailwind",
  ]
}

build_webui("build") {
  grd_prefix = "maho_settings"

  static_files = [
    "settings.html",
    "icons/arrow-right.svg",
    "icons/arrow-up-right.svg",
    "icons/chevron-down.svg",
    "icons/x.svg",
  ]

  ts_files = [
    "mojo.ts",
    "models.ts",
    "schema/domains.ts",
    "schema/panes.ts",
    "schema/setting_schema.ts",
  ]

  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_settings:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_settings/maho_settings.mojom-webui.ts" ]

  extra_grdp_deps = [ ":bundle_grdp" ]
  extra_grdp_files = [ "$target_gen_dir/maho_settings_bundle.grdp" ]
}

import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

assert(!is_android)

action("bundle_react") {
  script = "//third_party/node/node.py"
  inputs = [
    "//third_party/node/node.py",
    "../maho_common/react/store_utils.ts",
    "maho_welcome.mojom-webui.js.d.ts",
    "react/app.tsx",
    "react/pages/welcome-splash.tsx",
    "react/pages/import-data.tsx",
    "react/pages/search-engine.tsx",
    "react/pages/essentials.tsx",
    "react/pages/space-theme.tsx",
    "react/pages/completion.tsx",
    "react/store.ts",
    "react/tsconfig.json",
    "react/types.ts",
    "bundle_react.mjs",
  ]
  outputs = [ "$target_gen_dir/app_bundle.js" ]
  args = [
    rebase_path("//maho/browser/resources/maho_welcome/bundle_react.mjs", root_build_dir),
    rebase_path(".", root_build_dir),
    rebase_path("$target_gen_dir/app_bundle.js", root_build_dir),
  ]
}

generate_grd("bundle_grdp") {
  grd_prefix = "maho_welcome_bundle"
  out_grd = "$target_gen_dir/maho_welcome_bundle.grdp"
  input_files = [ "app_bundle.js" ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [ ":bundle_react" ]
}

build_webui("build") {
  grd_prefix = "maho_welcome"

  static_files = [
    "welcome.html",
    "welcome.css",
    "icons/essentials/obsidian.svg",
    "icons/essentials/discord.svg",
    "icons/essentials/trello.svg",
    "icons/essentials/slack.svg",
    "icons/essentials/github.svg",
    "icons/essentials/tuta.svg",
    "icons/essentials/notion.svg",
    "icons/essentials/calendar.svg",
    "icons/essentials/figma.svg",
    "icons/search-engines/google.svg",
    "icons/search-engines/bing.svg",
    "icons/search-engines/naver.svg",
    "icons/search-engines/daum.svg",
    "icons/search-engines/coccoc.svg",
    "icons/onboarding/globe.svg",
  ]

  ts_files = [ "app.ts" ]

  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_welcome:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_welcome/maho_welcome.mojom-webui.ts" ]

  extra_grdp_deps = [ ":bundle_grdp" ]
  extra_grdp_files = [ "$target_gen_dir/maho_welcome_bundle.grdp" ]
}

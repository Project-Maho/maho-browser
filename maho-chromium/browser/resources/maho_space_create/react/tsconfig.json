{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "typeRoots": [
      "../../../../../website/node_modules/@types"
    ],
    "paths": {
      "react": [
        "../../../../../website/node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../../../../../website/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom/client": [
        "../../../../../website/node_modules/@types/react-dom/client.d.ts"
      ],
      "class-variance-authority": [
        "../../../../../website/node_modules/class-variance-authority/dist/index.d.ts"
      ],
      "clsx": [
        "../../../../../website/node_modules/clsx/clsx.d.ts"
      ],
      "@radix-ui/react-slot": [
        "../../../../../website/node_modules/@radix-ui/react-slot/dist/index.d.ts"
      ],
      "@radix-ui/react-toggle-group": [
        "../../../../../website/node_modules/@radix-ui/react-toggle-group/dist/index.d.ts"
      ],
      "@radix-ui/react-separator": [
        "../../../../../website/node_modules/@radix-ui/react-separator/dist/index.d.ts"
      ],
      "@radix-ui/react-tooltip": [
        "../../../../../website/node_modules/@radix-ui/react-tooltip/dist/index.d.ts"
      ],
      "tailwind-merge": [
        "../../../../../website/node_modules/tailwind-merge/dist/types.d.ts"
      ],
      "@lib/*": [
        "../../maho_common/react/lib/*"
      ],
      "@ui/*": [
        "../../maho_common/react/ui/*"
      ],
      "@theme/*": [
        "../../maho_common/react/theme/*"
      ],
      "//resources/maho_common/*": [
        "../../maho_common/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../*.d.ts",
    "../../maho_common/chrome_resources.d.ts"
  ]
}

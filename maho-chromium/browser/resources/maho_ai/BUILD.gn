import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "maho_ai"

  static_files = [
    "maho_ai.html",
    "maho_ai.css",
  ]

  ts_files = [
    "app.ts",
    "store.ts",
    "types.ts",
    "views/cards.ts",
    "views/composer.ts",
    "views/console_shell.ts",
    "views/inspector.ts",
    "views/left_rail.ts",
    "views/timeline.ts",
  ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_ai:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_ai/maho_ai.mojom-webui.ts" ]
}

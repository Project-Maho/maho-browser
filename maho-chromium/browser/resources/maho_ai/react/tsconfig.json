{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "typeRoots": [
      "../../../../../website/node_modules/@types"
    ],
    "paths": {
      "react": [
        "../../../../../website/node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../../../../../website/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom/client": [
        "../../../../../website/node_modules/@types/react-dom/client.d.ts"
      ],
      "class-variance-authority": [
        "../../../../../website/node_modules/class-variance-authority/dist/index.d.ts"
      ],
      "clsx": [
        "../../../../../website/node_modules/clsx/clsx.d.ts"
      ],
      "@radix-ui/react-popover": [
        "../../../../../website/node_modules/@radix-ui/react-popover/dist/index.d.ts"
      ],
      "@radix-ui/react-slot": [
        "../../../../../website/node_modules/@radix-ui/react-slot/dist/index.d.ts"
      ],
      "@radix-ui/react-dropdown-menu": [
        "../../../../../website/node_modules/@radix-ui/react-dropdown-menu/dist/index.d.ts"
      ],
      "@features/*": [
        "./features/*"
      ],
      "@hooks/*": [
        "./hooks/*"
      ],
      "@lib/*": [
        "./lib/*"
      ],
      "@ui/*": [
        "./ui/*"
      ],
      "//resources/maho_common/*": [
        "../../maho_common/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../app.ts",
    "../store.ts",
    "../types.ts",
    "../views/cards.ts",
    "../views/conversation_thread.ts",
    "../views/icons.ts",
    "../styles/*.css",
    "../maho_ai.mojom-webui.js.d.ts",
    "../../maho_common/chrome_resources.d.ts"
  ]
}

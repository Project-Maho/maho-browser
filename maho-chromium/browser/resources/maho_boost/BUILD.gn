import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/generate_grd.gni")
import("//maho/build/templates/tailwind_css.gni")

assert(!is_android)

tailwind_css("build_tailwind") {
  input = "react/theme/app.css"
  output = "$target_gen_dir/app.generated.css"
  sources = [
    "../maho_common/react/icons/lucide.ts",
    "../maho_common/react/lib/utils.ts",
    "../maho_common/react/theme/apply_theme.ts",
    "../maho_common/react/theme/tokens.css",
    "../maho_common/react/ui/alert.tsx",
    "../maho_common/react/ui/button.tsx",
    "../maho_common/react/ui/dropdown-menu.tsx",
    "../maho_common/react/ui/input.tsx",
    "../maho_common/react/ui/label.tsx",
    "../maho_common/react/ui/select.tsx",
    "../maho_common/react/ui/separator.tsx",
    "../maho_common/react/ui/slider.tsx",
    "../maho_common/react/ui/sonner.tsx",
    "../maho_common/react/ui/toggle-group.tsx",
    "react/app.tsx",
    "react/boost-bridge.ts",
    "react/boost-mode-values.ts",
    "react/boost-state.ts",
    "react/components/advanced-color-popover.tsx",
    "react/components/boost-editor-route.tsx",
    "react/components/code-route.tsx",
    "react/components/color-section.tsx",
    "react/components/status-feedback.tsx",
    "react/components/title-strip.tsx",
    "react/components/typography-section.tsx",
    "react/components/zap-section.tsx",
    "react/theme/app.css",
    "react/use-boost-controller.ts",
    "react/use-boost-actions.ts",
    "react/use-close-lifecycle.ts",
    "react/use-codemirror.ts",
    "react/use-color-wheel.ts",
    "react/use-debounced-boost-updates.ts",
  ]
}

action("bundle_codemirror") {
  script = "//third_party/node/node.py"
  inputs = [
    "//third_party/node/node.py",
    "bundle_codemirror.mjs",
    "codemirror_entry.ts",
  ]
  outputs = [ "$target_gen_dir/codemirror.bundle.js" ]
  args = [
    rebase_path("//maho/browser/resources/maho_boost/bundle_codemirror.mjs",
                root_build_dir),
    rebase_path(".", root_build_dir),
    rebase_path("$target_gen_dir/codemirror.bundle.js", root_build_dir),
  ]
}

generate_grd("codemirror_grdp") {
  grd_prefix = "maho_boost_codemirror"
  out_grd = "$target_gen_dir/maho_boost_codemirror.grdp"
  input_files = [ "codemirror.bundle.js" ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [ ":bundle_codemirror" ]
}

action("bundle_react") {
  script = "//third_party/node/node.py"
  inputs = [
    "//third_party/node/node.py",
    "../maho_common/react/bundle_guard.mjs",
    "../maho_common/chrome_resources.d.ts",
    "../maho_common/react/icons/lucide.ts",
    "../maho_common/react/lib/utils.ts",
    "../maho_common/react/theme/apply_theme.ts",
    "../maho_common/react/ui/alert.tsx",
    "../maho_common/react/ui/button.tsx",
    "../maho_common/react/ui/dropdown-menu.tsx",
    "../maho_common/react/ui/input.tsx",
    "../maho_common/react/ui/label.tsx",
    "../maho_common/react/ui/select.tsx",
    "../maho_common/react/ui/separator.tsx",
    "../maho_common/react/ui/slider.tsx",
    "../maho_common/react/ui/sonner.tsx",
    "../maho_common/react/ui/toggle-group.tsx",
    "maho_boost.mojom-webui.js.d.ts",
    "bundle_react.mjs",
    "react/app.tsx",
    "react/boost-bridge.ts",
    "react/boost-lifecycle.ts",
    "react/boost-mode-values.ts",
    "react/boost-state.ts",
    "react/components/advanced-color-popover.tsx",
    "react/components/boost-editor-route.tsx",
    "react/components/code-route.tsx",
    "react/components/color-section.tsx",
    "react/components/status-feedback.tsx",
    "react/components/title-strip.tsx",
    "react/components/typography-section.tsx",
    "react/components/zap-section.tsx",
    "react/mojo-runtime.d.ts",
    "react/mojo-runtime.js",
    "react/tsconfig.json",
    "react/use-boost-bridge.ts",
    "react/use-boost-controller.ts",
    "react/use-boost-mutation-queue.ts",
    "react/use-boost-terminal-actions.ts",
    "react/use-boost-actions.ts",
    "react/use-close-lifecycle.ts",
    "react/use-codemirror.ts",
    "react/use-color-wheel.ts",
    "react/use-debounced-boost-updates.ts",
  ]
  outputs = [ "$target_gen_dir/app_bundle.js" ]
  args = [
    rebase_path("//maho/browser/resources/maho_boost/bundle_react.mjs",
                root_build_dir),
    rebase_path(".", root_build_dir),
    rebase_path("$target_gen_dir/app_bundle.js", root_build_dir),
  ]
}

generate_grd("bundle_grdp") {
  grd_prefix = "maho_boost_bundle"
  out_grd = "$target_gen_dir/maho_boost_bundle.grdp"
  input_files = [
    "app_bundle.js",
    "app.generated.css",
  ]
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  deps = [
    ":bundle_react",
    ":build_tailwind",
  ]
}

build_webui("build") {
  grd_prefix = "maho_boost"

  static_files = [
    "boost.html",
    "boost.css",
    "icons/arrow-down.svg",
    "icons/back.svg",
    "icons/close.svg",
    "icons/code.svg",
    "icons/controls.svg",
    "icons/disable.svg",
    "icons/inspector.svg",
    "icons/invert.svg",
    "icons/magic.svg",
    "icons/picker.svg",
    "icons/shuffle.svg",
    "icons/zap.svg",
    "zen-advanced-color-options.css",
  ]

  ts_files = [ "app.ts" ]

  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]

  webui_context_type = "untrusted"

  mojo_files_deps =
      [ "//maho/browser/ui/webui/maho_boost:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/maho/browser/ui/webui/maho_boost/maho_boost.mojom-webui.ts" ]

  extra_grdp_deps = [
    ":codemirror_grdp",
    ":bundle_grdp",
  ]
  extra_grdp_files = [
    "$target_gen_dir/maho_boost_codemirror.grdp",
    "$target_gen_dir/maho_boost_bundle.grdp",
  ]
}

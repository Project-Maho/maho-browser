import("//build/config/features.gni")
import("//testing/test.gni")

source_set("maho_mcp") {
  sources = [
    "maho_mcp_accessibility_handler.cc",
    "maho_mcp_accessibility_handler.h",
    "maho_mcp_firewall.cc",
    "maho_mcp_firewall.h",
    "maho_mcp_json_rpc.cc",
    "maho_mcp_json_rpc.h",
    "maho_mcp_lease_registry.cc",
    "maho_mcp_lease_registry.h",
    "maho_mcp_session.cc",
    "maho_mcp_session.h",
  ]

  if (!is_win) {
    sources += [
      "maho_mcp_socket_server.cc",
      "maho_mcp_socket_server.h",
    ]
  }

  if (is_win) {
    sources += [
      "maho_mcp_pipe_server_win.cc",
      "maho_mcp_pipe_server_win.h",
      "maho_mcp_session_token_win.cc",
      "maho_mcp_session_token_win.h",
    ]
  }

  deps = [
    "//base",
    "//crypto",
    "//net",
    "//third_party/re2",
    "//ui/accessibility",
    "//url",
  ]

  if (is_win) {
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "crypt32.lib",
      "userenv.lib",
    ]
  }
}

source_set("unittests") {
  testonly = true

  sources = [
    "maho_mcp_accessibility_handler_unittest.cc",
    "maho_mcp_firewall_unittest.cc",
    "maho_mcp_json_rpc_unittest.cc",
    "maho_mcp_lease_registry_unittest.cc",
    "maho_mcp_session_unittest.cc",
  ]

  if (!is_win) {
    sources += [ "maho_mcp_socket_server_unittest.cc" ]
  }

  if (is_win) {
    sources += [
      "maho_mcp_pipe_server_win_unittest.cc",
      "maho_mcp_session_token_win_unittest.cc",
    ]
  }

  deps = [
    ":maho_mcp",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//net",
    "//net:test_support",
    "//testing/gtest",
    "//ui/accessibility",
  ]
}

test("maho_mcp_firewall_test") {
  sources = [
    "maho_mcp_firewall_test_main.cc",
    "maho_mcp_firewall_unittest.cc",
  ]
  deps = [
    ":maho_mcp",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

test("maho_mcp_session_test") {
  sources = [
    "maho_mcp_firewall_test_main.cc",
    "maho_mcp_session_unittest.cc",
  ]
  deps = [
    ":maho_mcp",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

test("maho_mcp_lease_registry_test") {
  sources = [
    "maho_mcp_firewall_test_main.cc",
    "maho_mcp_lease_registry_unittest.cc",
  ]
  deps = [
    ":maho_mcp",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

test("maho_mcp_accessibility_handler_test") {
  sources = [
    "maho_mcp_accessibility_handler_unittest.cc",
    "maho_mcp_firewall_test_main.cc",
  ]
  deps = [
    ":maho_mcp",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/accessibility",
  ]
}

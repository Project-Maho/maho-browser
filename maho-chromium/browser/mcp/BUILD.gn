# POSIX-only: the UDS socket server (and its unittest) only compile on
# non-Windows. Uses content test support because the server posts ProcessData
# to content::GetUIThreadTaskRunner and the transport tests drive the real
# deferred-response path with a content::BrowserTaskEnvironment{IO_MAINLOOP}.
if (!is_win) {
  test("maho_mcp_socket_server_test") {
    sources = [ "maho_mcp_socket_server_unittest.cc" ]
    deps = [
      ":maho_mcp",
      "//base",
      "//base/test:test_support",
      "//content/public/browser",
      "//content/test:run_all_unittests",
      "//content/test:test_support",
      "//net",
      "//net:test_support",
      "//testing/gtest",
      "//ui/accessibility",
      "//url",
    ]
  }

  # R-8: private-context isolation browser tests. POSIX-only, matching the
  # same-UID Unix-domain-socket MCP transport premise.
  source_set("browser_tests") {
    testonly = true
    sources = [ "maho_mcp_incognito_browser_test.cc" ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    deps = [
      ":maho_mcp",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/sessions",
      "//content/public/browser",
      "//content/test:test_support",
       "//testing/gtest",
       "//url",
     ]
   }
 }

if (is_win) {
  # R-8 browser_tests are POSIX-only (Unix-domain-socket MCP transport premise).
  # Provide an empty target on Windows so cross-platform references in
  # //chrome/test:browser_tests resolve without pulling in POSIX-only tests.
  group("browser_tests") {
    testonly = true
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "maho_ctrl_tab_switcher_controller_unittest.cc",
    "maho_mru_tab_tracker_unittest.cc",
  ]

  deps = [
    ":maho_ctrl_tab_prefs",
    ":maho_mru_tab_tracker",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//components/prefs",
    "//components/prefs:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

# Minimal test target that avoids the chrome/browser/ui dep chain so it can
# be built even when unrelated targets in that tree have unrelated compile
# errors.  Contains only the pref-registration test.
source_set("pref_unit_tests") {
  testonly = true

  sources = [ "maho_ctrl_tab_switcher_controller_unittest.cc" ]

  deps = [
    ":maho_ctrl_tab_prefs",
    "//base",
    "//components/prefs",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}

import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "maho_notes.mojom" ]
  webui_module_path = "/"
}

source_set("maho_notes") {
  sources = [
    "maho_notes_page_handler.cc",
    "maho_notes_page_handler.h",
    "maho_notes_ui.cc",
    "maho_notes_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//maho/browser/resources/maho_notes:resources",
    "//maho/components/constants",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//url",
  ]
}

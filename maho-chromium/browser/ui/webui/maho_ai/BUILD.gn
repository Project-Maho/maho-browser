import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "maho_ai.mojom" ]
  webui_module_path = "/"
}

source_set("maho_ai_prefs") {
  sources = [
    "maho_ai_prefs_registration.cc",
    "maho_ai_prefs_registration.h",
  ]

  public_deps = [
    "//components/prefs",
  ]

  deps = [
    "//base",
  ]
}

source_set("maho_ai") {
  sources = [
    "maho_ai_page_handler.cc",
    "maho_ai_page_handler.h",
    "maho_ai_ui.cc",
    "maho_ai_ui.h",
    "maho_ai_voice_session.cc",
    "maho_ai_voice_session.h",
  ]

  public_deps = [
    ":maho_ai_prefs",
    ":mojo_bindings",
    "//base",
    "//components/prefs",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//crypto",
    "//maho/browser:maho_ai_popup_lifetime_tracker",
    "//maho/browser:maho_ai_runtime_adapter",
    "//maho/browser:maho_browser_ai_tools",
    "//maho/browser:maho_auth_utils",
    "//maho/browser:maho_core_holder",
    "//maho/browser/resources/maho_ai:resources",
    "//maho/components/constants",
    "//maho/third_party/maho:maho_bridge",
    "//maho/third_party/maho:maho_stt_ffi",
    "//mojo/public/cpp/bindings",
    "//net",
    "//ui/webui",
    "//url",
  ]
}

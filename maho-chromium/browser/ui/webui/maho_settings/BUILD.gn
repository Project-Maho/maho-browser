import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "maho_settings.mojom" ]
  webui_module_path = "/"
}

source_set("maho_settings") {
  sources = [
    "maho_settings_page_handler.cc",
    "maho_settings_page_handler.h",
    "maho_settings_ui.cc",
    "maho_settings_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
  ]

  deps = [
    "//maho/browser:maho_extension_state_bridge",
    "//maho/browser:maho_password_provider",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//components/content_settings/core/browser",
    "//components/prefs",
    "//components/safe_browsing/core/common",
    "//extensions/browser",
    "//maho/browser:maho_core_holder",
    "//maho/browser/resources/maho_settings:resources",
    "//maho/components/constants",
    "//maho/third_party/maho:maho_core_prebuilt",
    "//maho/third_party/maho:maho_ffi_headers",
    "//mojo/public/cpp/bindings",
    "//services/network/public/mojom",
    "//ui/webui",
    "//url",
  ]
}

import("//mojo/public/tools/bindings/mojom.gni")
import("//testing/test.gni")

mojom("mojo_bindings") {
  sources = [ "maho_mail.mojom" ]
  webui_module_path = "/"
}

source_set("maho_mail") {
  sources = [
    "maho_mail_attachment_launcher.h",
    "maho_mail_ui.cc",
    "maho_mail_ui.h",
    "maho_mail_backend_boundary.cc",
    "maho_mail_backend_boundary.h",
    "maho_mail_page_handler.cc",
    "maho_mail_page_handler.h",
    "maho_mail_oauth_session.cc",
    "maho_mail_oauth_session.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/webui/sanitized_image:sanitized_image_source",
    "//maho/browser/mail_helper:maho_mail_service",
    "//maho/browser/mail_helper:maho_mail_service_factory",
    "//maho/browser/resources/maho_mail:resources",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//url",
  ]

  if (is_mac) {
    sources += [ "maho_mail_attachment_launcher_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  } else if (is_linux) {
    sources += [ "maho_mail_attachment_launcher_linux.cc" ]
    deps += [
      "//components/dbus",
      "//dbus",
    ]
  } else if (is_win) {
    sources += [ "maho_mail_attachment_launcher_win.cc" ]
  }
}

test("maho_mail_page_handler_test") {
  sources = [
    "maho_mail_backend_boundary_test_main.cc",
    "maho_mail_backend_boundary_unittest.cc",
  ]
  deps = [
    ":maho_mail",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

test("maho_mail_oauth_session_test") {
  sources = [
    "maho_mail_oauth_session_unittest.cc",
    "maho_mail_oauth_session.cc",
    "maho_mail_oauth_session.h",
    "maho_mail_oauth_session_test_main.cc",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//mojo/core/embedder",
    "//url",
  ]
}

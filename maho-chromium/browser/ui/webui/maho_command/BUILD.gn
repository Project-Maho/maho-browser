import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "maho_command.mojom" ]
  webui_module_path = "/"
}

source_set("maho_command") {
  sources = [
    "maho_command_page_handler.cc",
    "maho_command_page_handler.h",
    "maho_command_ui.cc",
    "maho_command_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/tabs:tab_strip",
    "//maho/browser:maho_core_holder",
    "//maho/browser/resources/maho_command:resources",
    "//maho/components/constants",
    "//maho/third_party/maho:maho_core_prebuilt",
    "//maho/third_party/maho:maho_ffi_headers",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//url",
  ]
}

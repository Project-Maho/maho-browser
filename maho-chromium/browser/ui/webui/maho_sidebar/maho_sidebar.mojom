module maho_sidebar.mojom;

struct SpaceInfo {
  string id;
  string name;
  string color;          // hex color like "#e94560" — also sidebar theme tint
  string icon;           // emoji string (e.g. "🏠", "💼"), empty = first letter
  bool active;
  int32 tab_count;
  string profile_id;     // associated profile id ("default" if unset)
  string? last_active_tab_id;
  int32 position;        // display order index
};

struct TabInfo {
  int32 tab_id;
  string title;
  string url;
  bool active;
  int32 index;
  string section;
};

struct ProfileInfo {
  string id;
  string name;
  bool is_default;
  array<string> space_ids;
};

struct ATCRule {
  string id;
  string url_pattern;      // glob or regex
  string target_space_id;
  bool enabled;
};

// Used by the WebUI page to bootstrap bidirectional communication.
interface PageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Browser-side handler for requests from WebUI page.
interface PageHandler {
  // Returns the list of tabs in the current browser window.
  GetTabs() => (array<TabInfo> tabs);

  // Activates (switches to) the tab with the given ID.
  ActivateTab(int32 tab_id);

  // Closes the tab with the given ID.
  CloseTab(int32 tab_id);

  // Returns the list of spaces.
  GetSpaces() => (array<SpaceInfo> spaces);

  // Activates (switches to) the space with the given ID.
  ActivateSpace(string space_id);

  // Creates a new space with the given properties.
  // insert_after_index: position to insert (-1 = append at end).
  CreateSpace(string name, string color, string icon,
              string? profile_id, int32 insert_after_index);

  // Deletes the space with the given ID.
  DeleteSpace(string space_id);

  // Renames the space.
  RenameSpace(string space_id, string new_name);

  // Changes the space theme color.
  RecolorSpace(string space_id, string new_color);

  // Updates the full space theme (solid or gradient).
  UpdateSpaceTheme(string space_id, string theme_json);

  // Changes the space icon (emoji).
  ChangeSpaceIcon(string space_id, string new_icon);

  // Moves the space to a new position.
  ReorderSpace(string space_id, int32 new_index);

  // Returns the list of profiles.
  GetProfiles() => (array<ProfileInfo> profiles);

  // Assigns a profile to a space.
  AssignProfileToSpace(string space_id, string profile_id);

  // ATC rule CRUD.
  GetATCRules() => (array<ATCRule> rules);
  AddATCRule(string url_pattern, string target_space_id) => (ATCRule rule);
  RemoveATCRule(string rule_id);
  ToggleATCRule(string rule_id, bool enabled);

  // Moves a tab to another space.
  // section: "pinned" or "today".
  MoveTabToSpace(int32 tab_id, string target_space_id, string section);

  // Fetches the community theme store manifest.
  // Returns raw JSON matching ThemeStoreManifest { version, themes[] }.
  FetchThemeStore() => (string manifest_json);
};

// WebUI-side interface for browser-to-page push updates.
interface Page {
  // Called when the tab list changes.
  TabsChanged(array<TabInfo> tabs);

  // Called when the spaces list changes.
  SpacesChanged(array<SpaceInfo> spaces);

  // Called when the active space theme color should change.
  SpaceThemeChanged(string space_id, string color);

  ProfilesChanged(array<ProfileInfo> profiles);
  ATCRulesChanged(array<ATCRule> rules);
};

import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "maho_sidebar.mojom" ]
  webui_module_path = "/"
}

source_set("maho_sidebar") {
  sources = [
    "maho_sidebar_page_handler.cc",
    "maho_sidebar_page_handler.h",
    "maho_sidebar_ui.cc",
    "maho_sidebar_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/tabs:tab_strip",
    "//maho/browser:maho_theme_support",
    "//maho/browser/resources/maho_sidebar:resources",
    "//maho/components/constants",
    "//mojo/public/cpp/bindings",
    "//ui/shell_dialogs",
    "//ui/webui",
    "//url",
  ]
}

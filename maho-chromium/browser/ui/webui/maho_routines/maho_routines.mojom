module maho_routines.mojom;

struct RoutineInfo {
  string id;
  string name;
  string cron;
  string description;
};

struct RoutineRunResult {
  string id;
  int64 ran_at;
  string content;
  bool success;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

interface PageHandler {
  ListRoutines() => (array<RoutineInfo> routines);
  RunRoutine(string id) => (RoutineRunResult? result, string? error);
  GetUserTier() => (int32 tier);
};

interface Page {
  OnRoutineComplete(RoutineRunResult result);
  OnRoutineError(string id, string error);
};

module maho_routines.mojom;

struct RoutineInfo {
  string id;
  string name;
  string cron;
  string description;
  // True for user-defined custom routines (deletable). False for built-ins.
  bool is_custom;
  // Cron schedule string, when this routine is cron-triggered.
  string? schedule;
  // Event trigger string (e.g. "on_startup" / "on_many_tabs:20"), when
  // this routine is event-triggered.
  string? trigger;
  // Whether the routine is enabled (built-ins are always enabled).
  bool enabled;
};

struct RoutineRunResult {
  string id;
  int64 ran_at;
  string content;
  bool success;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

interface PageHandler {
  ListRoutines() => (array<RoutineInfo> routines);
  // Returns ALL routines (built-in + user-defined custom).
  ListAllRoutines() => (array<RoutineInfo> routines);
  // Create a user-defined routine. Exactly one of `schedule` (cron) or
  // `trigger` (event) should be supplied; both null = manual-run only.
  CreateRoutine(string name, string prompt,
                string? schedule, string? trigger) => (bool ok);
  // Delete a user-defined routine by id.
  DeleteRoutine(string id) => (bool ok);
  RunRoutine(string id) => (RoutineRunResult? result, string? error);
  GetUserTier() => (int32 tier);
};

interface Page {
  OnRoutineComplete(RoutineRunResult result);
  OnRoutineError(string id, string error);
};

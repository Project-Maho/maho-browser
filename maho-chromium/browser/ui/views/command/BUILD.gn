import("//testing/test.gni")

source_set("maho_command_overlay") {
  sources = [
    "maho_command_action_handler.cc",
    "maho_command_action_handler.h",
    "maho_mail_command_catalog.h",
    "maho_command_model.cc",
    "maho_command_model.h",
    "maho_remote_search_suggestions.cc",
    "maho_remote_search_suggestions.h",
    "maho_command_sparkle_geometry.h",
    "maho_command_overlay_controller.cc",
    "maho_command_overlay_controller.h",
    "maho_command_overlay_view.cc",
    "maho_command_overlay_view.h",
    "maho_command_result_row_view.cc",
    "maho_command_result_row_view.h",
    "maho_command_search_engine_picker_view.cc",
    "maho_command_search_engine_picker_view.h",
    "maho_shortcut_interceptor.cc",
    "maho_shortcut_interceptor.h",
    "maho_command_overlay_vibrancy.h",
    "maho_command_action_selector_view.cc",
    "maho_command_action_selector_view.h",
  ]

  if (is_mac) {
    sources += [ "maho_command_overlay_vibrancy_mac.mm" ]
  } else if (is_win) {
    sources += [ "maho_command_overlay_vibrancy_win.cc" ]
  } else {
    sources += [ "maho_command_overlay_vibrancy_stub.cc" ]
  }

  deps = [
    "//cc/paint",
    "//base",
    "//chrome/browser/favicon",
    "//chrome/browser/autocomplete",
    "//chrome/browser/devtools",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui:browser_navigator_params_headers",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/search_engines",
    "//components/omnibox/browser",
    "//content/public/browser",
    "//maho/browser:maho_core_holder",
    "//maho/browser:maho_tab_id_helper",
    # maho::ShowLinkCopiedToast (shared link-copied toast) lives in the
    # notification overlay source set; maho_command_action_handler.cc calls it.
    "//maho/browser:maho_theme_support",
    "//maho/browser/ui/views/sidebar:maho_sidebar_prefs",
    # maho_mini dep intentionally omitted: adding it creates a dependency
    # cycle (command → maho_mini → chrome/browser/ui → command, because
    # maho_mini depends on //chrome/browser:browser + //chrome/browser/ui).
    # The header is included with // nogncheck in maho_command_action_handler.cc
    # and the symbols resolve at final link into //chrome/browser:browser.
    # Same pattern as split_view below and the browser.h nogncheck include.
    # "//maho/browser:maho_mini",
    # split_view dep intentionally omitted: adding it creates a dependency
    # cycle (command → split_view → chrome/browser/ui → command). The header
    # is reachable through transitive deps. Track cleanup in the split_view
    # target itself (break its dep on //chrome/browser/ui).
    # "//maho/browser/ui/views/split_view:maho_split_view",
    "//maho/components/constants",
    "//maho/third_party/maho:maho_ffi_headers",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "maho_command_action_handler_unittest.cc",
    "maho_command_model_unittest.cc",
    "maho_command_overlay_controller_unittest.cc",
    "maho_command_overlay_view_unittest.cc",
    "maho_command_result_row_view_unittest.cc",
    "maho_remote_search_suggestions_unittest.cc",
    "maho_unified_click_path_behavior_unittest.cc",
    "maho_command_action_selector_view_unittest.cc",
    "maho_shortcut_contract_unittest.cc",
  ]

  deps = [
    ":maho_command_overlay",
    "//base",
    "//base/test:test_support",
    "//maho/browser:maho_core_holder",
    "//maho/browser/ui/views/split_view:maho_split_view",
    "//maho/third_party/maho:maho_ffi_headers",
    "//maho/third_party/maho:maho_core_prebuilt",
    "//testing/gtest",
    "//ui/base",
    "//ui/events",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

# Runnable binary for the command palette unit tests above. The `unit_tests`
# source_set is not linked into any upstream test binary, so without this
# target its tests compile but never run. Same leaf-test pattern as
# //maho/browser:maho_context_menus_test.
test("maho_command_overlay_unittests") {
  sources = [ "//maho/browser/run_all_maho_unittests_main.cc" ]
  deps = [
    ":unit_tests",
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//mojo/core/embedder",
    "//testing/gtest",
    "//ui/views:test_support",
  ]
}

source_set("interactive_tests") {
  testonly = true
  sources = [
    "maho_mini_runtime_proof_uitest.cc",
    "maho_ai_popup_lifetime_interactive_uitest.cc",
    "maho_command_incognito_interactive_uitest.cc",
    # TODO(other-session): re-enable once test-only APIs
    # (Get/IsSeededStateForTesting, InitializeSeededStateForTesting,
    #  GetMaxSeededVisibleResultsForTesting) are restored on
    # MahoCommandOverlayView or the tests are updated.
    # "maho_command_overlay_interactive_uitest.cc",
  ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    ":maho_command_overlay",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//maho/browser:maho_ai_popup_lifetime_tracker",
    "//net:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/base:test_support",
    "//ui/events:events_base",
    "//ui/gfx",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

action("importer_test_gate") {
  script = "test_data/verify_golden.py"
  
  inputs = [
    "test_data/golden_hashes.json",
    "test_data/synthetic/nss_3des_cbc.bin",
    "test_data/synthetic/nss_aes256_cbc_sha256.bin",
    "test_data/synthetic/nss_aes256_cbc_sha384.bin",
    "test_data/synthetic/nss_aes256_gcm.bin",
    "test_data/synthetic/oscrypt_v10.bin",
    "test_data/synthetic/cookie_v10_prefix.bin",
    "test_data/synthetic/cookie_v20_prefix.bin",
  ]
  
  stamp_file = "$target_gen_dir/importer_test_gate.stamp"
  outputs = [ stamp_file ]
  
  args = [
    "--stamp",
    rebase_path(stamp_file, root_build_dir),
    "--synthetic-dir",
    rebase_path("test_data/synthetic", root_build_dir),
    "--hashes-file",
    rebase_path("test_data/golden_hashes.json", root_build_dir),
  ]
}


config("whisper_public_config") {
  include_dirs = [
    "include",
    "ggml/include",
  ]
}

config("whisper_private_config") {
  include_dirs = [
    "src",
    "ggml/src",
    "ggml/src/ggml-cpu",
  ]
  defines = [
    "GGML_COMMIT=\"f049fff95a089aa9969deb009cdd4892b3e74916\"",
    "GGML_VERSION=\"v1.9.1\"",
    "GGML_USE_CPU",
    "GGML_STATIC",
    "WHISPER_VERSION=\"v1.9.1\"",
    "WHISPER_STATIC",
  ]
  cflags = [
    "-Wno-deprecated-declarations",
    "-Wno-shorten-64-to-32",
    "-Wno-sign-compare",
    "-Wno-unsafe-buffer-usage",
    "-Wno-unused-function",
    "-Wno-unused-variable",
  ]
  cflags_cc = [
    "-include",
    "errno.h",
    "-Wno-c++98-compat-extra-semi",
    "-Wno-covered-switch-default",
    "-Wno-implicit-fallthrough",
    "-Wno-missing-field-initializers",
  ]
}

template("whisper_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker, [
                             "deps",
                             "sources",
                             "testonly",
                           ])

    public_configs = [ ":whisper_public_config" ]
    configs += [ ":whisper_private_config" ]

    configs -= [
      "//build/config/compiler:chromium_code",
      "//build/config/compiler:no_exceptions",
    ]
    configs += [
      "//build/config/compiler:no_chromium_code",
      "//build/config/compiler:exceptions",
    ]

    cflags = [
      "-Wno-deprecated-declarations",
      "-Wno-shorten-64-to-32",
      "-Wno-sign-compare",
      "-Wno-unsafe-buffer-usage",
      "-Wno-unused-function",
      "-Wno-unused-variable",
    ]
    cflags_cc = [
      "-Wno-c++98-compat-extra-semi",
      "-Wno-covered-switch-default",
      "-Wno-implicit-fallthrough",
      "-Wno-missing-field-initializers",
    ]
  }
}

whisper_source_set("ggml_c") {
  sources = [
    "ggml/src/ggml-alloc.c",
    "ggml/src/ggml-quants.c",
    "ggml/src/ggml.c",
  ]
}

whisper_source_set("ggml_cpp") {
  sources = [
    "ggml/src/ggml-backend-dl.cpp",
    "ggml/src/ggml-backend-meta.cpp",
    "ggml/src/ggml-backend-reg.cpp",
    "ggml/src/ggml-backend.cpp",
    "ggml/src/ggml-opt.cpp",
    "ggml/src/ggml-threading.cpp",
    "ggml/src/ggml.cpp",
    "ggml/src/gguf.cpp",
  ]
}

whisper_source_set("ggml_cpu_c") {
  sources = [
    "ggml/src/ggml-cpu/ggml-cpu.c",
    "ggml/src/ggml-cpu/quants.c",
  ]
}

whisper_source_set("ggml_cpu_cpp") {
  sources = [
    "ggml/src/ggml-cpu/amx/amx.cpp",
    "ggml/src/ggml-cpu/amx/mmq.cpp",
    "ggml/src/ggml-cpu/binary-ops.cpp",
    "ggml/src/ggml-cpu/ggml-cpu.cpp",
    "ggml/src/ggml-cpu/hbm.cpp",
    "ggml/src/ggml-cpu/ops.cpp",
    "ggml/src/ggml-cpu/repack.cpp",
    "ggml/src/ggml-cpu/traits.cpp",
    "ggml/src/ggml-cpu/unary-ops.cpp",
    "ggml/src/ggml-cpu/vec.cpp",
  ]
}

whisper_source_set("ggml_cpu_arch") {
  sources = []
  if (current_cpu == "arm" || current_cpu == "arm64") {
    sources += [
      "ggml/src/ggml-cpu/arch/arm/quants.c",
      "ggml/src/ggml-cpu/arch/arm/repack.cpp",
    ]
  } else if (current_cpu == "x86" || current_cpu == "x64") {
    sources += [
      "ggml/src/ggml-cpu/arch/x86/quants.c",
      "ggml/src/ggml-cpu/arch/x86/repack.cpp",
    ]
  } else if (current_cpu == "riscv64") {
    sources += [
      "ggml/src/ggml-cpu/arch/riscv/quants.c",
      "ggml/src/ggml-cpu/arch/riscv/repack.cpp",
    ]
  } else if (current_cpu == "ppc64" || current_cpu == "ppc64le") {
    sources += [ "ggml/src/ggml-cpu/arch/powerpc/quants.c" ]
  } else if (current_cpu == "s390x") {
    sources += [ "ggml/src/ggml-cpu/arch/s390/quants.c" ]
  } else if (current_cpu == "loong64") {
    sources += [ "ggml/src/ggml-cpu/arch/loongarch/quants.c" ]
  }
}

static_library("whisper") {
  sources = [ "src/whisper.cpp" ]
  public_configs = [ ":whisper_public_config" ]
  configs += [ ":whisper_private_config" ]

  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_exceptions",
  ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    "//build/config/compiler:exceptions",
  ]

  deps = [
    ":ggml_c",
    ":ggml_cpu_arch",
    ":ggml_cpu_c",
    ":ggml_cpu_cpp",
    ":ggml_cpp",
  ]

  if (is_linux) {
    libs = [ "dl" ]
  }
}

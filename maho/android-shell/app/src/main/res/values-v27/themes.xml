<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ delta over the base Theme.Maho.Browser in values/.
         android:navigationBarDividerColor and android:windowLightNavigationBar were both
         introduced in API 27, so they cannot live in the base configuration at minSdk 26. -->
    <style name="Theme.Maho.Browser" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/shell_window_background</item>
        <item name="android:colorBackground">@color/shell_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>

{
  "manifest_version": 3,
  "name": "Maho Test Extension",
  "version": "1.0.0",
  "description": "A test Chrome extension for validating Maho's ExtensionBridge",
  "action": {
    "default_title": "Maho Test Extension"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"]
}

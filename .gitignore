# Chromium upstream source (121GB) — managed by gclient, not git
/chromium/

# Build artifacts
.build.lock
maho/target/
maho-chromium/third_party/maho/prebuilt/

# Rust local config / model caches
maho/.cargo/
**/.fastembed_cache/

# Android Gradle build outputs
maho/android-shell/.gradle/
maho/android-shell/app/build/
maho/android-shell/build/
maho/android-shell/dev/
maho/android-shell/META-INF/
maho/android-shell/local.properties

# iOS / Xcode build outputs
maho/ios-shell/build/
maho/ios-shell/DerivedData/
maho/ios-shell/Maho.xcodeproj/xcuserdata/

# Misc weird tmpdir submodule marker
maho/${TMPDIR:-/tmp}/

# JS/TS dependencies and build output
node_modules/

# maho-ops (community ops bot): local secrets and state
tools/maho-ops/.env
tools/maho-ops/mapping.db
tools/maho-ops/mapping.db-journal
tools/maho-ops/mapping.db-shm
tools/maho-ops/mapping.db-wal
tools/maho-ops/logs/
tools/maho-ops/.venv/
tools/maho-ops/__pycache__/
dist/
.astro/
.next/
.turbo/
.vite/
.cache/
*.tsbuildinfo

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.xcworkspace/
*.xcuserdata/

# Serena / Sisyphus
.serena/
.sisyphus/
.omo/
/plan/

# Tool runtime artifacts
.agent-browser-profile/
.playwright-mcp/
*.png/
/*.png
test-results/

# Visual QA / debug screenshot folders that get auto-created
visual-qa-output/
.tui-check/

# Visual QA scratch artifacts (Playwright screenshots, ad-hoc captures)
/.playwright-mcp/
/maho-vqa/

# Local signing keys (never commit) — migrate to 1Password when team grows
.secrets/

# Cargo build output. Each workspace has its own target/, and cargo check runs
# with --target-dir target_check so a check never invalidates a build.
target/
target_check/

# SwiftPM resolves package checkouts into the shell's .swiftpm; they are clones
# of upstream repos, not our source.
/maho/ios-shell/.swiftpm/

# Web-research scratch captures (site snapshots, extracted chunks, network logs).
# Ad-hoc analysis output, not project source.
/aside-*
/zen-*
/hero-*-snapshot.md
/roadmap-snapshot.md
/normal-playwright-accessibility.md
/.build-lock-out_*

# Blog image derivatives. website/scripts/optimize-blog-images.mjs regenerates
# these from the committed PNGs on every build; the PNG stays the source of truth.
/website/public/assets/blog/**/*.avif
/website/public/assets/blog/**/*.webp

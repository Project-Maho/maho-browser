---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import PressBadge from '../marketing/PressBadge.astro';
import ScrollReveal from '../motion/ScrollReveal.astro';

interface Props {
  tickerItems?: string[];
  testimonialBadges?: string[];
  eyebrow?: string;
}

const defaultTickerItems = [
  'PRIVACY-FIRST',
  'FREE FOREVER',
  'NO TELEMETRY',
  'BYOK OR MANAGED AI',
  'WEEKLY RELEASES',
];

type ValuePropIcon = 'privacy' | 'free' | 'telemetry' | 'ai' | 'releases' | 'fallback';

interface IconDefinition {
  paths: string[];
  circles?: Array<{ cx: number; cy: number; r: number }>;
}

const labelOverrides: Record<string, string> = {
  'PRIVACY-FIRST': 'Privacy first',
  'FREE FOREVER': 'Free forever',
  'NO TELEMETRY': 'No telemetry',
  'BYOK OR MANAGED AI': 'Bring your own key, or managed AI',
  'WEEKLY RELEASES': 'Weekly releases',
};

const iconDefinitions: Record<ValuePropIcon, IconDefinition> = {
  privacy: {
    paths: [
      'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
      'm9 12 2 2 4-4',
    ],
  },
  free: {
    paths: [
      'M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z',
      'm9 12 2 2 4-4',
    ],
  },
  telemetry: {
    paths: [
      'M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.8 10.8 0 0 1-1.444 2.49',
      'M14.084 14.158a3 3 0 0 1-4.242-4.242',
      'M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143',
      'm2 2 20 20',
    ],
  },
  ai: {
    paths: ['M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3.172a2 2 0 0 0 1.414-.586l8.704-8.704'],
    circles: [{ cx: 16.5, cy: 7.5, r: 5.5 }],
  },
  releases: {
    paths: [
      'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z',
      'm12 15-3-3a22 22 0 0 1 2-3.95A12.87 12.87 0 0 1 22 2c0 2.72-.78 7.5-6.05 11a22.35 22.35 0 0 1-3.95 2z',
      'M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0',
      'M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5',
      'M14 9h.01',
    ],
  },
  fallback: {
    paths: [
      'M21.801 10A10 10 0 1 1 17 3.335',
      'm9 11 3 3L22 4',
    ],
  },
};

function getDisplayLabel(item: string): string {
  const trimmedItem = item.trim();
  const override = labelOverrides[trimmedItem.toUpperCase()];
  if (override) return override;

  const readableItem = trimmedItem.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ');
  const casedItem = readableItem === readableItem.toUpperCase()
    ? readableItem.charAt(0).toUpperCase() + readableItem.slice(1).toLowerCase()
    : readableItem;

  return casedItem.replace(/\bai\b/gi, 'AI');
}

function getIcon(item: string): ValuePropIcon {
  const normalizedItem = item.toLowerCase();

  if (/privacy|private|secure|security/.test(normalizedItem)) return 'privacy';
  if (/free|cost|price/.test(normalizedItem)) return 'free';
  if (/telemetry|tracking|analytics/.test(normalizedItem)) return 'telemetry';
  if (/byok|key|\bai\b|model/.test(normalizedItem)) return 'ai';
  if (/weekly|release|update|ship/.test(normalizedItem)) return 'releases';

  return 'fallback';
}

const {
  tickerItems = defaultTickerItems,
  testimonialBadges = [],
  eyebrow = 'By design',
} = Astro.props;

const normalizedTickerItems = tickerItems
  .filter((item): item is string => item.trim().length > 0)
  .map((item) => {
    const trimmedItem = item.trim();
    const icon = getIcon(trimmedItem);

    return {
      label: getDisplayLabel(trimmedItem),
      icon: iconDefinitions[icon],
    };
  });
const normalizedTestimonialBadges = testimonialBadges.filter((item): item is string => item.trim().length > 0);
const shouldRender = normalizedTickerItems.length > 0 || normalizedTestimonialBadges.length > 0;
---

{shouldRender && (
  <ScrollReveal variant="fade">
    <section class="border-t border-border py-5 sm:py-6">
      <div class="max-w-6xl mx-auto pad-x-ladder">
        <p class="landing-eyebrow mb-4 text-center text-muted-foreground">{eyebrow}</p>
        {normalizedTickerItems.length > 0 && (
          <ul class="flex flex-wrap items-center justify-center gap-2.5" aria-label="Product guarantees">
            {normalizedTickerItems.map(({ label, icon }) => (
              <li class="inline-flex items-center gap-2 rounded-squircle-md border border-border bg-card/70 px-3 py-2 text-sm font-medium text-foreground">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4 shrink-0 text-muted-foreground"
                  aria-hidden="true"
                >
                  {icon.paths.map((path) => <path d={path}></path>)}
                  {icon.circles?.map(({ cx, cy, r }) => <circle cx={cx} cy={cy} r={r}></circle>)}
                </svg>
                <span>{label}</span>
              </li>
            ))}
          </ul>
        )}
        {normalizedTestimonialBadges.length > 0 && (
          <div class="flex flex-wrap gap-3 justify-center mt-8">
            {normalizedTestimonialBadges.map((text) => <PressBadge text={text} />)}
          </div>
        )}
        {/* Testimonial placeholder — activate when press coverage lands
        <div class="flex flex-wrap gap-3 justify-center mt-8">
          <PressBadge text="Coming soon" />
        </div>
        */}
      </div>
    </section>
  </ScrollReveal>
)}

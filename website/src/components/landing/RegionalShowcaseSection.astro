---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import ScrollReveal from '../motion/ScrollReveal.astro';

export interface RegionalScenario {
  id: string;
  regionCode: 'KR' | 'US' | 'JP' | 'EU' | 'VN';
  regionName: string;
  flagEmoji: string;
  scenarioTitle: string;
  targetService: string;
  targetUrl: string;
  story: string;
  status: 'verified' | 'pending';
  statusLabel: string;
  evidenceImagePath?: string;
  evidenceAlt?: string;
  toolsUsed: string[];
}

export const regionalScenarios: RegionalScenario[] = [
  {
    id: 'kr-scenario',
    regionCode: 'KR',
    regionName: 'South Korea',
    flagEmoji: '🇰🇷',
    scenarioTitle: 'KTX Live Ticket Reservation (Seoul → Busan)',
    targetService: 'Korail Global Portal',
    targetUrl: 'https://www.korail.com/global/eng/main',
    story: "Maho searches live seat availability, selects an economy seat, and completes passenger reservation details on Korail's official portal.",
    status: 'verified',
    statusLabel: 'Verified live execution',
    evidenceImagePath: '/assets/regional/kr-result.png',
    evidenceAlt: 'Maho Browser automated live KTX ticket reservation flow on Korail Global',
    toolsUsed: ['tab.new', 'navigation.navigate', 'page.accessibility_snapshot', 'input.click', 'input.type', 'capture.screenshot_full'],
  },
  {
    id: 'us-scenario',
    regionCode: 'US',
    regionName: 'United States',
    flagEmoji: '🇺🇸',
    scenarioTitle: 'Amazon Pre-Payment Purchase Funnel',
    targetService: 'Amazon US',
    targetUrl: 'https://www.amazon.com/',
    story: 'Maho navigates product search, selects an adapter, adds to cart, and advances through checkout, stopping cleanly at the sign-in boundary before payment.',
    status: 'verified',
    statusLabel: 'Verified live execution',
    evidenceImagePath: '/assets/regional/us-amazon-result.png',
    evidenceAlt: 'Maho Browser autonomous e-commerce purchase funnel stopping at Amazon authentication boundary',
    toolsUsed: ['tab.new', 'navigation.navigate', 'page.query_selector', 'input.click', 'capture.screenshot_full'],
  },
  {
    id: 'jp-scenario',
    regionCode: 'JP',
    regionName: 'Japan',
    flagEmoji: '🇯🇵',
    scenarioTitle: 'Yahoo! Transit Route & Fare Optimization',
    targetService: 'Yahoo! JAPAN 路線情報',
    targetUrl: 'https://transit.yahoo.co.jp/',
    story: 'Maho compares Tokyo-to-Osaka routes, applies lowest-fare filtering, and extracts timetable options across Shinkansen and night buses.',
    status: 'verified',
    statusLabel: 'Verified live execution',
    evidenceImagePath: '/assets/regional/jp-result.png',
    evidenceAlt: 'Maho Browser multi-route transit analysis on Yahoo Japan Transit',
    toolsUsed: ['tab.new', 'navigation.navigate', 'page.accessibility_snapshot', 'input.click', 'page.text', 'capture.screenshot_full'],
  },
  {
    id: 'eu-scenario',
    regionCode: 'EU',
    regionName: 'Europe',
    flagEmoji: '🇪🇺',
    scenarioTitle: 'Intercity Bus Direct Booking & Seat Hold',
    targetService: 'FlixBus European Transit',
    targetUrl: 'https://shop.global.flixbus.com/',
    story: 'Maho filters direct Berlin-Munich coaches, reserves passenger seats, and advances through checkout up to the final payment gate.',
    status: 'verified',
    statusLabel: 'Verified live execution',
    evidenceImagePath: '/assets/regional/eu-result.png',
    evidenceAlt: 'Maho Browser verified checkout flow with active seat hold countdown on FlixBus',
    toolsUsed: ['tab.new', 'navigation.navigate', 'page.accessibility_snapshot', 'input.click', 'page.text', 'capture.screenshot_full'],
  },
  {
    id: 'vn-scenario',
    regionCode: 'VN',
    regionName: 'Vietnam',
    flagEmoji: '🇻🇳',
    scenarioTitle: 'Vexere Intercity Bus Booking Flow',
    targetService: 'Vexere Booking Portal',
    targetUrl: 'https://vexere.com/en-US',
    story: 'Maho filters 800+ trips for the Saigon-Da Lat route, organizes departures by price and rating, and enters the seat selection stage.',
    status: 'verified',
    statusLabel: 'Verified live execution',
    evidenceImagePath: '/assets/regional/vn-result.png',
    evidenceAlt: 'Maho Browser bus ticket booking search and seat selection on Vexere',
    toolsUsed: ['tab.new', 'navigation.navigate', 'page.accessibility_snapshot', 'input.click', 'page.text', 'capture.screenshot_full'],
  },
];
---

<section id="regional-showcase" class="section-rhythm pad-x-ladder border-t border-border bg-background text-foreground">
  <div class="container-marketing space-y-12 sm:space-y-16">
    <ScrollReveal variant="slide">
      <div class="max-w-3xl space-y-4">
        <p class="landing-eyebrow text-muted-foreground">Regional E2E Showcase</p>
        <h2 class="landing-section-title">Agentic browsing across regional web ecosystems</h2>
        <p class="landing-body text-muted-foreground">
          Five verified live executions across Korea, the US, Japan, Europe, and Vietnam — showcasing real-world e-commerce, transit booking, and multi-step navigation through the production Maho CLI and autonomous agent pipeline without credentials, logins, or payments.
        </p>
      </div>
    </ScrollReveal>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {regionalScenarios.map((item) => (
        <article class="flex flex-col justify-between rounded-squircle-lg border border-border/80 bg-card/60 p-6 transition-colors hover:border-foreground/30">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-foreground">
                <span class="text-base" aria-hidden="true">{item.flagEmoji}</span>
                {item.regionName} ({item.regionCode})
              </span>
              {item.status === 'verified' ? (
                <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 text-[0.65rem] font-medium tracking-wide text-emerald-400">
                  {item.statusLabel}
                </span>
              ) : (
                <span class="inline-flex items-center rounded-full border border-border bg-muted/60 px-2.5 py-0.5 text-[0.65rem] font-medium tracking-wide text-muted-foreground">
                  {item.statusLabel}
                </span>
              )}
            </div>

            <div class="space-y-1.5">
              <h3 class="text-base font-medium tracking-tight text-foreground">{item.scenarioTitle}</h3>
              <p class="text-xs font-mono text-muted-foreground truncate">{item.targetUrl}</p>
            </div>

            <p class="text-sm text-muted-foreground leading-relaxed">"{item.story}"</p>

            {item.status === 'verified' && item.evidenceImagePath ? (
              <div class="overflow-hidden rounded-squircle-md border border-border bg-card/80">
                <img
                  src={item.evidenceImagePath}
                  alt={item.evidenceAlt || item.scenarioTitle}
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover object-top transition-transform duration-300 hover:scale-105"
                />
              </div>
            ) : (
              <div class="flex aspect-[16/9] flex-col items-center justify-center rounded-squircle-md border border-dashed border-border/80 bg-muted/30 p-4 text-center">
                <p class="text-xs font-medium text-foreground/80">Pending live verification</p>
                <p class="mt-1 text-[0.7rem] text-muted-foreground">Lead-only capture planned for {item.regionName}</p>
              </div>
            )}
          </div>

          <div class="mt-6 border-t border-border/60 pt-4">
            <p class="text-[0.65rem] font-mono uppercase tracking-wider text-muted-foreground/80 mb-2">Capabilities invoked</p>
            <div class="flex flex-wrap gap-1.5">
              {item.toolsUsed.map((tool) => (
                <span class="rounded border border-border/60 bg-muted/40 px-1.5 py-0.5 font-mono text-[0.65rem] text-muted-foreground">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

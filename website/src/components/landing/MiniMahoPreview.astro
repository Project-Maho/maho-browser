---
interface Props {
  readonly alt: string;
}

---

<div data-mini-maho-preview="true" role="img" aria-label={Astro.props.alt} class="relative h-full w-full">
  <img
    src="/demo/hero/maho-mini-maho-poster.png"
    width="1920"
    height="1080"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <video
    src="/demo/hero/maho-mini-maho.mp4"
    poster="/demo/hero/maho-mini-maho-poster.png"
    muted
    autoplay
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
  ></video>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-mini-maho-preview='true'] video {
      display: none;
    }
  }
</style>

---
interface Props {
  readonly alt: string;
}

---

<div data-mini-maho-preview="true" role="img" aria-label={Astro.props.alt} class="relative h-full w-full">
  <picture>
    <img
      src="/demo/hero/maho-mini-maho-poster.png"
      width="1920"
      height="1080"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      sizes="(max-width: 768px) calc(100vw - 2rem), 720px"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>
  <video
    muted
    autoplay
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
    data-progressive-marketing-video
  >
    <source data-src="/demo/hero/maho-mini-maho.mp4" type="video/mp4" />
  </video>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-mini-maho-preview='true'] video {
      display: none;
    }
  }
</style>

<script>
  import { initializeProgressiveMarketingVideos } from '../../scripts/progressive-marketing-video';

  initializeProgressiveMarketingVideos();
</script>

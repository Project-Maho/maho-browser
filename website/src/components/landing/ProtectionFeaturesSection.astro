---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import ScrollReveal from '../motion/ScrollReveal.astro';
import FeatureIllustration from './FeatureIllustration.astro';
import type { ProtectionFeaturesConfig } from '../LandingPage';

interface Props {
  config: ProtectionFeaturesConfig;
}

const { config } = Astro.props;
---

<section class="section-rhythm pad-x-ladder border-t border-border bg-background text-foreground">
  <div class="container-marketing space-y-14 sm:space-y-20">
    <ScrollReveal variant="slide">
      <div class="max-w-3xl space-y-4">
        <p class="landing-eyebrow text-muted-foreground">{config.eyebrow}</p>
        <h2 class="landing-section-title">{config.headline}</h2>
      </div>
    </ScrollReveal>

    <div class="space-y-16 sm:space-y-24">
      {config.items.map((item, index) => (
        <article class="protection-feature grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
          <ScrollReveal
            variant="fade"
            class:list={["protection-copy", index % 2 === 1 && "lg:order-2"]}
          >
            <div class="max-w-xl space-y-5">
              <p class="landing-eyebrow inline-flex rounded-full border border-border bg-card px-3 py-2 text-[0.65rem] text-muted-foreground">
                {item.label}
              </p>
              <h3 class="font-display text-4xl leading-[0.98] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
                {item.headline}
              </h3>
              <p class="landing-body max-w-lg text-muted-foreground">{item.body}</p>
            </div>
          </ScrollReveal>

          <ScrollReveal
            variant="fade"
            delayMs={100}
            class:list={["protection-visual", index % 2 === 1 && "lg:order-1"]}
          >
            <div class="aspect-[16/10] overflow-hidden rounded-squircle-xl border border-border bg-card shadow-[0_2rem_6rem_color-mix(in_srgb,var(--background)_72%,transparent)]">
              <FeatureIllustration kind={item.image} alt={item.alt} />
            </div>
          </ScrollReveal>
        </article>
      ))}
    </div>
  </div>
</section>

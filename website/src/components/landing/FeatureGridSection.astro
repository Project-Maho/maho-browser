---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import ScrollReveal from '../motion/ScrollReveal.astro';
import MiniMahoPreview from './MiniMahoPreview.astro';
import { AgentPanelPreview } from './feature-showcase/AgentPanelPreview';
import type { FeatureGridSectionConfig } from '../LandingPage';

interface Props {
  config: FeatureGridSectionConfig;
}

const { config } = Astro.props;

const frameShape = {
  'ai-when-asked': 'mt-auto aspect-[16/9] md:mt-0 md:flex-1 md:aspect-auto md:min-h-0',
  'mini-maho': 'mt-auto aspect-[16/9]',
} satisfies Record<'ai-when-asked' | 'mini-maho', string>;

---

<section class="section-rhythm pad-x-ladder border-t border-border bg-background text-foreground">
  <div class="container-marketing space-y-10 sm:space-y-14">
    <ScrollReveal variant="slide">
      <div class="max-w-3xl space-y-4">
        <p class="landing-eyebrow text-muted-foreground">{config.eyebrow}</p>
        <h2 class="landing-section-title">{config.headline}</h2>
      </div>
    </ScrollReveal>

    <ul class="feature-bento grid grid-cols-1 gap-5" aria-label="More Maho Browser features">
      {config.items.map((item, index) => {
        const imageKey = item.image === 'ai-when-asked' ? 'ai-when-asked' : 'mini-maho';
        const isAgent = imageKey === 'ai-when-asked';

        return (
          <li class="h-full">
            <ScrollReveal variant="fade" delayMs={index * 80} class="h-full">
              <article
                class="rounded-squircle-xl squircle-enhanced flex h-full flex-col gap-5 overflow-hidden border border-border bg-card p-5 sm:p-6"
              >
                <div class="space-y-4">
                  <p class="landing-eyebrow inline-flex rounded-full border border-border bg-background/60 px-3 py-2 text-[0.65rem] text-muted-foreground">
                    {item.label}
                  </p>
                  <p class="landing-body text-muted-foreground">{item.body}</p>
                </div>

                {isAgent ? (
                  <div
                    data-agent-card-media="full-height"
                    class={`rounded-squircle-lg squircle-enhanced overflow-hidden border border-border/70 bg-background ${frameShape[imageKey]}`}
                  >
                    <AgentPanelPreview client:only="react" />
                  </div>
                ) : (
                  <div class={`rounded-squircle-lg squircle-enhanced overflow-hidden border border-border/70 bg-background ${frameShape[imageKey]}`}>
                    <MiniMahoPreview alt={item.alt} />
                  </div>
                )}
              </article>
            </ScrollReveal>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .feature-bento {
      grid-template-columns: 0.85fr 2fr;
    }
  }
</style>

---
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter props are referenced in the template.
export interface Props {
  variant?: 'mac' | 'mobile';
  class?: string;
}

const { variant = 'mac', class: className } = Astro.props as Props;
---

{variant === 'mobile' ? (
  <div class:list={['device-frame', 'device-frame-mobile', className]}>
    <div class="device-frame-content">
      <slot />
    </div>
    <svg class="device-frame-overlay device-frame-overlay-mobile" viewBox="0 0 100 200" preserveAspectRatio="none" aria-hidden="true">
      <rect class="device-frame-overlay-outline" x="1" y="1" width="98" height="198" rx="24" vector-effect="non-scaling-stroke"></rect>
      <rect class="device-frame-overlay-detail" x="33" y="7" width="26" height="5" rx="2.5"></rect>
      <circle class="device-frame-overlay-detail" cx="63.5" cy="9.5" r="1.5"></circle>
      <path class="device-frame-overlay-glint" d="M16 23C31 20.5 46 19.25 50 19.25C54 19.25 69 20.5 84 23" fill="none" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
) : (
  <div class:list={["device-frame", "device-frame-mac", className]}>
    <div class="device-frame-titlebar">
      <span class="device-frame-dot device-frame-dot-close" aria-hidden="true"></span>
      <span class="device-frame-dot device-frame-dot-min" aria-hidden="true"></span>
      <span class="device-frame-dot device-frame-dot-max" aria-hidden="true"></span>
    </div>
    <div class="device-frame-content">
      <slot />
    </div>
    <svg class="device-frame-overlay device-frame-overlay-mac" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <rect class="device-frame-overlay-outline" x="1" y="1" width="98" height="98" rx="12" vector-effect="non-scaling-stroke"></rect>
      <path class="device-frame-overlay-glint" d="M1 7C16 4.5 32 3.25 50 3.25C68 3.25 84 4.5 99 7" fill="none" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
)}

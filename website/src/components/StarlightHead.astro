---
/**
 * StarlightHead — Override of Starlight's default <Head> component.
 *
 * Renders Starlight's default head tags, then conditionally appends a
 * BlogPosting JSON-LD block when the current route is a blog post.
 *
 * Detection: route.entry.id starts with "blog/" AND has a frontmatter `date`.
 * Tag/author archive pages (blog/tags/*, blog/authors/*) are auto-generated by
 * starlight-blog and do NOT have an entry, so they're naturally excluded.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const data: Record<string, any> = entry?.data ?? {};
const id: string = entry?.id ?? '';

const isBlogPost = id.startsWith('blog/') && !!data.date;

let blogPosting: Record<string, unknown> | null = null;

if (route && Astro.site) {
  const pathname = Astro.url.pathname;
  const isThinArchive =
    pathname.includes('/blog/authors/maho-team') ||
    pathname.includes('/blog/tags/glossary') ||
    pathname.includes('/blog/tags/cli') ||
    pathname.includes('/blog/tags/terminal');

  if (isThinArchive) {
    route.head = route.head.filter(tag => !(tag.tag === 'meta' && tag.attrs?.name === 'robots'));
    route.head.push({
      tag: 'meta',
      attrs: { name: 'robots', content: 'noindex, follow' }
    });
  }

  // Inject RSS discovery link if not already present
  if (!route.head.some(tag => tag.tag === 'link' && tag.attrs?.rel === 'alternate' && tag.attrs?.type === 'application/rss+xml')) {
    route.head.push({
      tag: 'link',
      attrs: {
        rel: 'alternate',
        type: 'application/rss+xml',
        title: 'Maho Blog RSS Feed',
        href: new URL('/blog/rss.xml', Astro.site).href
      }
    });
  }

  if (isBlogPost) {
    const url = new URL(Astro.url.pathname, Astro.site).href;
    
    // Derive per-post OG image from frontmatter or infer from slug
    const slug = id.replace(/^blog\//, '').replace(/\.mdx?$/, '');
    const heroPath = `/assets/blog/${slug}/hero.png`;
    const ogImage = data.heroImage
      ? new URL(data.heroImage, Astro.site).href
      : new URL(heroPath, Astro.site).href;
      
    const logo = new URL('/icon-512.png', Astro.site).href;

    // Normalize authors: starlight-blog allows string | object | array
    const rawAuthors = Array.isArray(data.authors)
      ? data.authors
      : data.authors
        ? [data.authors]
        : [];
    const authors = rawAuthors.map((a: any) => {
      const name = typeof a === 'string' ? a : a?.name;
      if (!name) return null;
      const person: Record<string, unknown> = {
        '@type': 'Person',
        name,
        url: new URL('/about', Astro.site).href,
      };
      if (typeof a === 'object' && a?.url) person.url = a.url;
      return person;
    }).filter(Boolean);

    const datePublished = data.date instanceof Date
      ? data.date.toISOString()
      : new Date(data.date).toISOString();

    const dateModified = data.lastUpdated
      ? (data.lastUpdated instanceof Date
          ? data.lastUpdated.toISOString()
          : new Date(data.lastUpdated).toISOString())
      : undefined;

    blogPosting = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description ?? data.excerpt ?? undefined,
      datePublished,
      ...(dateModified ? { dateModified } : {}),
      ...(authors.length > 0 ? { author: authors.length === 1 ? authors[0] : authors } : {}),
      ...(Array.isArray(data.tags) && data.tags.length > 0
        ? { keywords: data.tags.join(', ') }
        : {}),
      image: ogImage,
      url,
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      publisher: {
        '@type': 'Organization',
        name: 'Maho',
        logo: { '@type': 'ImageObject', url: logo },
      },
    };

    // Update Starlight's default head meta tags for OG/Twitter image
    route.head = route.head.filter(tag => 
      !(tag.tag === 'meta' && (tag.attrs?.property === 'og:image' || tag.attrs?.name === 'twitter:image'))
    );
    route.head.push({
      tag: 'meta',
      attrs: { property: 'og:image', content: ogImage }
    });
    route.head.push({
      tag: 'meta',
      attrs: { name: 'twitter:image', content: ogImage }
    });

    // Add article published and modified times
    route.head.push({
      tag: 'meta',
      attrs: { property: 'article:published_time', content: datePublished }
    });
    if (dateModified) {
      route.head.push({
        tag: 'meta',
        attrs: { property: 'article:modified_time', content: dateModified }
      });
    }
  }
}
---

<Default><slot /></Default>
{blogPosting && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
)}


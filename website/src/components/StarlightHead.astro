---
/**
 * StarlightHead — Override of Starlight's default <Head> component.
 *
 * Renders Starlight's default head tags, then conditionally appends a
 * BlogPosting JSON-LD block when the current route is a blog post.
 *
 * Detection: route.entry.id starts with "blog/" AND has a frontmatter `date`.
 * Tag/author archive pages (blog/tags/*, blog/authors/*) are auto-generated by
 * starlight-blog and do NOT have an entry, so they're naturally excluded.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const data: Record<string, any> = entry?.data ?? {};
const id: string = entry?.id ?? '';

const isBlogPost = id.startsWith('blog/') && !!data.date;

let blogPosting: Record<string, unknown> | null = null;

if (isBlogPost && Astro.site) {
  const url = new URL(Astro.url.pathname, Astro.site).href;
  const ogImage = new URL('/og-image.png', Astro.site).href;
  const logo = new URL('/logo.svg', Astro.site).href;

  // Normalize authors: starlight-blog allows string | object | array
  const rawAuthors = Array.isArray(data.authors)
    ? data.authors
    : data.authors
      ? [data.authors]
      : [];
  const authors = rawAuthors.map((a: any) => {
    const name = typeof a === 'string' ? a : a?.name;
    if (!name) return null;
    const person: Record<string, unknown> = { '@type': 'Person', name };
    if (typeof a === 'object' && a?.url) person.url = a.url;
    return person;
  }).filter(Boolean);

  const datePublished = data.date instanceof Date
    ? data.date.toISOString()
    : new Date(data.date).toISOString();

  blogPosting = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description ?? data.excerpt ?? undefined,
    datePublished,
    ...(data.lastUpdated
      ? {
          dateModified: data.lastUpdated instanceof Date
            ? data.lastUpdated.toISOString()
            : new Date(data.lastUpdated).toISOString(),
        }
      : {}),
    ...(authors.length > 0 ? { author: authors.length === 1 ? authors[0] : authors } : {}),
    ...(Array.isArray(data.tags) && data.tags.length > 0
      ? { keywords: data.tags.join(', ') }
      : {}),
    image: ogImage,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    publisher: {
      '@type': 'Organization',
      name: 'Maho',
      logo: { '@type': 'ImageObject', url: logo },
    },
  };
}
---

<Default><slot /></Default>
{blogPosting && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
)}

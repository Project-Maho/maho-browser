---
interface Props {
  badge: string;
  headline: string;
  body: string;
}

const { badge, headline, body } = Astro.props;
---

<section class="py-24 px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-3xl">
      <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">
        {badge}
      </span>
      <h2 class="heading-serif text-4xl sm:text-5xl mb-6">
        {headline}
      </h2>
      <p class="text-muted-foreground leading-relaxed text-lg">
        {body}
      </p>
    </div>
  </div>
</section>

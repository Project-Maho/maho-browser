---
interface FeatureItem {
  title: string;
  desc: string;
}

interface Props {
  badge: string;
  headline: string;
  items: FeatureItem[];
}

const { badge, headline, items } = Astro.props;
---

<section class="py-24 px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">
      {badge}
    </span>
    <h2 class="heading-serif text-4xl sm:text-5xl mb-16">
      {headline}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
      {items.map((item, index) => (
        <div class="bg-background p-10">
          <span class="heading-serif text-4xl sm:text-5xl text-muted/50 block mb-6">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="text-foreground font-medium text-lg mb-2">
            {item.title}
          </h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

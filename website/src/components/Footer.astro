---
const productLinks = [
  { href: '/download', label: 'Download' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/why', label: 'Why Maho' },
  { href: '/mail', label: 'Mail →' },
];

const resourceLinks = [
  { href: '/browser/', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: '/blog', label: 'Changelog' },
  { href: '/status', label: 'Status' },
];

const compareLinks = [
  { href: '/blog/maho-vs-arc', label: 'vs Arc' },
  { href: '/blog/maho-vs-zen-browser', label: 'vs Zen' },
  { href: '/blog/maho-vs-safari', label: 'vs Safari' },
  { href: '/compare', label: 'All comparisons' },
];

const companyLinks = [
  { href: '/about', label: 'About' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/security', label: 'Security' },
  { href: 'https://discord.gg/Ty4J6pMdqg', label: 'Discord' },
];

const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="border-t border-border bg-background px-6 py-12 text-foreground" aria-label="Site footer">
  <div class="mx-auto max-w-6xl space-y-10">
    <div class="space-y-2">
      <span class="text-sm font-medium text-foreground">Maho</span>
      <p class="landing-body max-w-xl text-sm text-muted-foreground sm:text-base">
        Available across macOS, Windows, Linux, iOS, and Android.
      </p>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <span class="landing-eyebrow font-semibold text-foreground">Product</span>
        <div class="flex flex-col gap-3">
          {productLinks.map((link) => (
            <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover:text-foreground">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="landing-eyebrow font-semibold text-foreground">Resources</span>
        <div class="flex flex-col gap-3">
          {resourceLinks.map((link) => (
            <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover:text-foreground">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="landing-eyebrow font-semibold text-foreground">Compare</span>
        <div class="flex flex-col gap-3">
          {compareLinks.map((link) => (
            <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover:text-foreground">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="landing-eyebrow font-semibold text-foreground">Company</span>
        <div class="flex flex-col gap-3">
          {companyLinks.map((link) => (
            <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover:text-foreground">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 Maho.</span>
      <div class="flex flex-wrap gap-4">
        {legalLinks.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 min-w-11 items-center justify-center transition-colors hover:text-foreground">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>

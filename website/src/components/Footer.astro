---

<footer class="py-12 px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <span class="text-sm font-medium text-foreground">Maho</span>

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-4 mt-10">
      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Product
        </span>
        <div class="flex flex-col gap-3">
          <a href="https://github.com/nicepkg/maho/releases" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Download
          </a>
          <a href="https://github.com/nicepkg" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            GitHub
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Resources
        </span>
        <div class="flex flex-col gap-3">
          <a href="/cli/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Docs
          </a>
          <a href="https://github.com/aspect-apps/maho-mail/releases" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Changelog
          </a>
          <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Blog
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Compare
        </span>
        <div class="flex flex-col gap-3">
          <a href="/compare/maho-mail-vs-superhuman" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            vs Superhuman
          </a>
          <a href="/compare/maho-mail-vs-apple-mail" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            vs Apple Mail
          </a>
          <a href="/compare/maho-mail-vs-spark" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            vs Spark
          </a>
          <a href="/compare/maho-mail-vs-thunderbird" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            vs Thunderbird
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Company
        </span>
        <div class="flex flex-col gap-3">
          <a href="/terms" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Terms
          </a>
          <a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Privacy
          </a>
          <a href="mailto:hello@maho.app" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Contact
          </a>
        </div>
      </div>
    </div>
  </div>

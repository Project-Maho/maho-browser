---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter data is referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import PlatformIcon, { type Platform } from '../components/download/PlatformIcon.astro';
import { getSiteUrl } from '../lib/site';
import { latestReleaseAssetUrl, releasePageUrl } from '../lib/release-url';

const RELEASE_REPO = import.meta.env.PUBLIC_RELEASE_REPO_URL || 'https://github.com/Project-Maho/release';
const RELEASE_PAGE_URL = releasePageUrl(RELEASE_REPO);
const RELEASE_URL_MACOS = import.meta.env.PUBLIC_RELEASE_URL_MACOS || latestReleaseAssetUrl(RELEASE_REPO, 'Maho-2026.9.19.dmg');
const RELEASE_URL_WINDOWS = import.meta.env.PUBLIC_RELEASE_URL_WINDOWS || latestReleaseAssetUrl(RELEASE_REPO, 'MahoSetup-2026.9.19.exe');
const RELEASE_URL_LINUX = import.meta.env.PUBLIC_RELEASE_URL_LINUX || latestReleaseAssetUrl(RELEASE_REPO, 'maho_2026.9.19_amd64.deb');
const RELEASE_URL_LINUX_RPM = latestReleaseAssetUrl(RELEASE_REPO, 'maho-2026.9.19-1.x86_64.rpm');
const RELEASE_URL_LINUX_TARBALL = latestReleaseAssetUrl(RELEASE_REPO, 'maho-2026.9.19-x86_64.tar.gz');

const productParam = Astro.url.searchParams.get('product');
const isMailProduct = productParam === 'mail';
const productLabel = isMailProduct ? 'Maho Mail' : 'Maho';
const { absoluteUrl } = getSiteUrl(Astro);

const pageTitle = `Download ${productLabel} — Maho`;
const pageDescription = `Download ${productLabel} across macOS, Windows, Linux, iOS, and Android.`;

const platforms: Array<{
  id: Platform;
  name: string;
  requirements: string;
  status: 'Coming soon' | null;
  downloadLabel: string | null;
  downloadUrl: string | null;
  alternates: Array<{ label: string; url: string }>;
}> = [
  {
    id: 'macos',
    name: 'macOS',
    requirements: 'macOS 12+',
    status: null,
    downloadLabel: 'Download DMG',
    downloadUrl: RELEASE_URL_MACOS,
    alternates: [],
  },
  {
    id: 'windows',
    name: 'Windows',
    requirements: 'Windows 10+',
    status: null,
    downloadLabel: 'Download EXE',
    downloadUrl: RELEASE_URL_WINDOWS,
    alternates: [],
  },
  {
    id: 'linux',
    name: 'Linux',
    requirements: 'Ubuntu 22.04+ / glibc 2.35+',
    status: null,
    downloadLabel: 'Download DEB',
    downloadUrl: RELEASE_URL_LINUX,
    alternates: [
      { label: 'RPM', url: RELEASE_URL_LINUX_RPM },
      { label: 'tar.gz', url: RELEASE_URL_LINUX_TARBALL },
    ],
  },
  {
    id: 'ios',
    name: 'iOS',
    requirements: 'iPhone and iPad (TestFlight)',
    status: 'Beta',
    downloadLabel: 'Join TestFlight',
    downloadUrl: 'https://testflight.apple.com/join/JQf4rVm6',
    alternates: [],
  },
  {
    id: 'android',
    name: 'Android',
    requirements: 'Android phones and tablets (Play Internal)',
    status: 'Beta',
    downloadLabel: 'Join Android Beta',
    downloadUrl: 'https://play.google.com/apps/internaltest/4699692750515426389',
    alternates: [],
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: productLabel,
  applicationCategory: isMailProduct ? 'CommunicationApplication' : 'BrowserApplication',
  operatingSystem: 'macOS 12+, Windows 10+, Linux (Ubuntu 22.04+), iOS, Android',
  downloadUrl: [RELEASE_URL_MACOS, RELEASE_URL_WINDOWS, RELEASE_URL_LINUX],
  url: absoluteUrl('/download'),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <JSONLD data={ld} />

  <div class="min-h-screen bg-background text-foreground">
    <Nav activeProduct={isMailProduct ? 'mail' : 'browser'} />

    <main id="main" class="pt-24 sm:pt-28 md:pt-32">
      <section class="container-marketing pad-x-ladder pb-24 pt-12 sm:pt-16 md:pb-32 md:pt-20">
        <header class="max-w-2xl">
          <h1 class="heading-serif text-4xl leading-[0.98] sm:text-5xl lg:text-6xl">
            Download {productLabel}.
          </h1>
        </header>

        <div data-download-platforms class="mt-10 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 md:mt-12 lg:grid-cols-6">
          {platforms.map((platform) => (
            <article
              data-platform-card
              data-platform={platform.id}
              class={'group flex min-h-64 flex-col bg-background p-6 sm:p-7 ' + (
                platform.id === 'android' ? 'sm:col-span-2 lg:col-span-3' :
                platform.id === 'ios' ? 'lg:col-span-3' :
                'lg:col-span-2'
              )}
            >
              <div class="flex items-start justify-between gap-4">
                <PlatformIcon platform={platform.id} />
              </div>

              <div class="mt-8">
                <h2 class="inline-flex items-center gap-2.5 text-2xl font-medium tracking-tight text-foreground">
                  <span>{platform.name}</span>
                  {platform.status && (
                    <span class="rounded-full border border-border bg-muted/60 px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wider text-muted-foreground">
                      {platform.status}
                    </span>
                  )}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  {platform.requirements}
                </p>
              </div>

              <div class="mt-auto pt-8">
                {platform.downloadUrl && platform.downloadLabel ? (
                  <>
                    <a
                      href={platform.downloadUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="cta-btn cta-btn-ghost w-full justify-center"
                      aria-label={'Download ' + productLabel + ' for ' + platform.name}
                    >
                      {platform.downloadLabel}
                    </a>

                    {platform.alternates.length > 0 && (
                      <div class="mt-1 flex flex-wrap items-center gap-1">
                        {platform.alternates.map((alternate) => (
                          <a
                            href={alternate.url}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-sm text-muted-foreground underline underline-offset-4 transition-opacity hover:text-foreground"
                            aria-label={'Download ' + productLabel + ' for Linux as ' + alternate.label}
                          >
                            {alternate.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </>
                ) : (
                  <p class="text-sm leading-relaxed text-muted-foreground">
                    Mobile beta is on its way.
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>

        <a
          href={RELEASE_PAGE_URL}
          target="_blank"
          rel="noreferrer"
          class="mt-10 inline-flex min-h-11 items-center text-sm text-muted-foreground underline underline-offset-4 transition-opacity hover:text-foreground md:mt-12"
        >
          View all releases
        </a>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaButton from '../components/marketing/CtaButton';
import SquircleBox from '../components/marketing/SquircleBox.astro';
import ScrollReveal from '../components/motion/ScrollReveal';
import JSONLD from '../components/JSONLD.astro';

// Phase 1: redirect to GitHub Releases until self-hosted CDN is live.
// Owner decision pending on §5.4 of revision plan.
const releaseUrl = "https://github.com/Project-Maho/release/releases";
const mailReleaseUrl = "https://github.com/Project-Maho/release/releases";
const productParam = Astro.url.searchParams.get("product");
const target = productParam === "mail" ? mailReleaseUrl : releaseUrl;
const productLabel = productParam === "mail" ? "Maho Mail" : "Maho";
const installSteps = [
  {
    label: 'Step 1',
    title: 'Open the DMG',
    detail: 'Double-click the downloaded file in your Downloads folder.'
  },
  {
    label: 'Step 2',
    title: 'Drag to Applications',
    detail: `Drag the ${productLabel} icon into your Applications folder.`
  },
  {
    label: 'Step 3',
    title: 'Launch',
    detail: `Open ${productLabel} from Applications or Spotlight. First launch sets up sync.`
  }
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Maho',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'macOS 12 or later',
  downloadUrl: 'https://github.com/Project-Maho/release/releases',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};
---

<BaseLayout title={`Download ${productLabel} for macOS — Maho`} description={`Download ${productLabel} for macOS 12+. Free forever. iPhone and Android in development.`} ogImage="/og/download.png">
  <JSONLD data={ld} />
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <script is:inline define:vars={{ target }}>
    // Belt-and-suspenders: client-side redirect in case meta-refresh fails.
    setTimeout(function() { window.location.replace(target); }, 100);
  </script>
  <div class="min-h-screen bg-background text-foreground">
    <Nav />
    <main id="main" class="max-w-2xl mx-auto px-6 pt-32 pb-24 text-center">
      <h1 class="heading-serif text-4xl sm:text-5xl mb-6">
        Your download is starting.
      </h1>
      <p class="text-muted-foreground leading-relaxed text-lg mb-8">
        Redirecting you to the latest {productLabel} release. If nothing happens within a few seconds:
      </p>
      <CtaButton client:load href={target} variant="primary" className="mb-12">
        Download now
      </CtaButton>

      <div class="mt-16 grid grid-cols-1 gap-6 text-left sm:grid-cols-3">
        {installSteps.map((step, index) => (
          <ScrollReveal client:visible variant="slide" delayMs={index * 100} className="h-full">
            <SquircleBox radius="lg" class="h-full border border-border bg-card p-6">
              <p class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">{step.label}</p>
              <p class="mb-2 text-sm font-medium text-foreground">{step.title}</p>
              <p class="text-xs leading-relaxed text-muted-foreground">{step.detail}</p>
            </SquircleBox>
          </ScrollReveal>
        ))}
      </div>

      <p class="text-xs text-muted-foreground mt-16 leading-relaxed">
        macOS 12 or later. iPhone and Android are in development — <a href="/waitlist" class="underline hover:text-foreground transition-colors">join the waitlist</a> to be notified.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>

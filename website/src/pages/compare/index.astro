---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = "Compare Maho Mail — See How It Stacks Up";
const description = "Side-by-side comparisons of Maho Mail versus Thunderbird, Apple Mail, Superhuman, Spark, Shortwave, himalaya, aerc, mutt, and more.";

const comparisons = [
  {
    slug: "maho-mail-vs-thunderbird",
    name: "Thunderbird",
    tagline: "The legacy desktop client vs the modern one",
    differentiator: "CLI + MCP + AI + modern UI vs full PIM suite",
  },
  {
    slug: "maho-mail-vs-apple-mail",
    name: "Apple Mail",
    tagline: "The default vs the deliberate choice",
    differentiator: "Programmatic inbox access vs deep OS integration",
  },
  {
    slug: "maho-mail-vs-superhuman",
    name: "Superhuman",
    tagline: "Premium speed vs programmable power",
    differentiator: "Local, free, open source vs polished cloud UX at $30/mo",
  },
  {
    slug: "maho-mail-vs-spark",
    name: "Spark",
    tagline: "Team collaboration vs solo automation",
    differentiator: "CLI + MCP + local-first vs shared drafts and team inboxes",
  },
  {
    slug: "maho-mail-vs-shortwave",
    name: "Shortwave",
    tagline: "AI wrapper vs AI-native architecture",
    differentiator: "Bring your own AI + three interfaces vs Gmail AI frontend",
  },
  {
    slug: "maho-mail-vs-himalaya",
    name: "himalaya",
    tagline: "Both have a CLI. Only one has everything else.",
    differentiator: "GUI + CLI + MCP + AI vs mature CLI-only tool",
  },
  {
    slug: "maho-mail-vs-aerc-mutt-neomutt",
    name: "aerc / mutt / neomutt",
    tagline: "Terminal email clients that forgot the GUI",
    differentiator: "Three interfaces in one vs decades of terminal mastery",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": "https://maho.app/compare",
      "publisher": { "@type": "Organization", "name": "Maho", "url": "https://maho.app" },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://maho.app" },
        { "@type": "ListItem", "position": 2, "name": "Compare" },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Nav />
  <main class="min-h-screen bg-background text-foreground">
    <section class="relative flex flex-col justify-center px-6 pt-32 pb-24 bg-background text-foreground">
      <div class="max-w-6xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground mb-8">
          <a href="/" class="hover:text-foreground transition-colors">Home</a>
          <span class="mx-2">/</span>
          <span class="text-foreground">Compare</span>
        </nav>
        <h1 class="heading-serif text-5xl sm:text-6xl lg:text-7xl leading-[1.1] mb-8">
          Compare Maho Mail.
        </h1>
        <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl leading-relaxed">
          Maho Mail is the first email client with a desktop app, CLI, and MCP server in one. See how it compares to the tools you already know.
        </p>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {comparisons.map((c) => (
            <a
              href={`/compare/${c.slug}`}
              class="group block border border-border rounded-lg p-6 hover:border-muted-foreground transition-colors"
            >
              <h2 class="text-lg font-medium text-foreground mb-2 group-hover:underline">
                Maho Mail vs {c.name}
              </h2>
              <p class="text-sm text-muted-foreground mb-4">{c.tagline}</p>
              <p class="text-xs text-muted-foreground">{c.differentiator}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="heading-serif text-4xl sm:text-5xl mb-6">
          Make email programmable.
        </h2>
        <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
          GUI for humans. CLI for developers. MCP for agents.
        </p>
        <a
          href="/mail"
          class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity"
        >
          Learn more about Maho Mail
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

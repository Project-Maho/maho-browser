---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/motion/ScrollReveal';
import { getSiteUrl } from '../../lib/site';

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);
const title = "Maho Mail vs Spark: Which Email Client Is Better in 2026?";
const description = "Comparing Maho Mail to Spark. A local-first email client with CLI and MCP vs a team collaboration email platform.";

const faqs = [
  {
    q: "Does Spark have a CLI?",
    a: "No. Spark is a GUI-only email client focused on team collaboration features like shared drafts, email assignments, and team comments. It does not have a command-line interface, API, or MCP server. Maho Mail provides all three."
  },
  {
    q: "Can Spark work with AI agents?",
    a: "Spark has some built-in AI features like email prioritization and smart notifications, but it does not expose your inbox to external AI agents via MCP or any other protocol. Maho Mail's MCP server lets any compatible AI tool interact with your email."
  },
  {
    q: "Is Spark free?",
    a: "Spark has a free tier for individuals with basic features. The Premium plan ($7.99/user/month) and Team plan add collaboration features, AI capabilities, and priority support. Maho Mail is completely free, with no paywalls or feature gates."
  },
  {
    q: "Is my email private with Spark?",
    a: "Spark is a cloud-based service. Your email data is processed on Spark's servers for features like smart notifications and team collaboration. They outline their data practices in their privacy policy. Maho Mail stores all data locally on your device with no cloud component."
  },
  {
    q: "Can I use Spark on all platforms?",
    a: "Yes. Spark is available on macOS, iOS, Android, and Windows. Maho Mail is currently a macOS desktop application with a CLI that works in any terminal. Spark has broader platform support today."
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": "2026-04-12",
      "dateModified": "2026-04-12",
      "author": { "@type": "Organization", "name": "Maho", "url": siteUrl },
      "publisher": { "@type": "Organization", "name": "Maho", "url": siteUrl },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Compare", "item": absoluteUrl('/compare') },
        { "@type": "ListItem", "position": 3, "name": "Maho Mail vs Spark" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Nav />
  <main id="main" class="min-h-screen bg-background text-foreground marketing-scope">

    <section class="relative flex flex-col justify-center pad-x-ladder pt-32 pb-24">
      <div class="max-w-6xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground mb-8">
          <a href="/" class="hover:text-foreground transition-colors">Home</a>
          <span class="mx-2">/</span>
          <a href="/compare" class="hover:text-foreground transition-colors">Compare</a>
          <span class="mx-2">/</span>
          <span class="text-foreground">vs Spark</span>
        </nav>
        <h1 class="heading-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.1] mb-6">
          Maho Mail vs Spark
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
          Team collaboration vs solo automation. Two clients built for fundamentally different email workflows.
        </p>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">
          <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">Quick Verdict</span>
          <p class="text-lg text-muted-foreground leading-relaxed">
            <strong class="text-foreground">Choose Spark</strong> if you work in a team and need shared drafts, email assignments, and collaborative inbox features across multiple platforms. <strong class="text-foreground">Choose Maho Mail</strong> if you are an individual user who wants CLI access, AI agent integration, and full local control over your email data.
          </p>
        </div>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">At a Glance</span>
        <h2 class="heading-serif tracking-display text-3xl sm:text-4xl mb-10">Side-by-side comparison</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-3 pr-6 text-muted-foreground font-medium font-mono uppercase tracking-mono-loose">Feature</th>
                <th class="text-left py-3 px-6 text-foreground font-medium font-mono uppercase tracking-mono-loose">Maho Mail</th>
                <th class="text-left py-3 pl-6 text-muted-foreground font-medium font-mono uppercase tracking-mono-loose">Spark</th>
              </tr>
            </thead>
            <ScrollReveal client:visible as="tbody" variant="fade" className="divide-y divide-border">
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Desktop GUI</td>
                <td class="py-3 px-6 text-foreground">Yes — minimal, keyboard-driven</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — rich, team-oriented interface</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">CLI</td>
                <td class="py-3 px-6 text-foreground">Yes — full email CLI with JSON output</td>
                <td class="py-3 pl-6 text-muted-foreground">No</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">MCP Server</td>
                <td class="py-3 px-6 text-foreground">Yes — AI agents connect via stdio</td>
                <td class="py-3 pl-6 text-muted-foreground">No</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">AI Features</td>
                <td class="py-3 px-6 text-foreground">Yes — bring your own provider</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — built-in prioritization and summaries</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Team Features</td>
                <td class="py-3 px-6 text-foreground">No — built for individuals</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — shared drafts, assignments, comments</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Cross-platform</td>
                <td class="py-3 px-6 text-foreground">macOS + terminal CLI</td>
                <td class="py-3 pl-6 text-muted-foreground">macOS, iOS, Android, Windows</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Local & Private</td>
                <td class="py-3 px-6 text-foreground">Yes — everything on your device</td>
                <td class="py-3 pl-6 text-muted-foreground">No — cloud-based</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Open Source</td>
                <td class="py-3 px-6 text-foreground">No — proprietary</td>
                <td class="py-3 pl-6 text-muted-foreground">No — proprietary</td>
              </tr>
            </ScrollReveal>
          </table>
        </div>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">Deep Dive</span>
        <h2 class="heading-serif tracking-display text-3xl sm:text-4xl mb-10">Category comparison</h2>

        <div class="space-y-16 max-w-3xl">
          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Team Collaboration</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Spark was built for teams from the ground up. Shared drafts let multiple people collaborate on an email before sending. Email assignments route messages to the right person. Inline comments let teammates discuss threads without forwarding. Shared inboxes (like support@ or sales@) are a first-class feature.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail has no team features. It is designed for individual users who want to automate and script their own inbox. If your email workflow involves collaboration with colleagues, Spark is purpose-built for that. Maho is purpose-built for something else entirely.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Automation & Developer Tooling</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Spark offers smart inbox categories, notification scheduling, and built-in AI for prioritization. These are GUI-driven features — you configure them in the app settings and they run automatically. There is no programmatic access, no CLI, and no way to connect external automation tools.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail gives you three interfaces to the same data. Search and filter from the terminal with <code class="text-foreground text-sm bg-card px-1.5 py-0.5 rounded">maho search --subject "invoice" --json</code>. Pipe results to jq, Python, or an LLM. Let AI agents triage your inbox through the MCP server. The automation model is fundamentally different — programmable rather than configured.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">AI Approach</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Spark has built-in AI features including email prioritization, smart notifications, and writing assistance. These features are integrated into the Spark experience and use Spark's chosen AI models. You get a curated set of capabilities but cannot customize the underlying models or behavior.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail lets you choose your provider — OpenAI, Anthropic, or Ollama for local inference. The MCP server extends this further by letting any AI agent interact with your inbox. Spark gives you AI features. Maho gives you AI infrastructure.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Privacy & Data</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Spark is a cloud service. Email data passes through Readdle's servers for features like smart notifications, team collaboration, and cross-device sync. Their privacy practices have improved over time, but the architecture requires cloud processing.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail is entirely local. Your email data is stored in a SQLite database on your machine. There is no cloud sync, no telemetry, and no third-party data processing. The tradeoff is that you lose cross-device sync and team features.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Platform Coverage</h3>
            <p class="text-muted-foreground leading-relaxed">
              Spark is available on macOS, iOS, Android, and Windows. Your email experience syncs across all devices with shared preferences and team state. Maho Mail is currently a macOS desktop application. The CLI works in any terminal on macOS, and cross-platform support may come in the future, but today Spark has significantly broader reach.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-12 md:grid-cols-2">
          <div>
            <h2 class="text-xl font-medium text-foreground tracking-display mb-6">Choose Maho Mail if you...</h2>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Work solo and want CLI access to your inbox
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Need AI agents to interact with email via MCP
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want to choose your own AI provider
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Care about local data and verifiable privacy
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want to script and automate email workflows
              </li>
            </ul>
          </div>
          <div>
            <h2 class="text-xl font-medium text-foreground tracking-display mb-6">Choose Spark if you...</h2>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Need team email collaboration features
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want shared drafts, assignments, and inline comments
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Need cross-platform support (iOS, Android, Windows)
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Value smart inbox and notification management
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want a polished team email experience out of the box
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">FAQ</span>
        <h2 class="heading-serif tracking-display text-3xl sm:text-4xl mb-10">Frequently asked questions</h2>
        <div class="max-w-3xl space-y-4">
          {faqs.map((faq) => (
            <details class="group border border-border rounded-lg">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-foreground font-medium">
                {faq.q}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 ml-4 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-4 text-muted-foreground leading-relaxed">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section-rhythm pad-x-ladder border-t border-border">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="heading-serif tracking-display text-4xl sm:text-5xl mb-6">
          Ready to try Maho Mail?
        </h2>
        <p class="text-muted-foreground leading-relaxed mb-8 max-w-xl mx-auto">
          GUI for humans. CLI for developers. MCP for agents.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/mail" class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity">
            Learn more about Maho Mail
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/compare" class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-md text-sm font-medium text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors">
            See all comparisons
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

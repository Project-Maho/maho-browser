---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = "Maho Mail vs Superhuman: Which Email Client Is Better in 2026?";
const description = "Comparing Maho Mail to Superhuman. A free, open-source email client with CLI and MCP vs the premium $30/mo cloud email experience.";

const faqs = [
  {
    q: "Is Maho Mail as fast as Superhuman?",
    a: "Superhuman is widely praised for its speed — near-instant search, fast loading, and smooth animations. It has spent years optimizing perceived performance. Maho Mail is fast for a different reason: everything is local. There is no network round-trip for search or loading cached messages. However, Superhuman's UI polish and micro-interactions are in a league of their own."
  },
  {
    q: "Does Superhuman have a CLI?",
    a: "No. Superhuman is a GUI-only email client with no command-line interface, no API, and no way for external tools to programmatically access your inbox. Maho Mail provides a full CLI with JSON output and an MCP server for AI agents."
  },
  {
    q: "Is Superhuman worth $30/month compared to free Maho Mail?",
    a: "It depends on what you value. Superhuman offers a highly polished experience with split inbox, read receipts, send scheduling, team features, and dedicated onboarding. If those features save you meaningful time, the cost may be justified. Maho Mail is free and open source but offers a different set of capabilities — CLI, MCP, and AI integration. The two clients are optimized for different users."
  },
  {
    q: "Can Superhuman connect to AI agents?",
    a: "No. Superhuman has its own AI features (AI triage, auto-summarization) but does not expose your inbox to external AI agents. Maho Mail's MCP server lets any MCP-compatible tool — Claude, Cursor, or custom agents — read, search, and draft email in your inbox."
  },
  {
    q: "Is my data private with Superhuman?",
    a: "Superhuman is a cloud-based service. Your email data passes through Superhuman's servers. They have a privacy policy, but your data is not solely on your device. Maho Mail stores everything locally with no cloud component and no telemetry."
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": "2026-04-12",
      "dateModified": "2026-04-12",
      "author": { "@type": "Organization", "name": "Maho", "url": "https://maho.app" },
      "publisher": { "@type": "Organization", "name": "Maho", "url": "https://maho.app" },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://maho.app" },
        { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://maho.app/compare" },
        { "@type": "ListItem", "position": 3, "name": "Maho Mail vs Superhuman" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Nav />
  <main class="min-h-screen bg-background text-foreground">

    <section class="relative flex flex-col justify-center px-6 pt-32 pb-24">
      <div class="max-w-6xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground mb-8">
          <a href="/" class="hover:text-foreground transition-colors">Home</a>
          <span class="mx-2">/</span>
          <a href="/compare" class="hover:text-foreground transition-colors">Compare</a>
          <span class="mx-2">/</span>
          <span class="text-foreground">vs Superhuman</span>
        </nav>
        <h1 class="heading-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.1] mb-6">
          Maho Mail vs Superhuman
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
          Premium speed vs programmable power. Two very different answers to the question of what email should be.
        </p>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">
          <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">Quick Verdict</span>
          <p class="text-lg text-muted-foreground leading-relaxed">
            <strong class="text-foreground">Choose Superhuman</strong> if you want the fastest, most polished email experience and are willing to pay $30/month for it. <strong class="text-foreground">Choose Maho Mail</strong> if you want a free, open-source client with CLI access, AI agent integration, and full local privacy — and you value programmability over polish.
          </p>
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">At a Glance</span>
        <h2 class="heading-serif text-3xl sm:text-4xl mb-10">Side-by-side comparison</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-3 pr-6 text-muted-foreground font-medium">Feature</th>
                <th class="text-left py-3 px-6 text-foreground font-medium">Maho Mail</th>
                <th class="text-left py-3 pl-6 text-muted-foreground font-medium">Superhuman</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Desktop GUI</td>
                <td class="py-3 px-6 text-foreground">Yes — clean, keyboard-driven</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — highly polished, speed-optimized</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">CLI</td>
                <td class="py-3 px-6 text-foreground">Yes — full email CLI with JSON output</td>
                <td class="py-3 pl-6 text-muted-foreground">No</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">MCP Server</td>
                <td class="py-3 px-6 text-foreground">Yes — AI agents connect via stdio</td>
                <td class="py-3 pl-6 text-muted-foreground">No</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">AI Features</td>
                <td class="py-3 px-6 text-foreground">Yes — bring your own provider</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — built-in AI triage and drafting</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Split Inbox</td>
                <td class="py-3 px-6 text-foreground">No</td>
                <td class="py-3 pl-6 text-muted-foreground">Yes — auto-categorized streams</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Local & Private</td>
                <td class="py-3 px-6 text-foreground">Yes — everything on your device</td>
                <td class="py-3 pl-6 text-muted-foreground">No — cloud-based</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Open Source</td>
                <td class="py-3 px-6 text-foreground">Yes</td>
                <td class="py-3 pl-6 text-muted-foreground">No — proprietary</td>
              </tr>
              <tr>
                <td class="py-3 pr-6 text-muted-foreground">Price</td>
                <td class="py-3 px-6 text-foreground">Free</td>
                <td class="py-3 pl-6 text-muted-foreground">$30/user/month</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">Deep Dive</span>
        <h2 class="heading-serif text-3xl sm:text-4xl mb-10">Category comparison</h2>

        <div class="space-y-16 max-w-3xl">
          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Speed & Polish</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Superhuman has built its brand on being the fastest email experience available. Every interaction is optimized — search returns results instantly, emails load before you click them, and keyboard shortcuts cover every action. The onboarding includes a personal session to teach you their workflow. The attention to detail in the UI is exceptional.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail is fast because it is local — search runs against a SQLite database on your machine, and there are no network round-trips for cached data. But the GUI is more functional than luxurious. Maho invests its design budget in the three-interface architecture rather than micro-interactions. If raw UI polish is your priority, Superhuman is ahead.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Automation & Programmability</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Superhuman offers workflow features — snippets, scheduled sends, reminders, split inbox — but all of them live within the GUI. There is no CLI, no API, and no way for external tools to access your email programmatically. Automation means using Superhuman's built-in features.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail treats email as programmable data. The CLI gives you <code class="text-foreground text-sm bg-card px-1.5 py-0.5 rounded">maho search --from alice --after 2026-01-01 --json</code> and pipes the result into jq, Python, or any other tool. The MCP server lets AI agents handle your inbox. You can build workflows that Superhuman's GUI simply cannot express.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">AI Approach</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Superhuman has its own AI features — auto-triage that sorts email into categories, AI-powered draft suggestions, and thread summaries. These are polished and integrated into the workflow, but they use Superhuman's chosen models and run on their infrastructure. You cannot swap providers or customize behavior.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail lets you bring your own AI provider — OpenAI, Anthropic, or Ollama for fully local inference. Beyond built-in features, the MCP server means any AI tool can interact with your inbox. The difference is control: Superhuman gives you curated AI. Maho gives you programmable AI.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Privacy & Cost</h3>
            <p class="text-muted-foreground leading-relaxed mb-4">
              Superhuman is a cloud service at $30 per user per month ($360/year). Your email data flows through their servers. For teams, the cost scales linearly. Superhuman's business model depends on this subscription revenue, and the service requires an active subscription to function.
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Maho Mail is free and open source. All data stays on your machine. There is no subscription, no cloud dependency, and no telemetry. If cost or data sovereignty matters, this is a significant difference. The tradeoff is that Maho does not have Superhuman's team features, support infrastructure, or design resources.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-medium text-foreground mb-4">Team Features</h3>
            <p class="text-muted-foreground leading-relaxed">
              Superhuman has invested heavily in team email — shared labels, team analytics, management dashboards, and onboarding for organizations. Maho Mail is built for individual users and does not have team collaboration features. If you are evaluating email for a team, Superhuman is designed for that use case.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-12 md:grid-cols-2">
          <div>
            <h2 class="text-xl font-medium text-foreground mb-6">Choose Maho Mail if you...</h2>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want CLI and MCP access to your inbox
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want to choose your own AI provider
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Care about local data and open-source transparency
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Do not want to pay $30/month for email
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Value programmability over polished UX
              </li>
            </ul>
          </div>
          <div>
            <h2 class="text-xl font-medium text-foreground mb-6">Choose Superhuman if you...</h2>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want the fastest, most polished email GUI available
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Need team email features and management tools
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Value curated AI features that just work
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Want split inbox and auto-triage out of the box
              </li>
              <li class="flex items-start gap-3 text-muted-foreground">
                <span class="text-foreground mt-1.5 block w-1 h-1 rounded-full bg-foreground shrink-0"></span>
                Are willing to invest $30/month for a premium experience
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <span class="inline-block border border-border text-muted-foreground text-xs px-3 py-1 rounded-full mb-6">FAQ</span>
        <h2 class="heading-serif text-3xl sm:text-4xl mb-10">Frequently asked questions</h2>
        <div class="max-w-3xl space-y-4">
          {faqs.map((faq) => (
            <details class="group border border-border rounded-lg">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-foreground font-medium">
                {faq.q}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 ml-4 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-4 text-muted-foreground leading-relaxed">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="heading-serif text-4xl sm:text-5xl mb-6">
          Ready to try Maho Mail?
        </h2>
        <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
          GUI for humans. CLI for developers. MCP for agents.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/mail" class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-md text-sm font-medium hover:opacity-90 transition-opacity">
            Learn more about Maho Mail
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/compare" class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-md text-sm font-medium text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors">
            See all comparisons
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingPage from '../components/LandingPage';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import { getSiteUrl } from '../lib/site';

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Maho Mail',
  applicationCategory: 'Communication',
  operatingSystem: 'macOS',
  description: 'A built-in email client for Maho: desktop app, CLI, and MCP server. Opt-in Beta, enabled in Settings.',
  url: absoluteUrl('/mail'),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};
---

<BaseLayout title="Maho Mail (Beta) — One inbox, three interfaces." description="A built-in, local-first email client for Maho with a CLI and MCP server. Opt-in Beta — enable it in Settings.">
  <JSONLD data={ld} />
  <main id="main" class="min-h-screen bg-background text-foreground">
    <Nav activeProduct="mail" />
    <LandingPage product="mail" />
    <Footer />
  </main>
</BaseLayout>

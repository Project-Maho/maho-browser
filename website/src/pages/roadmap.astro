---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter data is referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import ScrollReveal from '../components/motion/ScrollReveal';
import { getSiteUrl } from '../lib/site';

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);

const lastUpdated = '2026-06-28';

const shipped = [
  { title: 'macOS Browser (alpha)', detail: 'Spaces, AI panel with BYOK, Split View, Boosts, Manifest V3 extensions.' },
  { title: 'End-to-end encrypted sync', detail: 'X25519 handshake + AES-GCM. Six-digit pairing.' },
  { title: 'Maho Mail (alpha) on macOS', detail: 'Desktop app + CLI + MCP server sharing one local SQLite database.' },
  { title: 'BYOK lane', detail: 'OpenAI, Anthropic, Ollama. Keys never leave your device.' },
  { title: 'Pro and Max managed AI', detail: 'Flat monthly pricing through a zero-retention proxy.' },
  { title: 'PAYG credit packs', detail: '$10 / $50 / $100. Never expire.' },
];

const building = [
  { title: 'iOS app', detail: 'Spaces and sync parity with macOS. TestFlight beta planned.' },
  { title: 'Android app', detail: 'Spaces and sync parity. Public beta to follow iOS.' },
  { title: 'Windows build', detail: 'Cross-compiled from the same Rust core. Native shell in design.' },
  { title: 'External security audit', detail: 'Vendor selection underway. Report will publish on /security when complete.' },
  { title: 'Self-hostable sync relay', detail: 'Run your own relay binary. Docs and image distribution in design.' },
  { title: 'Scheduled routines', detail: 'Recurring AI tasks (daily briefings, weekly summaries). Design phase.' },
];

const considering = [
  { title: 'Linux build', detail: 'Demand-dependent. Likely after Windows ships.' },
  { title: 'Browser extension marketplace', detail: 'Curated Boosts and AI extensions. Open question on submission flow.' },
  { title: 'Team / enterprise tier', detail: 'SSO, audit logs, shared Spaces. Held until individual-tier traction is established.' },
  { title: 'Local AI model bundling', detail: 'Ship a small model with the install. Tradeoff on binary size.' },
  { title: 'Mail mobile clients', detail: 'iOS / Android mail apps. Lower priority than browser parity.' },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Maho Roadmap',
  description: 'What Maho has shipped, what is being built, and what is under consideration.',
  url: absoluteUrl('/roadmap'),
};
---

<BaseLayout
  title="Roadmap — Maho"
  description="What Maho has shipped, what is being built, and what is under consideration. Updated as plans change."
  ogImage="/og/roadmap.png"
>
  <JSONLD data={ld} />
  <div class="min-h-screen bg-background text-foreground">
    <Nav />
    <main id="main" class="max-w-4xl mx-auto px-6 pt-24 sm:pt-32 pb-24">
      <header class="mb-16">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground mb-4">
          Roadmap
        </p>
        <h1 class="heading-serif text-4xl sm:text-5xl mb-4">
          What we&rsquo;ve shipped. What we&rsquo;re building. What we&rsquo;re considering.
        </h1>
        <p class="text-muted-foreground leading-relaxed max-w-2xl">
          Maho is built by one developer, in public. This page is the source of truth on where the product actually is &mdash; not where we wish it was. Last updated: {lastUpdated}.
        </p>
      </header>

      <section aria-labelledby="shipped-heading" class="section-rhythm !pt-0">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-2 h-2 rounded-full bg-foreground" aria-hidden="true"></span>
          <h2
            id="shipped-heading"
            class="rounded-squircle-sm border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground font-mono uppercase tracking-mono-loose"
          >
            Shipped
          </h2>
        </div>
        <ul class="space-y-4">
          {shipped.map((item) => (
            <li class="border-l-2 border-muted-foreground/20 pl-6 py-2">
              <ScrollReveal client:visible variant="slide" thresholdRatio={0.2}>
                <p class="text-foreground font-medium mb-1">{item.title}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.detail}</p>
              </ScrollReveal>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="building-heading" class="section-rhythm border-t border-border">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-2 h-2 rounded-full border border-foreground" aria-hidden="true"></span>
          <h2
            id="building-heading"
            class="rounded-squircle-sm border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground font-mono uppercase tracking-mono-loose"
          >
            Building
          </h2>
        </div>
        <ul class="space-y-4">
          {building.map((item) => (
            <li class="border-l-2 border-muted-foreground/20 pl-6 py-2">
              <ScrollReveal client:visible variant="slide" thresholdRatio={0.2}>
                <p class="text-foreground font-medium mb-1">{item.title}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.detail}</p>
              </ScrollReveal>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="considering-heading" class="section-rhythm border-t border-border">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-2 h-2 rounded-full border border-muted-foreground" aria-hidden="true"></span>
          <h2
            id="considering-heading"
            class="rounded-squircle-sm border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground font-mono uppercase tracking-mono-loose"
          >
            Considering
          </h2>
        </div>
        <ul class="space-y-4">
          {considering.map((item) => (
            <li class="border-l-2 border-muted-foreground/20 pl-6 py-2">
              <ScrollReveal client:visible variant="slide" thresholdRatio={0.2}>
                <p class="text-foreground font-medium mb-1">{item.title}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.detail}</p>
              </ScrollReveal>
            </li>
          ))}
        </ul>
        <p class="text-xs text-muted-foreground mt-8 pt-6 border-t border-border">
          Items in &ldquo;Considering&rdquo; are not commitments. They move to &ldquo;Building&rdquo; only after design and prioritization. Have feedback? Email <a href="mailto:hello@mahobrowser.com" class="underline hover:text-foreground transition-colors">hello@mahobrowser.com</a>.
        </p>
      </section>

      <section class="border border-border rounded-lg p-8 bg-card text-center">
        <h2 class="heading-serif text-3xl sm:text-4xl mb-4">Try what we&rsquo;ve shipped.</h2>
        <p class="text-muted-foreground text-sm leading-relaxed max-w-lg mx-auto mb-6">
          macOS today. iPhone and Android in development &mdash; join our Discord for updates.
        </p>
        <a
          href="/download"
          class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-6 py-3 text-sm font-medium hover:opacity-90 transition"
        >
          Download for macOS
        </a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SocialProofSection from '../components/landing/SocialProofSection.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import { getSiteUrl } from '../lib/site';
import { getImage } from 'astro:assets';

import { landingContent } from '../components/LandingPage';
import { HeroSection } from '../components/landing/HeroSection';
import { FeaturesSection } from '../components/landing/FeaturesSection';
import { ImportSection } from '../components/landing/ImportSection';
import { ChangelogSection } from '../components/landing/ChangelogSection';
import { PricingSection } from '../components/landing/PricingSection';
import { FinalCtaSection } from '../components/landing/FinalCtaSection';

import spacesImageSrc from '../assets/images/sidebar-target-prototype-verified.png';
const heroImageSrc = spacesImageSrc;

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);
const browserContent = landingContent.browser;

const heroOptimized = await getImage({
  src: heroImageSrc,
  format: 'webp',
  widths: [720, 1080, 1440, 1800],
  sizes: '(min-width: 1024px) 52vw, 100vw',
});

const spacesOptimized = await getImage({
  src: spacesImageSrc,
  format: 'webp',
  widths: [720, 1080, 1440],
  sizes: '(min-width: 1024px) 50vw, 100vw',
});

const heroImage = {
  src: heroOptimized.src,
  srcSet: heroOptimized.srcSet.attribute,
  width: heroImageSrc.width,
  height: heroImageSrc.height,
  alt: 'Maho Browser screenshot showing the persistent sidebar, active Spaces, and browser content that feels complete rather than placeholder chrome.',
};

const browserFeatures = browserContent.features.items.map((item) => {
  if (item.title === 'Spaces' && item.visual?.type === 'image') {
    return {
      ...item,
      visual: {
        ...item.visual,
        image: {
          src: spacesOptimized.src,
          srcSet: spacesOptimized.srcSet.attribute,
          width: spacesImageSrc.width,
          height: spacesImageSrc.height,
        },
      },
    };
  }
  return item;
});

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Maho',
      url: siteUrl,
      logo: absoluteUrl('/icon-512.png'),
      sameAs: ['https://github.com/Project-Maho'],
      foundingDate: '2026',
      founder: { '@type': 'Person', name: 'Indosaram' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Maho',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: absoluteUrl('/?q={search_term_string}'),
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Maho Browser',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'macOS, Windows, Linux',
      description: 'Browser with Spaces, split view, a command bar, optional AI, and weekly public releases. Free forever.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<BaseLayout title="Maho Browser — Built for people who took browsers seriously" description="Maho Browser brings back the tools you liked: Spaces, split view, command bar, optional AI, and weekly releases on a stack that keeps shipping." ogImage="/og/home.png">
  <JSONLD data={ld} />
  <main id="main" class="min-h-screen bg-background text-foreground">
    <Nav activeProduct="browser" />
    <HeroSection config={{ ...browserContent.hero, heroImage }} />
    <SocialProofSection tickerItems={browserContent.socialProof.tickerItems} eyebrow={browserContent.socialProof.eyebrow} />
    <FeaturesSection eyebrow={browserContent.features.eyebrow} headline={browserContent.features.headline} items={browserFeatures} />
    <ImportSection config={browserContent.importSection} />
    <ChangelogSection config={browserContent.changelog} />
    <PricingSection config={browserContent.pricing} />
    <FinalCtaSection config={browserContent.finalCta} />
    <Footer />
  </main>
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SocialProofSection from '../components/landing/SocialProofSection.astro';
import FeatureGridSection from '../components/landing/FeatureGridSection.astro';
import ProtectionFeaturesSection from '../components/landing/ProtectionFeaturesSection.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import { getSiteUrl } from '../lib/site';

import { landingContent } from '../components/LandingPage';
import BrowserHeroSection from '../components/landing/feature-showcase/BrowserHeroSection.astro';
import { ImportSection } from '../components/landing/ImportSection';
import { ChangelogSection } from '../components/landing/ChangelogSection';
import { PricingSection } from '../components/landing/PricingSection';
import { FinalCtaSection } from '../components/landing/FinalCtaSection';

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);
const browserContent = landingContent.browser;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Maho',
      url: siteUrl,
      logo: absoluteUrl('/icon-512.png'),
      sameAs: ['https://github.com/Project-Maho'],
      foundingDate: '2026',
      founder: { '@type': 'Person', name: 'Indosaram' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Maho',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: absoluteUrl('/?q={search_term_string}'),
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Maho Browser',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'macOS, Windows, Linux',
      description: 'Browser with Spaces, split view, a command bar, optional Profiles, privacy by default, and AI only when asked.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<BaseLayout title="Maho Browser — The browser tools you liked, still shipping" description="Maho Browser brings back the tools you liked: Spaces, split view, command bar, optional Profiles, privacy by default, and AI only when asked." ogImage="/og/home.png">
  <link slot="head" rel="preload" as="image" href="/demo/hero/maho-hero-capture-poster.png" type="image/png" fetchpriority="high" />
  <JSONLD data={ld} />
  <main id="main" class="min-h-screen bg-background text-foreground">
    <Nav activeProduct="browser" />
    <BrowserHeroSection config={browserContent.hero} />
    <SocialProofSection tickerItems={browserContent.socialProof.tickerItems} eyebrow={browserContent.socialProof.eyebrow} />
    <FeatureGridSection config={browserContent.featureGrid} />
    <ProtectionFeaturesSection config={browserContent.protectionFeatures} />
    <ImportSection config={browserContent.importSection} />
    <ChangelogSection config={browserContent.changelog} />
    <PricingSection config={browserContent.pricing} />
    <FinalCtaSection config={browserContent.finalCta} />
    <Footer />
  </main>
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingPage from '../components/LandingPage';
import SocialProofSection from '../components/landing/SocialProofSection.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import { getSiteUrl } from '../lib/site';
import { getImage } from 'astro:assets';

import heroImageSrc from '../assets/images/sidebar-target-prototype-verified.png';
import gallery1Src from '../assets/images/sidebar-target-prototype-final-verified.png';
import gallery2Src from '../assets/images/command-bar-mockup-final-qa.png';
import gallery3Src from '../assets/images/pixel-perfect-mockup-qa.png';
import gallery4Src from '../assets/images/maho-passwords-built-in.png';

const { siteUrl, absoluteUrl } = getSiteUrl(Astro);

// Generate optimized WebP versions with responsive srcsets
const heroOptimized = await getImage({
  src: heroImageSrc,
  format: 'webp',
  widths: [640, 960, 1200, 1600],
  sizes: '(min-width: 1024px) 50vw, 100vw',
});

const gallery1Optimized = await getImage({
  src: gallery1Src,
  format: 'webp',
  widths: [640, 960, 1385],
  sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
});

const gallery2Optimized = await getImage({
  src: gallery2Src,
  format: 'webp',
  widths: [640, 960, 1200],
  sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
});

const gallery3Optimized = await getImage({
  src: gallery3Src,
  format: 'webp',
  widths: [640, 960, 1200],
  sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
});

const gallery4Optimized = await getImage({
  src: gallery4Src,
  format: 'webp',
  widths: [640, 960, 1440],
  sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
});

const heroImage = {
  src: heroOptimized.src,
  srcSet: heroOptimized.srcSet.attribute,
  width: heroImageSrc.width,
  height: heroImageSrc.height,
};

const galleryImages = [
  { src: gallery1Optimized.src, srcSet: gallery1Optimized.srcSet.attribute, width: gallery1Src.width, height: gallery1Src.height },
  { src: gallery2Optimized.src, srcSet: gallery2Optimized.srcSet.attribute, width: gallery2Src.width, height: gallery2Src.height },
  { src: gallery3Optimized.src, srcSet: gallery3Optimized.srcSet.attribute, width: gallery3Src.width, height: gallery3Src.height },
  { src: gallery4Optimized.src, srcSet: gallery4Optimized.srcSet.attribute, width: gallery4Src.width, height: gallery4Src.height },
];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Maho',
      url: siteUrl,
      logo: absoluteUrl('/logo.svg'),
      sameAs: ['https://github.com/Project-Maho'],
      foundingDate: '2026',
      founder: { '@type': 'Person', name: 'Indosaram' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Maho',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: absoluteUrl('/?q={search_term_string}'),
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Maho Browser',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'macOS',
      description: 'AI browser with Spaces, BYOK, and end-to-end encrypted sync. Free forever.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD'
      }
    }
  ]
};
---

<BaseLayout title="Maho — Browser and Mail for modern work" description="Maho Browser and Maho Mail help you work with more focus, better tools, and software that respects your data." ogImage="/og/home.png">
  <JSONLD data={ld} />
  <main id="main" class="min-h-screen bg-background text-foreground">
    <Nav activeProduct="browser" />
    <LandingPage product="browser" heroImage={heroImage} galleryImages={galleryImages} />
    <SocialProofSection />
    <Footer />
  </main>
</BaseLayout>

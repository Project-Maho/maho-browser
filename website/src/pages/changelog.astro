---
import Footer from "../components/Footer.astro";
import JSONLD from "../components/JSONLD.astro";
import ScrollReveal from "../components/motion/ScrollReveal.astro";
import Nav from "../components/Nav.astro";
import changelogData from "../data/changelog.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteUrl } from "../lib/site";

interface ChangelogSection {
	type: "added" | "fixed" | "changed" | "removed";
	title: string;
	items: string[];
}

interface Release {
	version: string;
	date: string;
	channel: string;
	highlights: string[];
	sections: ChangelogSection[];
	body: string;
}

const releases: Release[] = (changelogData.releases as Release[]) || [];

const { absoluteUrl } = getSiteUrl(Astro);

const pageTitle = "Changelog — Maho";
const pageDescription =
	"Every release, feature update, and fix shipped to Maho — structured, verified, and dated.";

function formatDate(dateStr: string): string {
	try {
		const [year, month, day] = dateStr.split("-").map(Number);
		const date = new Date(Date.UTC(year, month - 1, day));
		return new Intl.DateTimeFormat("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
			timeZone: "UTC",
		}).format(date);
	} catch {
		return dateStr;
	}
}

const sectionBadgeStyles: Record<string, { label: string; dotClass: string }> =
	{
		added: {
			label: "New Features",
			dotClass: "bg-emerald-500",
		},
		fixed: {
			label: "Bug Fixes",
			dotClass: "bg-amber-500",
		},
		changed: {
			label: "Improvements",
			dotClass: "bg-sky-500",
		},
		removed: {
			label: "Removed",
			dotClass: "bg-rose-500",
		},
	};

const channelBadgeStyles: Record<string, string> = {
	stable: "border-foreground/20 bg-foreground/10 text-foreground",
	beta: "border-border bg-muted/60 text-muted-foreground",
	nightly: "border-border bg-muted/40 text-muted-foreground",
};

const ld = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Maho Changelog",
	description: pageDescription,
	url: absoluteUrl("/changelog"),
	mainEntity: {
		"@type": "ItemList",
		itemListElement: releases.map((release, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: `Maho ${release.version}`,
			url: `${absoluteUrl("/changelog")}#v${release.version}`,
		})),
	},
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <JSONLD data={ld} />
  <div class="min-h-screen bg-background text-foreground">
    <Nav />
    <main id="main" class="pt-24 sm:pt-28 md:pt-32">
      <div class="container-marketing pad-x-ladder section-rhythm">
        <div class="mx-auto max-w-4xl">
          <header class="mb-12 sm:mb-16">
            <p class="mb-4 font-mono text-xs uppercase tracking-mono-loose text-muted-foreground">
              Changelog
            </p>
            <h1 class="heading-serif mb-4 text-4xl sm:text-5xl lg:text-6xl">
              What&rsquo;s new in Maho.
            </h1>
            <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">
              Every release, feature update, and fix shipped to Maho &mdash; structured, verified, and dated.
            </p>
          </header>

          {releases.length > 1 && (
            <nav aria-label="Release versions" class="mb-10 flex flex-wrap items-center gap-2 border-b border-border pb-6">
              <span class="font-mono text-xs uppercase tracking-mono-loose text-muted-foreground mr-2">
                Versions:
              </span>
              {releases.map((rel) => (
                <a
                  href={`#v${rel.version}`}
                  class="rounded-squircle-sm border border-border bg-card px-3 py-1 font-mono text-xs text-muted-foreground transition hover:border-foreground/40 hover:text-foreground"
                >
                  v{rel.version}
                </a>
              ))}
            </nav>
          )}

          <div class="space-y-12 sm:space-y-16">
            {releases.map((release) => (
              <ScrollReveal as="section" variant="fade">
                <article
                  id={`v${release.version}`}
                  class="scroll-mt-28 rounded-squircle-xl squircle-enhanced border border-border bg-card/60 p-6 sm:p-8 md:p-10"
                >
                  <!-- Release Header -->
                  <div class="flex flex-col gap-4 border-b border-border/80 pb-6 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <div class="flex flex-wrap items-center gap-3">
                        <h2 class="heading-serif text-3xl sm:text-4xl text-foreground">
                          v{release.version}
                        </h2>
                        <span
                          class={`rounded-full border px-2.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-wider ${
                            channelBadgeStyles[release.channel] || 'border-border bg-card text-muted-foreground'
                          }`}
                        >
                          {release.channel}
                        </span>
                      </div>
                      <time
                        datetime={release.date}
                        class="mt-1 block font-mono text-xs text-muted-foreground"
                      >
                        Released on {formatDate(release.date)}
                      </time>
                    </div>

                    <a
                      href="/download"
                      class="cta-btn cta-btn-ghost w-fit text-xs"
                      aria-label={`Download Maho ${release.version}`}
                    >
                      Download Maho
                    </a>
                  </div>

                  <!-- Highlights -->
                  {release.highlights && release.highlights.length > 0 && (
                    <div class="mt-6 rounded-squircle-lg border border-border bg-background/50 p-5 sm:p-6">
                      <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-mono-loose text-foreground">
                        Highlights
                      </p>
                      <ul class="space-y-2 text-sm sm:text-base leading-relaxed text-muted-foreground">
                        {release.highlights.map((highlight) => (
                          <li class="flex items-start gap-3">
                            <span
                              class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-foreground"
                              aria-hidden="true"
                            />
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <!-- Sections (New Features, Bug Fixes, Improvements, Removed) -->
                  {release.sections && release.sections.length > 0 && (
                    <div class="mt-8 space-y-8">
                      {release.sections.map((section) => {
                        const style = sectionBadgeStyles[section.type] || {
                          label: section.title,
                          dotClass: 'bg-muted-foreground',
                        };

                        return (
                          <div class="space-y-4">
                            <div class="flex items-center gap-2.5">
                              <span
                                class={`h-2 w-2 rounded-full ${style.dotClass}`}
                                aria-hidden="true"
                              />
                              <h3 class="font-mono text-xs font-semibold uppercase tracking-mono-loose text-foreground">
                                {section.title}
                              </h3>
                            </div>
                            <ul class="space-y-2.5 pl-1">
                              {section.items.map((item) => (
                                <li class="flex items-start gap-3 text-sm sm:text-base leading-relaxed text-muted-foreground">
                                  <span
                                    class="mt-2 h-1 w-1 shrink-0 rounded-full bg-muted-foreground/60"
                                    aria-hidden="true"
                                  />
                                  <span>{item}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </article>
              </ScrollReveal>
            ))}
          </div>

          <!-- Bottom CTA -->
          <ScrollReveal
            as="section"
            variant="fade"
            class="mt-16 rounded-squircle-lg squircle-enhanced border border-border bg-card p-8 text-center sm:p-10"
          >
            <h2 class="heading-serif mb-4 text-3xl sm:text-4xl">
              Get the latest release.
            </h2>
            <p class="mx-auto mb-6 max-w-lg text-sm leading-relaxed text-muted-foreground">
              Maho is available across macOS, Windows, and Linux. Free forever.
            </p>
            <a
              href="/download"
              class="inline-flex items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
            >
              Download Maho
            </a>
          </ScrollReveal>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

---
// biome-ignore-all assist/source/organizeImports: Astro component imports stay grouped for readability.
// biome-ignore-all lint/correctness/noUnusedImports: Astro frontmatter imports are referenced in the template.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro frontmatter variables are referenced in the template.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JSONLD from '../components/JSONLD.astro';
import ScrollReveal from '../components/motion/ScrollReveal';
import { getSiteUrl } from '../lib/site';

const { absoluteUrl } = getSiteUrl(Astro);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Why Maho — A Browser That Belongs to Its User',
  description: 'Maho is built on three commitments: your data stays local, AI assists only when asked, and your work syncs across every device you own.',
  url: absoluteUrl('/why')
};

const commitments = [
  {
    title: '1. Your data stays on your device.',
    paragraphs: [
      'Maho runs locally. Browsing history, tabs, notes, mail, and Spaces live in encrypted storage on your machine. When sync is on, devices talk to each other through an end-to-end encrypted relay &mdash; not through a cloud database we control. Our sync architecture is published in the engineering blog so you can verify what crosses the wire and what doesn&rsquo;t.'
    ]
  },
  {
    title: '2. AI assists when asked. It doesn&rsquo;t act on its own.',
    paragraphs: [
      'Other AI browsers chase autonomous agents &mdash; software that picks tasks, navigates websites, and clicks on your behalf. We think that paradigm is the wrong tool for most real work. The failure modes are not benchmark-shaped. They&rsquo;re &ldquo;agent purchased the wrong flight&rdquo; shaped.',
      'Maho takes a different stance. Think of it like driving: full self-driving lets the car go anywhere; hand-on-wheel keeps you in control with the AI accelerating what you do. Maho is hand-on-wheel. Summarize this page. Clean up these tab titles. Draft a reply, but let me send it. The AI is powerful &mdash; it just doesn&rsquo;t act in your accounts when you&rsquo;re not watching.'
    ]
  },
  {
    title: '3. Your work follows you across every device.',
    paragraphs: [
      'Spaces, tabs, notes, and mail are designed to sync to every device you own. macOS today; iPhone and Android in development. Cross-device isn&rsquo;t a premium feature gated behind a subscription &mdash; it&rsquo;s the core of how Maho works.'
    ]
  }
];
---

<BaseLayout
  title="Why Maho — A Browser That Belongs to Its User"
  description="Maho is built on three commitments: your data stays local, AI assists only when asked, and your work syncs across every device you own. Here's why."
  ogImage="/og/why.png"
>
  <JSONLD data={ld} />
  <div class="min-h-screen bg-background text-foreground">
    <Nav />
    <main id="main" class="max-w-2xl mx-auto px-6 pt-32 pb-24">
      <header class="mb-16 text-center">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground mb-4">
          Why Maho
        </p>
        <h1 class="heading-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.1] mb-6">
          A browser that belongs to its user.
        </h1>
      </header>

      <article class="text-lg text-muted-foreground">
        <div class="space-y-6">
          <p class="drop-cap leading-relaxed">
            Knowledge work happens in a browser. Research, decisions, communication, building &mdash; most of a working day passes through the tab strip. The tools that frame that work should respect the person doing it.
          </p>
          <p class="leading-relaxed">
            Their data stays theirs. Their AI assists when asked, and only when asked. Their projects follow them across every device they own. Maho is the browser built on that belief.
          </p>
        </div>

        <section aria-labelledby="three-commitments-heading" class="section-rhythm-tall">
          <h2 id="three-commitments-heading" class="heading-serif tracking-display text-2xl sm:text-3xl text-foreground mb-6">
            Three commitments
          </h2>
          <div class="space-y-6">
            {commitments.map((commitment, index) => (
              <ScrollReveal
                client:visible
                as="section"
                variant="slide"
                delayMs={200 * index}
                className="space-y-4 border-t border-border/60 pt-8 first:border-t-0 first:pt-0"
              >
                <h3 class="text-lg font-medium text-foreground" set:html={commitment.title} />
                {commitment.paragraphs.map((paragraph) => (
                  <p class="leading-relaxed" set:html={paragraph} />
                ))}
              </ScrollReveal>
            ))}
          </div>
        </section>

        <section aria-labelledby="practice-heading" class="border-t border-border/60 pt-10">
          <h2 id="practice-heading" class="heading-serif tracking-display text-2xl sm:text-3xl text-foreground mb-6">
            What that means in practice
          </h2>
          <div class="space-y-6">
            <p class="leading-relaxed">
              Maho is free to use. Bring your own API key (OpenAI, Anthropic, Ollama) and you pay your provider directly &mdash; no metered credits, no markup. If you&rsquo;d rather not manage keys, Maho Pro is $5/mo and Max is $20/mo for managed AI with clear model ceilings.
            </p>
            <p class="leading-relaxed">
              Maho is proprietary software. We are not open source. We compensate for that by publishing the architecture, by being verifiable through network behavior on your own device, and by being reachable directly. If something matters to you, ask. We answer.
            </p>
          </div>
        </section>

        <div class="border-t border-border pt-10 mt-12">
          <p class="text-sm leading-relaxed text-muted-foreground">
            Maho is built by an individual developer. Contact: <a href="https://discord.gg/Ty4J6pMdqg" class="underline hover:text-foreground transition-colors">Discord DM</a>
          </p>
        </div>
      </article>

      <div class="section-rhythm-tall">
        <section class="border border-border rounded-lg p-8 bg-card text-center">
          <h2 class="heading-serif tracking-display text-3xl sm:text-4xl mb-4">Try Maho.</h2>
          <p class="text-muted-foreground text-sm leading-relaxed max-w-lg mx-auto mb-6">
            Free forever. macOS today. iPhone and Android arriving.
          </p>
          <a
            href="/download"
            class="inline-flex items-center justify-center rounded-full bg-foreground text-background px-6 py-3 text-sm font-medium hover:opacity-90 transition"
          >
            Download for macOS
          </a>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
